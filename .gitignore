doc/identity/.last-session

# Bytecode de Python
**/__pycache__/
*.pyc

# Claves y JWTs de test — REGENERABLES con tests/security/generate-test-jwts.sh
# No son claves productivas; nunca commitear claves privadas al repo.
tests/security/*.pem
tests/security/test-env.vars

# Artefacto compilado del CAR de discovery — regenerable con build.sh
_backend/api/ApimDiscoveryProject/build/

# Secretos de despliegue GCP (ADR-011) — copiar de deploy/gcp/.env.example
deploy/gcp/.env

# PDF generado — no versionar (se regenera con scripts/dev/manual-a-pdf.sh)
doc/manuales/*.pdf
doc/manuales/*.html

# archivos temporales de editores
*.swp
*.swo

# Paquete suelto de documentos que ya están versionados como .md — no aporta al repo
doc/v3/files.zip

# Config local de Claude Code — los comandos compartidos (.claude/commands/) sí se versionan
.claude/settings.local.json
.claude/worktrees/

# Agente Minero
.env
.venv-agente/
agente/__pycache__/
tests/__pycache__/
.pytest_cache/
