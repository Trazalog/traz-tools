# Variables de la suite Hurl del MCP.
# Copiar a `staging-v3.env` (ignorado por git) y completar.
#
# ⛔ Los valores reales los provee el PM. No inventar hosts ni credenciales.
# ⛔ El JWT es una credencial: no se commitea ni se pega en un issue.

# ── Gateway ──────────────────────────────────────────────────────────────────
# mcp_base_url  : host público del gateway, sin barra final.
# mcp_server_path: contexto + versión + /mcp del MCP Server publicado.
# Juntos forman la misma URL que se configura en el conector de Claude.
mcp_base_url=
mcp_server_path=

# ── Token ────────────────────────────────────────────────────────────────────
# La suite NO emite el token: lo recibe hecho.
#
# Dnato sólo soporta `authorization_code` con PKCE — su metadata declara
# `"grant_types_supported":["authorization_code"]` y
# `"token_endpoint_auth_methods_supported":["none"]` —, así que no hay
# client_credentials con el que un test pueda pedirse uno solo.
#
# Cómo conseguirlo, en orden de comodidad:
#   1. Del log del APIM, si está en FULL:
#        python3 ../../../scripts/dev/validar-tools-e2e.py --desde-log
#      imprime el que usó.
#   2. Haciendo el flujo OAuth a mano con el usuario de prueba (login + PKCE +
#      canje en /oauth/token). Es lo que hace el conector de Claude.
#
# El token vence a las 24 h y queda atado a la empresa con la que se inició
# sesión: si se cambia de empresa, hay que pedir uno nuevo.
jwt=

# ── Datos de la empresa del token ────────────────────────────────────────────
# empr_id de la empresa con la que se emitió el token. Lo usan los asserts de
# aislamiento: lo que devuelven las tools tiene que ser de ESTA empresa.
empr_id_test=

# ── Datos del ambiente ───────────────────────────────────────────────────────
# Rango para las 4 tools de KPI, que exigen las dos fechas.
fec_inicio=2024-01-01
fec_fin=2026-12-31

# Ids que usan man_get_equipo y man_get_ot. Si el ambiente no tiene equipos ni
# solicitudes, dejarlos en un id inexistente: el test verifica igual que la tool
# responde sin romper. Las otras dos tools de detalle —pan_get_herramienta y
# alm_get_pedido_material— no necesitan variable: toman el id de su listado.
equi_id_test=999999999
id_solicitud_test=999999999

# Solo para hurl/escrituras/ — ver el LEEME.md de ese directorio.
arti_id_test=
depo_id_test=
equipo_id_test=

# ── Contrato ─────────────────────────────────────────────────────────────────
# Cuántas tools tiene que publicar `tools/list`. Es el mismo número que imprime
# `deploymcp.sh` al desplegar y que cuenta `doc/api/trazalog-operaciones.yaml`.
tools_esperadas=25

# Versión del protocolo MCP que se negocia en el handshake.
protocol_version=2025-06-18
