# Variables de la suite Hurl para staging-v3 (Doc 3 §5).
# Copiar a `staging-v3.env` (ignorado por git) y completar. En CI llegan como secrets.
#
# ⛔ Los valores reales los provee Rodolfo. No inventar hosts ni credenciales.
# ⚠️ Nunca apuntar a producción (RNF-04).

# Gateway del APIM donde está publicado el Virtual MCP Server.
# Patrón de URL: https://<host>/<nombre-del-virtual-mcp-server>/1.0/mcp  (CONTEXT-PACK §4)
mcp_base_url=
mcp_server_path=

# Authorization Server (Dnato) para el token OAuth 2.1 de la empresa de test.
token_url=
client_id=
client_secret=

# Empresa de test 1 y 2 — la 2 existe para verificar aislamiento (empresa A no ve datos de B).
empresa1_user=
empresa1_pass=
empresa2_user=
empresa2_pass=

# Versión del protocolo MCP que se negocia en el handshake (CONTEXT-PACK §4).
protocol_version=2025-06-18
