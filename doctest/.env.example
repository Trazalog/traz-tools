# DocTest — plantilla de variables de entorno.
# Copiar a `doctest/.env` (NO se commitea) y completar con los valores del entorno propio.
#
# ⚠️ Ninguno de estos valores puede apuntar a producción (RNF-04 del Doc 1),
#    salvo el workflow `doctest-smoke-prod.yml`, que usa secrets propios de CI.

# ─────────────────────────────────────────────────────────────────────────────
# Entorno a usar: local | demo | staging-v3
#   local      → apps levantadas en tu máquina
#   demo       → entorno DEMO de v2 (demo.cloudtrazalog.com). Es el ÚNICO desplegado
#                hoy: no hay nada de v3 desplegado todavía. Es contra el que corre
#                DocTest mientras tanto.
#   staging-v3 → todavía no existe; lo entrega E7-CICD
# ─────────────────────────────────────────────────────────────────────────────
DOCTEST_ENV=demo

# Override global de baseURL (opcional). Si está seteada, gana sobre todo lo demás.
# DOCTEST_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# URLs de las tres apps bajo prueba (Doc 3 §4.1).
# Son apps distintas: Asset Planner (MAN), Trazalog Tools (ALM/PAN/PRD/TAR) y Dnato.
# ─────────────────────────────────────────────────────────────────────────────
# --- entorno local del developer (completar solo si levantás las apps en tu máquina) ---
DOCTEST_LOCAL_URL_TOOLS=
DOCTEST_LOCAL_URL_MAN=
DOCTEST_LOCAL_URL_DNATO=

# --- DEMO de v2 (provisto por el PM) ---
DOCTEST_DEMO_URL_TOOLS=https://demo.cloudtrazalog.com/traz-tools
DOCTEST_DEMO_URL_MAN=https://demo.cloudtrazalog.com/tools/traz-prod-assetplanner
DOCTEST_DEMO_URL_DNATO=https://demo.cloudtrazalog.com/traz-comp-dnato/main/login

# --- staging-v3 (no existe todavía; lo entrega E7-CICD) ---
DOCTEST_STAGING_URL_TOOLS=
DOCTEST_STAGING_URL_MAN=
DOCTEST_STAGING_URL_DNATO=

# ─────────────────────────────────────────────────────────────────────────────
# Credenciales de las EMPRESAS DE TEST (nunca usuarios reales — Doc 3 §8.1).
# En CI vienen de GitHub Secrets; en local, de este archivo (que no se commitea).
# Las provee Rodolfo. NO se escriben acá con valor real: este archivo es la plantilla.
#
# Empresa 1: la que provee el PM para el entorno DEMO.
# Empresa 2: PENDIENTE — hace falta una segunda empresa para poder verificar
#            aislamiento multi-empresa (Doc 3 §4.4).
# ─────────────────────────────────────────────────────────────────────────────
# Las dos empresas de test del DEMO ya existen (se crearon con `npm run seed:empresa`).
# Los nombres y usuarios los tiene el PM; las contraseñas nunca se commitean.
DOCTEST_EMPRESA1_NOMBRE=
DOCTEST_EMPRESA1_USER=
DOCTEST_EMPRESA1_PASS=
DOCTEST_EMPRESA2_NOMBRE=
DOCTEST_EMPRESA2_USER=
DOCTEST_EMPRESA2_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# Alta de la empresa de test (npm run seed:empresa).
# Recorre el registro real: crea empresa, 16 roles, establecimiento, depósito y
# 5 usuarios iniciales. Se corre pocas veces, no en cada suite.
# ─────────────────────────────────────────────────────────────────────────────
DOCTEST_SEED_EMAIL=              # VACÍO = el seed se crea una casilla descartable y corre solo.
                                 # Poner una dirección solo si querés registrarte con una casilla propia
                                 # (en ese caso el enlace de activación se pega a mano o se lee por IMAP).
DOCTEST_SEED_PASSWORD=           # contraseña del administrador: 10+, mayúscula, minúscula, dígito y símbolo
DOCTEST_SEED_NOMBRE=DocTest
DOCTEST_SEED_APELLIDO=Automatizado
DOCTEST_SEED_TELEFONO=+54 9 2645 123456
DOCTEST_SEED_PAIS=Argentina
DOCTEST_SEED_RAZON_SOCIAL=DocTest Empresa SA
DOCTEST_SEED_CUIT=30-71234567-8
DOCTEST_SEED_PROVINCIA=San Juan
DOCTEST_SEED_LOCALIDAD=          # vacío = primera opción de la lista
DOCTEST_SEED_DOMINIO=doctest-empresa.com   # dominio de la empresa; solo se pide si el correo es webmail

# Casilla propia por IMAP (opcional). Solo hace falta si NO se usa la casilla
# descartable: con DOCTEST_SEED_EMAIL vacío, nada de esto se necesita.
# Ojo: Gmail ya no acepta la contraseña común por IMAP, exige contraseña de aplicación.
DOCTEST_MAIL_IMAP_HOST=          # ej. imap.gmail.com
DOCTEST_MAIL_IMAP_PORT=993
DOCTEST_MAIL_IMAP_USER=
DOCTEST_MAIL_IMAP_PASS=

# ─────────────────────────────────────────────────────────────────────────────
# Gateway MCP (suite Hurl — F4). Nunca el gateway de producción.
# ─────────────────────────────────────────────────────────────────────────────
# Usuario de AssetPlanner (Mantenimiento). NO son las credenciales de Tools: la app tiene su
# propio padrón de usuarios. Ver issue #489.
DOCTEST_MAN_USER=
DOCTEST_MAN_PASS=

DOCTEST_MCP_GATEWAY_URL=
DOCTEST_MCP_TOKEN_URL=
DOCTEST_MCP_CLIENT_ID=
DOCTEST_MCP_CLIENT_SECRET=
