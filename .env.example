# =============================================================================
# Agente Minero — variables de entorno
# =============================================================================
# Copiar a .env y completar. El .env NO se commitea.
#
#   cp .env.example .env
#
# En desarrollo, las credenciales de la base ya quedaron generadas en
# ~/.agente-minero.env cuando se aplicó el esquema.
# =============================================================================

# --- Base de datos del agente (la vectorial, NO la productiva) --------------
# Los datos del cliente NO salen de acá: van por MCP (ADR-A3). Acá vive el
# conocimiento, la memoria, el feedback y las notificaciones.
AGENTE_DB_HOST=127.0.0.1
AGENTE_DB_PORT=5432
AGENTE_DB_NAME=agente_minero
AGENTE_DB_USER=agente_orq
AGENTE_DB_PASSWORD=

# --- OpenRouter (ADR-A1: único proveedor de LLM) ----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# El modelo es configurable a propósito, nunca hardcodeado.
#
# Hay 17 modelos GRATUITOS con tool-calling (los que terminan en ":free"), que
# funcionan con cuenta sin crédito. Verificado que responde bien en español
# técnico y hace tool-calling: minimax/minimax-m3:free.
#
# Para producción se evalúa aparte: los gratuitos tienen límites de tasa y su
# disponibilidad no está garantizada.
AGENTE_MODELO=minimax/minimax-m3:free

# --- Embeddings -------------------------------------------------------------
# ⚠️ NO HAY MODELOS DE EMBEDDINGS GRATUITOS. Esta parte necesita crédito en la
# cuenta de OpenRouter, aunque es barata (centavos por cada mil fragmentos).
# Sin crédito, el RAG no funciona: no se pueden vectorizar ni los documentos
# que se ingestan ni las preguntas.
#
# OpenRouter NO lista sus modelos de embeddings en /models, pero sí los sirve.
# Hoy solo están los de OpenAI. cohere/embed-multilingual-v3.0 NO existe ahí,
# aunque el nombre suene plausible — verificado contra la API el 2026-09-03.
#
# Cambiar por uno de otra dimensión obliga a migrar el esquema Y re-generar
# todos los embeddings. Ver db/agente/README.md.
AGENTE_MODELO_EMBEDDINGS=openai/text-embedding-3-small
AGENTE_DIM_EMBEDDINGS=1024

AGENTE_TEMPERATURA=0.2
AGENTE_MAX_TOKENS=1500

# --- MCP: cómo llega el agente a los datos del cliente ----------------------
# apim = camino real. JSON-RPC MCP contra el gateway, reenviando el Bearer del
#        usuario tal cual. Es lo que va en demo y producción.
# mi   = camino de desarrollo. REST directo al MI con X-JWT-Assertion, para
#        trabajar sin un APIM levantado. NO usar fuera de desarrollo.
AGENTE_MCP_MODO=mi
AGENTE_MCP_URL=http://localhost:8290/tools/mcp/mcp
AGENTE_MCP_TIMEOUT=60

# --- Recuperación (RAG) -----------------------------------------------------
AGENTE_RAG_TOP_K=6
AGENTE_RAG_TOP_K_MEMORIA=4
# Distancia coseno máxima para considerar útil un fragmento (0 = idéntico).
# Subirlo trae más contexto pero más ruido; bajarlo hace que diga "no sé" más
# seguido. 0.55 es un punto de partida, ajustable con el feedback real.
AGENTE_RAG_DISTANCIA_MAX=0.55

# --- Loop del agente --------------------------------------------------------
# Cuántas veces puede pedir datos antes de tener que responder.
AGENTE_MAX_ITERACIONES=4

# --- Prompt de sistema ------------------------------------------------------
AGENTE_PROMPT_PATH=prompts/agente-minero.md

# --- Tests ------------------------------------------------------------------
# Los tests mockean OpenRouter por defecto: no gastan tokens. Poner en 1 para
# habilitar el smoke test que sí pega contra la API real.
AGENTE_SMOKE_REAL=0
