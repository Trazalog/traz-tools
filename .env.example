# =============================================================================
# Agentes de IA de Trazalog — variables de entorno
# =============================================================================
# Copiar a .env y completar. El .env NO se commitea.
#
#   cp .env.example .env
#
# En desarrollo, las credenciales de la base ya quedaron generadas en
# ~/.agente-minero.env cuando se aplicó el esquema.
# =============================================================================

# --- Base de datos del agente (la vectorial, NO la productiva) --------------
# Los datos del cliente NO salen de acá: van por MCP (ADR-A3). Acá vive el
# conocimiento, la memoria, el feedback y las notificaciones.
AGENTE_DB_HOST=127.0.0.1
AGENTE_DB_PORT=5432
AGENTE_DB_NAME=agente_minero
AGENTE_DB_USER=agente_orq
AGENTE_DB_PASSWORD=

# --- OpenRouter (ADR-A1: único proveedor de LLM) ----------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# El modelo es configurable a propósito, nunca hardcodeado.
#
# Hay 17 modelos GRATUITOS con tool-calling (los que terminan en ":free"), que
# funcionan con cuenta sin crédito. Los gratuitos cambian seguido: el
# 2026-11-22 minimax/minimax-m3:free dejó de ser gratis (404) y la cuenta sin
# crédito responde 402 a los pagos. Verificado ese día con tool-calling:
# nvidia/nemotron-3-ultra-550b-a55b:free (también anda openrouter/free, que
# elige uno gratis solo). La lista vigente: GET https://openrouter.ai/api/v1/models
# filtrando precio 0.
#
# Para producción se evalúa aparte: los gratuitos tienen límites de tasa y su
# disponibilidad no está garantizada.
AGENTE_MODELO=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Embeddings -------------------------------------------------------------
# Desde noviembre de 2026 hay embeddings GRATUITOS en OpenRouter (se listan en
# GET /api/v1/embeddings/models). nvidia/nemotron-3.5-embed-1b:free acepta el
# parámetro "dimensions" y devuelve 1024, la dimensión del esquema (verificado
# el 2026-11-22). El motor siempre manda dimensions = AGENTE_DIM_EMBEDDINGS.
# Con crédito en la cuenta también sirve openai/text-embedding-3-small (también
# acepta dimensions).
#
# Cambiar por uno de otra dimensión obliga a migrar el esquema Y re-generar
# todos los embeddings. Ver db/agente/README.md.
AGENTE_MODELO_EMBEDDINGS=nvidia/nemotron-3.5-embed-1b:free
AGENTE_DIM_EMBEDDINGS=1024

AGENTE_TEMPERATURA=0.2
AGENTE_MAX_TOKENS=4000

# --- MCP: cómo llega el agente a los datos del cliente ----------------------
# apim = camino real. JSON-RPC MCP contra el gateway, reenviando el Bearer del
#        usuario tal cual. Es lo que va en demo y producción.
# mi   = camino de desarrollo. REST directo al MI con X-JWT-Assertion, para
#        trabajar sin un APIM levantado. NO usar fuera de desarrollo.
AGENTE_MCP_MODO=mi
AGENTE_MCP_URL=http://localhost:8290/tools/mcp/mcp
AGENTE_MCP_TIMEOUT=60

# --- Recuperación (RAG) -----------------------------------------------------
AGENTE_RAG_TOP_K=6
AGENTE_RAG_TOP_K_MEMORIA=4
# Distancia coseno máxima para considerar útil un fragmento (0 = idéntico).
# Subirlo trae más contexto pero más ruido; bajarlo hace que diga "no sé" más
# seguido. 0.55 es un punto de partida, ajustable con el feedback real.
AGENTE_RAG_DISTANCIA_MAX=0.55

# --- Loop del agente --------------------------------------------------------
# Cuántas veces puede pedir datos antes de tener que responder.
AGENTE_MAX_ITERACIONES=8

# --- Búsqueda en internet (tool web_buscar) ---------------------------------
# SearXNG autoalojado (docker compose --profile web). Vacío = búsqueda apagada:
# los agentes no reciben la tool. Toda cifra que salga de la web tiene que ir
# con su URL en la respuesta, o el guardián de cifras la bloquea.
AGENTE_WEB_URL=
AGENTE_WEB_RESULTADOS=5
AGENTE_WEB_TIMEOUT=20

# Secreto de SearXNG (solo lo usa el contenedor). Uno distinto por ambiente.
SEARXNG_SECRET=

# --- Prompts de los agentes -------------------------------------------------
# Carpeta con un archivo por agente (quirqui.md, kuntur.md, faustino.md). Qué
# archivo usa cada uno lo dice su configuración en agente.agente (011).
AGENTE_PROMPTS_DIR=prompts

# --- Tests ------------------------------------------------------------------
# Los tests mockean OpenRouter por defecto: no gastan tokens. Poner en 1 para
# habilitar el smoke test que sí pega contra la API real.
AGENTE_SMOKE_REAL=0
