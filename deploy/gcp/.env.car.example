# ══════════════════════════════════════════════════════════════════
# deploy/gcp/.env.car.example
#
# A donde apunta el .car de ToolsAPIProject: las bases y el Bonita del
# ambiente. Lo consume scripts/deploy/build-car-env.sh, que buildea el
# .car sobre una COPIA del proyecto — asi el checkout queda intacto y
# estas credenciales nunca entran a git.
#
#   cp deploy/gcp/.env.car.example deploy/gcp/.env.car
#   chmod 600 deploy/gcp/.env.car          # el script lo exige
#   # completar los tres PASS
#   bash scripts/deploy/build-car-env.sh
#
# Los valores de abajo son los de PRODUCCION, confirmados por el PM el
# 2026-10-19. Para un ambiente de desarrollo, ver el bloque comentado
# al final.
#
# OJO: nada de esto coincide con desarrollo — ni el puerto de Postgres,
# ni los nombres de las dos bases, ni el usuario de MariaDB.
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL (ToolsDataSource) ─────────────────────────────────
# De esta base salen las 9 tools alm_*, las 4 pan_* y core_get_empresa_actual.
# Filtra por empr_id (el de PostgreSQL, NO el empr_id_mysql).
PG_HOST=10.142.0.2
PG_PORT=5434
PG_DB=trazalog_tools
PG_USER=postgres
PG_PASS=

# ── MariaDB / Asset Planner (AssetPlannerDataSource) ─────────────
# De esta base salen las 11 tools man_* (equipos, OTs, lecturas,
# preventivos y los 4 KPI). Filtra por empr_id_mysql.
# El query string de la URL (?useSSL=false&...) lo conserva el script:
# es igual en todos los ambientes y no se configura aca.
MY_HOST=10.142.0.2
MY_PORT=3306
MY_DB=asp2tecn
MY_USER=root
MY_PASS=

# ── Bonita ───────────────────────────────────────────────────────
# Solo lo usan las dos tools que escriben e instancian proceso:
# alm_crear_pedido_materiales y man_create_ot. Si esto apunta mal, se
# crean casos reales en el Bonita equivocado.
BPM_URL=http://10.142.0.2:8080/bonita
BPM_USER=admin
BPM_PASS=

# ══════════════════════════════════════════════════════════════════
# Para DESARROLLO (10.142.0.13), que es lo que esta commiteado en los
# datasources del repo:
#
#   PG_HOST=10.142.0.13   PG_PORT=5432   PG_DB=tools_prod_t   PG_USER=postgres
#   MY_HOST=10.142.0.13   MY_PORT=3306   MY_DB=assetv2        MY_USER=rootremote
#   BPM_URL=http://10.142.0.13:8080/bonita   BPM_USER=admin   BPM_PASS=123traza
#
# Hace falta cuando se clona la VM de produccion para armar un DEMO
# nuevo: el clon hereda el .car apuntando a produccion y hay que
# devolverlo a desarrollo (ver §4 del runbook).
# ══════════════════════════════════════════════════════════════════
