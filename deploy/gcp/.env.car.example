# ══════════════════════════════════════════════════════════════════
#  deploy/gcp/.env.car.example
#
#  A donde apunta el MCP: las bases y el Bonita del ambiente. Lo lee
#  scripts/deploy/deploymcp.sh, que arma el .car sobre una COPIA del
#  proyecto — el checkout no se toca y esto nunca entra a git.
#
#  UN ARCHIVO POR AMBIENTE. El nombre define el ambiente:
#
#    cp deploy/gcp/.env.car.example deploy/gcp/.env.car.prod
#    chmod 600 deploy/gcp/.env.car.prod
#    # completar las tres PASS
#    sh scripts/deploy/deploymcp.sh origin/master prod
#
#  Abajo estan los dos juegos de valores conocidos. Deja descomentado
#  el del ambiente de ESTE archivo y comenta el otro.
#
#  Las comillas son opcionales: el script lee este archivo como datos, no
#  lo ejecuta, asi que una password con " < > & $ o espacios funciona tal
#  cual. Si lleva espacios al principio o al final, poné comillas simples:
#    PG_PASS='  con espacios  '
#
#  De que base sale cada tool, para saber que se cae si una apunta mal:
#    PostgreSQL -> las 9 alm_*, las 4 pan_* y core_get_empresa_actual
#    MariaDB    -> las 11 man_* (equipos, OTs, lecturas, preventivos, KPI)
#    Bonita     -> solo alm_crear_pedido_materiales y man_create_ot, las
#                  dos unicas que instancian proceso. Si apunta mal, se
#                  crean casos REALES en el Bonita equivocado.
# ══════════════════════════════════════════════════════════════════


# ── DESARROLLO / DEMO — 10.142.0.13 ──────────────────────────────
# Son los valores que ya estan commiteados en los datasources del
# repo, asi que para este ambiente el script no cambia ningun valor.
# Las passwords no son un secreto nuevo: estan en texto plano en los
# datasources versionados desde siempre.

PG_HOST=10.142.0.13
PG_PORT=5432
PG_DB=tools_prod_t
PG_USER=postgres
PG_PASS=!Password00

MY_HOST=10.142.0.13
MY_PORT=3306
MY_DB=assetv2
MY_USER=rootremote
MY_PASS=!Password00

BPM_URL=http://10.142.0.13:8080/bonita
BPM_USER=admin
BPM_PASS=123traza


