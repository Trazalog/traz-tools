<?xml version="1.0" encoding="UTF-8"?>
<!--
    API de envio de notificaciones push via Firebase Cloud Messaging.

    Expone DOS recursos con el mismo cuerpo de entrada y distinto contrato de
    respuesta:

      POST /send         Comportamiento historico. Responde 2xx SIEMPRE, incluso
                         cuando FCM rechaza el envio (el error viaja adentro del
                         cuerpo, en Result.Error). Lo consume la app Siddhi de
                         AssetPlanner en produccion, que marca procesado=1 con
                         cualquier 2xx. NO SE TOCA: cambiarlo a codigos de error
                         reales dejaria esas filas sin marcar y, con
                         on.error='WAIT' en el sink, entrarian en reintento
                         infinito.

      POST /send-strict  Mismo envio, contrato correcto. Devuelve 200 solo si
                         FCM acepto, 502 si FCM rechazo, y 500 si fallo la
                         mediacion. Es el que usa el Agente Minero.

    Por que existen los dos: el analisis de E0 verifico que /send devuelve
    HTTP 200 con {"Result":{"Error":"400 Bad Request ... not a valid FCM
    registration token"}} adentro. Un consumidor que mire solo el status da por
    enviada una notificacion que se perdio. Es el riesgo R4 de
    doc/agente/analisis-alertas-assetplanner.md, y la explicacion mas probable
    de las 434 filas encoladas en la cola de AssetPlanner desde 2024.

    Cuando AssetPlanner migre su app Siddhi para leer el cuerpo, puede pasar a
    /send-strict y /send queda deprecado.
-->
<api context="/tools/firebase" name="FirebaseConnectorAPI" xmlns="http://ws.apache.org/ns/synapse">

    <!-- ===================================================================
         POST /send  -  contrato historico, no modificar (compatibilidad v2)
         =================================================================== -->
    <resource methods="POST" uri-template="/send">
        <inSequence>
            <log level="custom">
                <property name="ingreso" value="Comienza secuencia notificacion"/>
            </log>
            <sequence key="MessageCreateSeq"/>
            <sequence key="FirebaseSendSeq"/>
            <respond/>
        </inSequence>
        <outSequence/>
        <faultSequence/>
    </resource>

    <!-- ===================================================================
         POST /send-strict  -  el status HTTP refleja lo que realmente paso
         =================================================================== -->
    <resource methods="POST" uri-template="/send-strict">
        <inSequence>
            <log level="custom">
                <property name="ingreso" value="Comienza secuencia notificacion (strict)"/>
            </log>
            <sequence key="MessageCreateSeq"/>
            <sequence key="FirebaseSendSeq"/>

            <!-- El conector no lanza fault cuando FCM rechaza: deja el error en
                 el cuerpo y sigue. Por eso hay que mirar el payload.

                 json-eval no se puede componer dentro del atributo source (el
                 filter espera XPath y falla el despliegue con "Invalid XPath
                 expression"). Se extrae primero a una property y se filtra
                 sobre eso. -->
            <property name="fcm_error" scope="default" type="STRING"
                      expression="json-eval($.Result.Error)"/>
            <filter source="get-property('fcm_error')" regex="(?s).+">
                <then>
                    <log level="custom">
                        <property name="ERROR_FCM" expression="get-property('fcm_error')"/>
                    </log>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="502"/>
                    <payloadFactory media-type="json">
                        <format>{"status":"error","origen":"fcm","detail":"$1"}</format>
                        <args>
                            <arg evaluator="xml" expression="get-property('fcm_error')"/>
                        </args>
                    </payloadFactory>
                    <respond/>
                </then>
                <else>
                    <property name="HTTP_SC" scope="axis2" type="STRING" value="200"/>
                    <payloadFactory media-type="json">
                        <format>{"status":"ok"}</format>
                        <args/>
                    </payloadFactory>
                    <respond/>
                </else>
            </filter>
        </inSequence>
        <outSequence/>

        <!-- Si falla la mediacion (conector no inicializa, timeout, etc.) el
             API tiene que decirlo con un 5xx, no responder 202 en silencio. -->
        <faultSequence>
            <log level="custom">
                <property name="FALLO" value="Fallo la mediacion del envio push"/>
                <property name="ERROR_CODE" expression="get-property('ERROR_CODE')"/>
                <property name="ERROR_MESSAGE" expression="get-property('ERROR_MESSAGE')"/>
            </log>
            <property name="HTTP_SC" scope="axis2" type="STRING" value="500"/>
            <payloadFactory media-type="json">
                <format>{"status":"error","origen":"mediacion","error_code":"$1","detail":"$2"}</format>
                <args>
                    <arg evaluator="xml" expression="get-property('ERROR_CODE')"/>
                    <arg evaluator="xml" expression="get-property('ERROR_MESSAGE')"/>
                </args>
            </payloadFactory>
            <respond/>
        </faultSequence>
    </resource>
</api>
