<data enableBatchRequests="true" enableBoxcarring="true" name="PANDataService" transports="http https local">
   <config enableOData="false" id="ToolsDataSource">
      <property name="carbon_datasource_name">ToolsDataSource</property>
   </config>
   <query id="panolSet" useConfig="ToolsDataSource">
      <sql>insert into pan.panol(descripcion, usuario_app, empr_id, esta_id,nombre) &#xd;values(:descripcion, :usuario_app, CAST(:empr_id AS INTEGER),cast(:esta_id as integer),:nombre) returning pano_id</sql>
      <result outputType="json">{ &#xd;  "respuesta":{&#xd;     "pano_id": "$pano_id"&#xd;   }&#xd;}&#xd;     </result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="nombre" sqlType="STRING"/>
      <param name="esta_id" sqlType="STRING"/>
   </query>
   <query id="panolGet" useConfig="ToolsDataSource">
      <sql>select pano_id, nombre, descripcion, loca_id, prov_id, pais_id, lat, lng&#xd;  from pan.panol&#xd;  where empr_id = CAST(:empr_id AS INTEGER)</sql>
      <result outputType="json">{&#xd;    "panoles":{&#xd;      "panol":[&#xd;        {&#xd;          "pano_id": "$pano_id",&#xd;          "nombre": "$nombre",&#xd;          "descripcion": "$descripcion",&#xd;          "loca_id": "$loca_id",&#xd;          "prov_id": "$prov_id",&#xd;          "pais_id": "$pais_id",&#xd;          "lat": "$lat",&#xd;          "lng": "$lng"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="panolUpdate" useConfig="ToolsDataSource">
      <sql>UPDATE pan.panol SET nombre = :nombre, descripcion = :descripcion, esta_id = CAST(:esta_id AS INTEGER) WHERE pano_id = CAST(:pano_id AS INTEGER)</sql>
      <param name="descripcion" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
      <param name="nombre" sqlType="STRING"/>
      <param name="esta_id" sqlType="STRING"/>
   </query>
   <query id="panolDelete" useConfig="ToolsDataSource">
      <sql>update pan.panol set eliminado = CAST(:eliminado AS BOOLEAN)&#xd;  where pano_id = CAST(:pano_id as INTEGER)</sql>
      <param name="eliminado" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="herramientasSet" useConfig="ToolsDataSource">
      <sql>insert into pan.herramientas(codigo, marca, modelo, descripcion, pano_id, usuario_app, empr_id)&#xd;  values(:codigo, :marca, :modelo, :descripcion, CAST(:pano_id AS INTEGER), :usuario_app, cast(:empr_id as INTEGER))&#xd;  returning herr_id</sql>
      <result outputType="json">{&#xd;  "respuesta":{&#xd;     "herr_id": "$herr_id"&#xd;  }&#xd;}</result>
      <param name="codigo" sqlType="STRING"/>
      <param name="marca" sqlType="STRING"/>
      <param name="modelo" sqlType="STRING"/>
      <param name="descripcion" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="herramientasGet" useConfig="ToolsDataSource">
      <sql>select H.herr_id, H.codigo, H.marca as marca_id, T.valor as marca, H.modelo, H.tipo, H.descripcion, H.pano_id, H.estado,  P.descripcion as pan_descrip&#xd;  from pan.herramientas H, core.tablas T, pan.panol P&#xd;  where H.empr_id = cast (:empr_id as INTEGER)&#xd;  and H.marca = T.tabl_id&#xd;  and H.pano_id = P.pano_id&#xd;  and H.eliminado = false</sql>
      <result outputType="json">{&#xd;  "herramientas":{&#xd;    "herramienta":[&#xd;      {&#xd;        "herr_id": "$herr_id",&#xd;        "codigo": "$codigo",&#xd;        "marca": "$marca",&#xd;        "marca_id": "$marca_id",&#xd;        "modelo": "$modelo",&#xd;        "tipo": "$tipo",&#xd;        "descripcion": "$descripcion",&#xd;        "pano_id": "$pano_id",&#xd;        "estado": "$estado",&#xd;        "pan_descrip": "$pan_descrip"&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="getTablas" useConfig="ToolsDataSource">
      <sql>select tabl_id, tabla, valor from core.tablas&#xd;where tabla = :tabla</sql>
      <result outputType="json">{&#xd;  "tablas":{&#xd;     "tabla":[&#xd;        {       &#xd;          "tabl_id": "$tabl_id", &#xd;          "tabla": "$tabla", &#xd;          "valor": "$valor"&#xd;        }&#xd;     ]&#xd;} &#xd;}</result>
      <param name="tabla" sqlType="STRING"/>
   </query>
   <query id="herramientasDelete" useConfig="ToolsDataSource">
      <sql>update pan.herramientas &#xd;set eliminado = true&#xd;where herr_id = CAST(:herr_id AS INTEGER)</sql>
      <param name="herr_id" sqlType="STRING"/>
   </query>
   <query id="herramientasUpdate" useConfig="ToolsDataSource">
      <sql>update &#xd;pan.herramientas &#xd;  set codigo = :codigo, marca = :marca, modelo = :modelo, descripcion = :descripcion, usuario_app = :usuario_app, empr_id = CAST(:empr_id as INTEGER)&#xd;where &#xd;  herr_id = CAST(:herr_id AS INTEGER)</sql>
      <param name="codigo" sqlType="STRING"/>
      <param name="marca" sqlType="STRING"/>
      <param name="modelo" sqlType="STRING"/>
      <param name="descripcion" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="salidaHerramientasSet" useConfig="ToolsDataSource">
      <sql>insert into pan.salida_panol (usuario_app, destino, empr_id, pano_id, observaciones, comprobante, responsable, info_id)&#xd;  values(:usuario_app, :destino, cast(:empr_id as INTEGER), CAST(:pano_id as INTEGER), :observaciones, :comprobante, :responsable, cast(:info_id as INTEGER)) returning sapa_id</sql>
      <result outputType="json">{&#xd;    "respuesta":{&#xd;      "sapa_id": "$sapa_id"&#xd;    }&#xd;  }</result>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="destino" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
      <param name="observaciones" sqlType="STRING"/>
      <param name="comprobante" sqlType="STRING"/>
      <param name="responsable" sqlType="STRING"/>
      <param name="info_id" sqlType="STRING"/>
   </query>
   <query id="salidaHerramientasDetaSet" useConfig="ToolsDataSource">
      <sql>insert into pan.deta_salida_panol (sapa_id, herr_id)&#xd;  values(CAST(:sapa_id AS INTEGER), CAST(:herr_id AS INTEGER))</sql>
      <param name="sapa_id" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
   </query>
   <query id="salidasPanol" useConfig="ToolsDataSource">
      <sql>select SP.destino, SP.observaciones, SP.comprobante, SP.responsable&#xd;  , SP.fec_alta, H.codigo, T.valor as marca, SP.sapa_id&#xd;  from pan.salida_panol SP, pan.deta_salida_panol DSP, pan.herramientas H, core.tablas T&#xd;  where&#xd;  sp.sapa_id = DSP.sapa_id&#xd;  and DSP.herr_id = H.herr_id&#xd;  and T.tabl_id = H.marca&#xd;  and SP.empr_id = cast (:empr_id as integer)&#xd;  order by SP.fec_alta DESC</sql>
      <result outputType="json"> {&#xd;    "salidas":{&#xd;        "salida":          [&#xd;            {&#xd;              "destino": "$destino",&#xd;              "observaciones": "$observaciones",&#xd;              "comprobante": "$comprobante",&#xd;              "responsable": "$responsable",&#xd;              "fec_alta": "$fec_alta",&#xd;              "codigo": "$codigo",&#xd;              "marca": "$marca",&#xd;              "sapa_id": "$sapa_id"&#xd;            }&#xd;          ]&#xd;   }&#xd;  }</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="herramientasSetEstado" useConfig="ToolsDataSource">
      <sql>update pan.herramientas &#xd;set estado = :estado&#xd;where herr_id = CAST(:herr_id as INTEGER)</sql>
      <param name="estado" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
   </query>
   <query id="entradasPanol" useConfig="ToolsDataSource">
      <sql>select EP.destino, EP.observaciones, EP.comprobante, EP.responsable, EP.fec_alta, H.codigo, T.valor as marca&#xd;  from pan.entrada_panol EP, pan.deta_entrada_panol DEP, pan.herramientas H, core.tablas T&#xd;  where EP.enpa_id = DEP.enpa_id&#xd;  and DEP.herr_id = H.herr_id&#xd;  and T.tabl_id = H.marca&#xd;  and EP.empr_id = cast (:empr_id as integer)</sql>
      <result outputType="json">{&#xd;    "entradas":{&#xd;        "entrada":          [&#xd;            {&#xd;              "destino": "$destino",&#xd;              "observaciones": "$observaciones",&#xd;              "comprobante": "$comprobante",&#xd;              "responsable": "$responsable",&#xd;              "fec_alta": "$fec_alta",&#xd;              "codigo": "$codigo",&#xd;              "marca": "$marca"&#xd;            }&#xd;          ]&#xd;   }&#xd;  }</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="entradaHerramientasSet" useConfig="ToolsDataSource">
      <sql>insert into pan.entrada_panol (usuario_app, destino, empr_id, pano_id, observaciones, comprobante, responsable, info_id)&#xd;  values(:usuario_app, :destino, cast(:empr_id as INTEGER), CAST(:pano_id as INTEGER), :observaciones, :comprobante, :responsable, cast(:info_id as INTEGER)) returning enpa_id</sql>
      <result outputType="json">{&#xd;    "respuesta":{&#xd;      "enpa_id": "$enpa_id"&#xd;    }&#xd;  }</result>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="destino" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
      <param name="observaciones" sqlType="STRING"/>
      <param name="comprobante" sqlType="STRING"/>
      <param name="responsable" sqlType="STRING"/>
      <param name="info_id" sqlType="STRING"/>
   </query>
   <query id="entradaHerramientasDetaSet" useConfig="ToolsDataSource">
      <sql>insert into pan.deta_entrada_panol (enpa_id, herr_id)&#xd;  values(CAST(:enpa_id AS INTEGER), CAST(:herr_id AS INTEGER))</sql>
      <param name="herr_id" sqlType="STRING"/>
      <param name="enpa_id" sqlType="STRING"/>
   </query>
   <query id="equiposGet" useConfig="ToolsDataSource">
      <sql>select E.equi_id, E.descripcion, E.marca, E.codigo&#xd;  from core.equipos E&#xd;  where E.empr_id = CAST(:empr_id as INTEGER)</sql>
      <result outputType="json">{&#xd;    "equipos":{&#xd;      "equipo":[&#xd;        {&#xd;          "equi_id": "$equi_id",&#xd;          "descripcion": "$descripcion",&#xd;          "marca": "$marca",&#xd;          "codigo": "$codigo"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="componentesGetPorEquipo" useConfig="ToolsDataSource">
      <sql>select  C.comp_id, C.descripcion&#xd;  from core.componentes C, core.equipos E, core.componente_equipo CE&#xd;  where C.comp_id = CE.comp_id&#xd;  and E.equi_id = CE.equi_id&#xd;  and E.equi_id = CAST(:equi_id as INTEGER)</sql>
      <result outputType="json">{&#xd;    "componentes":{&#xd;      "componente":[&#xd;        {&#xd;          "comp_id": "$comp_id",&#xd;          "descripcion": "$descripcion"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="equi_id" sqlType="STRING"/>
   </query>
   <query id="estanteriasGetPorPanol" useConfig="ToolsDataSource">
      <sql>select E.estan_id, E.descripcion, E.codigo, E.filas&#xd;  from pan.estanteria E&#xd;  where E.pano_id = CAST(:pano_id as INTEGER)</sql>
      <result outputType="json">{&#xd;    "estanterias":{&#xd;      "estanteria":[&#xd;        {&#xd;          "estan_id": "$estan_id",&#xd;          "descripcion": "$descripcion",&#xd;          "codigo": "$codigo",&#xd;          "filas": "$filas"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="estanteriasSetPorPanol" useConfig="ToolsDataSource">
      <sql>insert into pan.estanteria (descripcion, codigo, filas, usuario_app, empr_id, pano_id)&#xd;  values(:descripcion, :codigo, CAST(:filas as INTEGER), :usuario_app, CAST(:empr_id as INTEGER), CAST(:pano_id as INTEGER))</sql>
      <param name="descripcion" sqlType="STRING"/>
      <param name="codigo" sqlType="STRING"/>
      <param name="filas" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="compEquipoIdGet" useConfig="ToolsDataSource">
      <sql>select coeq_id&#xd;  from core.componente_equipo CE&#xd;  where CE.equi_id = Cast(:equi_id as INTEGER)&#xd;  and CE.comp_id = CAST(:comp_id as INTEGER)</sql>
      <result outputType="json">{&#xd;    "respuesta": {&#xd;      "coeq_id": "$coeq_id"&#xd;    }&#xd;  }</result>
      <param name="equi_id" sqlType="STRING"/>
      <param name="comp_id" sqlType="STRING"/>
   </query>
   <query id="trazacompRecibe" useConfig="ToolsDataSource">
      <sql>insert into pan.trazacomponente (coeq_id,estan_id,fila,ultimo_recibe,ultimo_entrega,estado,observaciones,usuario_app,empr_id, pano_id) values(CAST(:coeq_id AS INTEGER),CAST(:estan_id AS INTEGER), CAST(:fila AS INTEGER), :ultimo_recibe, :ultimo_entrega, :estado, :observaciones, :usuario_app, CAST(:empr_id AS INTEGER),CAST(:pano_id AS INTEGER))</sql>
      <param name="estan_id" sqlType="STRING"/>
      <param name="fila" sqlType="STRING"/>
      <param name="ultimo_recibe" sqlType="STRING"/>
      <param name="ultimo_entrega" sqlType="STRING"/>
      <param name="estado" sqlType="STRING"/>
      <param name="observaciones" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="coeq_id" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="componenteAEntregarPorPanol" useConfig="ToolsDataSource">
      <sql>select TC.coeq_id, C.descripcion as compo_desc, E.descripcion as equipo_desc, E.codigo, E.marca&#xd;  from pan.trazacomponente TC, core.componente_equipo CE, core.componentes C, core.equipos E&#xd;  where TC.coeq_id = CE.coeq_id&#xd;  and CE.comp_id = C.comp_id&#xd;  and CE.equi_id = E.equi_id&#xd;  and TC.estado != 'TRANSITO'&#xd;  and TC.pano_id = CAST(:pano_id as INTEGER)</sql>
      <result outputType="json">{&#xd;    "componentes":{&#xd;      "componente":[&#xd;        {&#xd;          "coeq_id": "$coeq_id",&#xd;          "compo_desc": "$compo_desc",&#xd;          "equipo_desc": "$equipo_desc",&#xd;          "codigo": "$codigo",&#xd;          "marca": "$marca"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="trazacompEntrega" useConfig="ToolsDataSource">
      <sql>insert into pan.trazacomponente (coeq_id,ultimo_recibe,ultimo_entrega,estado,observaciones,usuario_app,empr_id, pano_id) values(CAST(:coeq_id AS INTEGER), :ultimo_recibe, :ultimo_entrega, :estado, :observaciones, :usuario_app, CAST(:empr_id AS INTEGER),CAST(:pano_id AS INTEGER))</sql>
      <param name="coeq_id" sqlType="STRING"/>
      <param name="ultimo_recibe" sqlType="STRING"/>
      <param name="ultimo_entrega" sqlType="STRING"/>
      <param name="estado" sqlType="STRING"/>
      <param name="observaciones" sqlType="STRING"/>
      <param name="usuario_app" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="herramientasPanolGetPorEstado" useConfig="ToolsDataSource">
      <sql>select H.herr_id, H.codigo, H.marca as marca_id, H.pano_id, T.valor as marca, H.modelo, H.tipo, H.descripcion&#xd;     , P.nombre as pan_descrip&#xd;  from pan.herramientas H, core.tablas T, pan.panol P,&#xd;  (	select&#xd;	:estado estado) param&#xd;  where H.marca = T.tabl_id&#xd;  and H.pano_id = P.pano_id&#xd;  and H.eliminado = false&#xd;  and H.estado =&#xd;	case when param.estado = 'TODOS' then H.estado&#xd;	else param.estado end</sql>
      <result outputType="json">{&#xd;    "herramientas":{&#xd;      "herramienta":[&#xd;        {&#xd;          "herr_id": "$herr_id",&#xd;          "codigo": "$codigo",&#xd;          "marca": "$marca",&#xd;          "marca_id": "$marca_id",&#xd;          "pano_id": "$pano_id",&#xd;          "modelo": "$modelo",&#xd;          "tipo": "$tipo",&#xd;          "descripcion": "$descripcion",&#xd;          "pan_descrip":"$pan_descrip"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="estado" sqlType="STRING"/>
   </query>
   <query id="establecimientoPorEmpresa" useConfig="ToolsDataSource">
      <sql>select E.esta_id, E.nombre&#xd;  from prd.establecimientos E&#xd;  where E.empr_id = CAST(:empr_id as INTEGER)</sql>
      <result outputType="json">{&#xd; "establecimientos":{&#xd;   "establecimiento":[&#xd;        {&#xd;          "esta_id": "$esta_id",&#xd;          "nombre": "$nombre"&#xd;        }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="panolGetPorEstablecimiento" useConfig="ToolsDataSource">
      <sql>select nombre, pano_id, descripcion, loca_id, prov_id, pais_id, lat, lng&#xd;  from pan.panol&#xd;  where esta_id = CAST(:esta_id AS INTEGER)&#xd;  and eliminado = false;</sql>
      <result outputType="json">{&#xd;    "panoles":{&#xd;      "panol":[&#xd;        {&#xd;          "nombre": "$nombre",&#xd;          "pano_id": "$pano_id",&#xd;          "descripcion": "$descripcion",&#xd;          "loca_id": "$loca_id",&#xd;          "prov_id": "$prov_id",&#xd;          "pais_id": "$pais_id",&#xd;          "lat": "$lat",&#xd;          "lng": "$lng"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="esta_id" sqlType="STRING"/>
   </query>
   <query id="encargadoPanolSet" useConfig="ToolsDataSource">
      <sql>insert into pan.encargado_panol (pano_id, user_id)&#xd;values (CAST(:pano_id AS INTEGER), CAST(:user_id AS INTEGER))</sql>
      <param name="pano_id" sqlType="STRING"/>
      <param name="user_id" sqlType="STRING"/>
   </query>
   <query id="encargadoXPanolGet" useConfig="ToolsDataSource">
      <sql>select U.id, U.first_name, U.last_name&#xd;FROM seg.users U, pan.encargado_panol E&#xd;WHERE&#xd;E.user_id = U.id&#xd;and U.status = 'approved' &#xd;and U.banned_users = 'unban' &#xd;and E.pano_id = CAST(:pano_id AS INTEGER);</sql>
      <result outputType="json">{&#xd;    "users":{&#xd;      "user":[&#xd;        {&#xd;          "id": "$id",&#xd;          "first_name": "$first_name",&#xd;          "last_name": "$last_name"&#xd;        }&#xd;      ]&#xd;    }&#xd;}</result>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="validaEstadoHerramienta" useConfig="ToolsDataSource">
      <sql>select case when exists &#xd;(select true from pan.herramientas h where h.herr_id = cast(:herr_id as integer)&#xd;and h.empr_id = cast(:empr_id as integer)&#xd;and h.estado = 'TRANSITO'&#xd;) then 'true' else 'false'&#xd;end</sql>
      <result outputType="json">{&#xd;    "resultado" : {&#xd;        "existe": "$case"&#xd;    }&#xd;}</result>
      <param name="herr_id" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
   </query>
   <query id="panolGetxId" useConfig="ToolsDataSource">
      <sql>select p.pano_id , p.descripcion , p.nombre, u.first_name , u.last_name &#xd;from pan.panol p&#xd;join pan.encargado_panol ep on ep.pano_id = p.pano_id &#xd;join seg.users u on u.id = ep.user_id &#xd;where p.pano_id = cast (:pan_id as integer)</sql>
      <result outputType="json">{&#xd;    "panoles":{&#xd;      "panol":[&#xd;        {&#xd;          "pano_id": "$pano_id",&#xd;          "nombre": "$nombre",&#xd;          "descripcion": "$descripcion",&#xd;          "first_name": "$first_name",&#xd;          "last_name": "$last_name"&#xd;        }&#xd;      ]&#xd;    }&#xd;  }</result>
      <param name="pan_id" sqlType="STRING"/>
   </query>
   <query id="deleteEncargadoPanol" useConfig="ToolsDataSource">
      <sql>DELETE FROM pan.encargado_panol &#xd;WHERE pano_id = CAST(:pano_id AS INTEGER);</sql>
      <param name="pano_id" sqlType="STRING"/>
   </query>
   <query id="getSalidaxSapaId" useConfig="ToolsDataSource">
      <sql>select sp.sapa_id, sp.info_id, sp.observaciones, u.last_name , u.first_name , u.dni , sp.fec_alta, t.label, t.valor, p.nombre as panol, e.nombre as establecimiento, h.codigo as codigoherramienta, h.descripcion as descherramienta  &#xd;from pan.salida_panol sp &#xd;inner join pan.deta_salida_panol dsp on sp.sapa_id = dsp.sapa_id &#xd;inner join pan.herramientas h on h.herr_id = dsp.herr_id &#xd;inner join frm.instancias_formularios t on t.info_id = sp.info_id&#xd;inner join pan.panol p on p.pano_id = sp.pano_id&#xd;inner join prd.establecimientos e on e.esta_id = p.esta_id &#xd;inner join seg.users u on u.usernick = sp.responsable &#xd;where sp.sapa_id = cast(:sapa_id as integer);</sql>
      <result outputType="json"> {&#xd;    "salidas":{&#xd;        "salida":          [&#xd;            {&#xd;              "sapa_id": "$sapa_id",&#xd;              "observaciones": "$observaciones",&#xd;              "fec_alta": "$fec_alta",&#xd;              "establecimiento": "$establecimiento",&#xd;              "panol": "$panol",&#xd;              "first_name": "$first_name",&#xd;              "last_name": "$last_name",&#xd;              "dni": "$dni",&#xd;              "info_id": "$info_id",&#xd;              "codigoherramienta":"$codigoherramienta",&#xd;              "descherramienta":"$descherramienta"&#xd;            }&#xd;          ]&#xd;   }&#xd;  }</result>
      <param name="sapa_id" sqlType="STRING"/>
   </query>
   <query id="movimientosHerramientaspaginado" useConfig="ToolsDataSource">
      <sql>SELECT&#xd;            mov.*,&#xd;            COUNT(*) OVER() AS total_count&#xd;        FROM&#xd;            (&#xd;                SELECT&#xd;                    'ENTREGA' AS tipo,&#xd;                    SP.destino,&#xd;                    SP.observaciones,&#xd;                    SP.comprobante,&#xd;                    SP.responsable,&#xd;                    SP.fec_alta,&#xd;                    SP.sapa_id AS movimiento_id,&#xd;                    EST.nombre || ' / ' || P.descripcion AS establecimiento,&#xd;                    string_agg(&#xd;                        H.codigo || '-' || H.descripcion,&#xd;                        ' / ' ORDER BY H.codigo&#xd;                    ) AS herramientas&#xd;                FROM&#xd;                    pan.salida_panol SP,&#xd;                    pan.deta_salida_panol DSP,&#xd;                    pan.herramientas H,&#xd;                    core.tablas T,&#xd;                    pan.panol P,&#xd;                    prd.establecimientos EST&#xd;                WHERE&#xd;                    SP.sapa_id = DSP.sapa_id&#xd;                    AND DSP.herr_id = H.herr_id&#xd;                    AND T.tabl_id = H.marca&#xd;                    AND SP.pano_id = P.pano_id&#xd;                    AND P.esta_id = EST.esta_id&#xd;                    AND SP.empr_id = CAST(:empr_id1 AS INTEGER)&#xd;                GROUP BY&#xd;                    SP.destino,&#xd;                    SP.observaciones,&#xd;                    SP.comprobante,&#xd;                    SP.responsable,&#xd;                    SP.fec_alta,&#xd;                    SP.sapa_id,&#xd;                    EST.nombre,&#xd;                    P.descripcion&#xd;                UNION ALL&#xd;                SELECT&#xd;                    'RECEPCION' AS tipo,&#xd;                    EP.destino,&#xd;                    EP.observaciones,&#xd;                    EP.comprobante,&#xd;                    EP.responsable,&#xd;                    EP.fec_alta,&#xd;                    EP.enpa_id AS movimiento_id,&#xd;                    EST.nombre || ' / ' || P.descripcion AS establecimiento,&#xd;                    string_agg(&#xd;                        H.codigo || '-' || H.descripcion,&#xd;                        ' / ' ORDER BY H.codigo&#xd;                    ) AS herramientas&#xd;                FROM&#xd;                    pan.entrada_panol EP,&#xd;                    pan.deta_entrada_panol DEP,&#xd;                    pan.herramientas H,&#xd;                    core.tablas T,&#xd;                    pan.panol P,&#xd;                    prd.establecimientos EST&#xd;                WHERE&#xd;                    EP.enpa_id = DEP.enpa_id&#xd;                    AND DEP.herr_id = H.herr_id&#xd;                    AND T.tabl_id = H.marca&#xd;                    AND EP.pano_id = P.pano_id&#xd;                    AND P.esta_id = EST.esta_id&#xd;                    AND EP.empr_id = CAST(:empr_id2 AS INTEGER)&#xd;                GROUP BY&#xd;                    EP.destino,&#xd;                    EP.observaciones,&#xd;                    EP.comprobante,&#xd;                    EP.responsable,&#xd;                    EP.fec_alta,&#xd;                    EP.enpa_id,&#xd;                    EST.nombre,&#xd;                    P.descripcion&#xd;            ) mov,&#xd;            (&#xd;                SELECT&#xd;                    :search AS search&#xd;            ) param&#xd;        WHERE&#xd;            param.search IS NULL&#xd;            OR param.search = ''&#xd;            OR UPPER(COALESCE(mov.tipo, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.destino, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.observaciones, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.comprobante, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.responsable, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.establecimiento, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(mov.herramientas, '')) LIKE UPPER('%' || param.search || '%')&#xd;        ORDER BY&#xd;            mov.fec_alta DESC&#xd;        LIMIT CAST(:page_size AS INTEGER)&#xd;        OFFSET CAST(:start AS INTEGER)</sql>
      <result outputType="json">{&#xd;    "movimientos":{&#xd;        "movimiento":          [&#xd;            {&#xd;                 "tipo": "$tipo",&#xd;                 "destino": "$destino",&#xd;                 "observaciones": "$observaciones",&#xd;                 "comprobante": "$comprobante",&#xd;                 "responsable": "$responsable",&#xd;                 "fec_alta": "$fec_alta",&#xd;                 "herramientas": "$herramientas",&#xd;                 "movimiento_id": "$movimiento_id",&#xd;                 "establecimiento": "$establecimiento",&#xd;                 "total_count":"$total_count"&#xd;            }&#xd;          ]&#xd;   }&#xd;  }</result>
      <param name="empr_id1" sqlType="STRING"/>
      <param name="empr_id2" sqlType="STRING"/>
      <param name="search" sqlType="STRING"/>
      <param name="page_size" sqlType="STRING"/>
      <param name="start" sqlType="STRING"/>
   </query>
   <query id="getEntradaxEnpaId" useConfig="ToolsDataSource">
      <sql>select ep.enpa_id, ep.info_id, ep.observaciones, u.last_name , u.first_name , u.dni , ep.fec_alta, t.label, t.valor, p.nombre as panol, e.nombre as establecimiento, h.codigo as codigoherramienta, h.descripcion as descherramienta&#xd;from pan.entrada_panol ep &#xd;inner join pan.deta_entrada_panol dep on dep.enpa_id  = ep.enpa_id  &#xd;inner join pan.herramientas h on h.herr_id = dep.herr_id &#xd;inner join frm.instancias_formularios t on t.info_id = ep.info_id&#xd;inner join pan.panol p on p.pano_id = ep.pano_id&#xd;inner join prd.establecimientos e on e.esta_id = p.esta_id &#xd;inner join seg.users u on u.usernick = ep.responsable &#xd;where ep.enpa_id = cast(:enpa_id as integer);</sql>
      <result outputType="json">{&#xd;    "entradas":{&#xd;        "entrada":          [&#xd;            {&#xd;              "enpa_id": "$enpa_id",&#xd;              "observaciones": "$observaciones",&#xd;              "fec_alta": "$fec_alta",&#xd;              "establecimiento": "$establecimiento",&#xd;              "panol": "$panol",&#xd;              "first_name": "$first_name",&#xd;              "last_name": "$last_name",&#xd;              "dni": "$dni",&#xd;              "info_id": "$info_id",&#xd; "codigoherramienta":"$codigoherramienta",&#xd;              "descherramienta":"$descherramienta"&#xd;            }&#xd;          ]&#xd;   }&#xd;  }</result>
      <param name="enpa_id" sqlType="STRING"/>
   </query>
   <query id="herramientasGetPaginado" useConfig="ToolsDataSource">
      <sql>SELECT&#xd;    h.*,&#xd;    COUNT(*) OVER() AS total_count&#xd;FROM&#xd;    (&#xd;        SELECT&#xd;            H.herr_id,&#xd;            H.codigo,&#xd;            H.marca AS marca_id,&#xd;            T.valor AS marca,&#xd;            H.modelo,&#xd;            H.tipo,&#xd;            H.descripcion,&#xd;            H.pano_id,&#xd;            H.estado,&#xd;            H.fec_alta,&#xd;            P.descripcion AS pan_descrip,&#xd;            e.esta_id,&#xd;            e.nombre AS establecimiento,&#xd;            th_agg.tipoHerramienta,&#xd;            th_agg.colorTipo,&#xd;            cert.fec_vencimiento,&#xd;            cert.estado_certificacion&#xd;        FROM pan.herramientas H&#xd;        INNER JOIN core.tablas T&#xd;            ON H.marca = T.tabl_id&#xd;        INNER JOIN pan.panol P&#xd;            ON H.pano_id = P.pano_id&#xd;        INNER JOIN prd.establecimientos e&#xd;            ON e.esta_id = P.esta_id&#xd;        LEFT JOIN (&#xd;            SELECT&#xd;                th.herr_id,&#xd;                STRING_AGG(t2.descripcion, '-' ORDER BY t2.descripcion) AS tipoHerramienta,&#xd;                STRING_AGG(t2.valor2, '-' ORDER BY t2.descripcion) AS colorTipo&#xd;            FROM pan.tipos_herramienta th&#xd;            INNER JOIN core.tablas t2&#xd;                ON t2.tabl_id = th.tipo_id&#xd;            GROUP BY th.herr_id&#xd;        ) th_agg&#xd;            ON th_agg.herr_id = H.herr_id&#xd;        LEFT JOIN (&#xd;    SELECT DISTINCT ON (herr_id) &#xd;        herr_id, &#xd;        fec_vencimiento,&#xd;        CASE&#xd;            WHEN fec_vencimiento &lt; now() THEN 'VENCIDO'&#xd;            WHEN fec_vencimiento &lt; now() + (COALESCE(NULLIF(CAST(:dias_vencimiento AS VARCHAR), ''), '30')::INTEGER * INTERVAL '1 day')&#xd;                THEN 'POR_VENCER'&#xd;            ELSE 'VIGENTE'&#xd;        END AS estado_certificacion&#xd;    FROM pan.certificaciones&#xd;    ORDER BY herr_id, fec_vencimiento DESC&#xd;) cert ON cert.herr_id = H.herr_id&#xd;        WHERE&#xd;            H.empr_id = CAST(:empr_id AS INTEGER)&#xd;            AND H.eliminado = false&#xd;    ) h,&#xd;    (&#xd;        SELECT &#xd;            CAST(:search AS VARCHAR)      AS search,&#xd;            CAST(:order_dir AS VARCHAR)   AS order_dir,&#xd;            CAST(:esta_id AS VARCHAR)     AS esta_id,&#xd;            CAST(:pano_id AS VARCHAR)     AS pano_id,&#xd;            CAST(:tipo AS VARCHAR)        AS tipo,&#xd;            CAST(:cert_vencer AS VARCHAR) AS cert_vencer&#xd;    ) param&#xd;WHERE&#xd;    (&#xd;        param.search IS NULL&#xd;        OR param.search = ''&#xd;        OR UPPER(COALESCE(h.codigo, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.descripcion, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.modelo, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.tipo, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.marca, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.pan_descrip, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.estado, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(h.estado_certificacion, '')) LIKE UPPER('%' || param.search || '%')&#xd;    )&#xd;    AND (&#xd;        param.esta_id IS NULL &#xd;        OR param.esta_id = '' &#xd;        OR h.esta_id = CAST(param.esta_id AS INTEGER)&#xd;    )&#xd;    AND (&#xd;        param.pano_id IS NULL &#xd;        OR param.pano_id = '' &#xd;        OR h.pano_id = CAST(param.pano_id AS INTEGER)&#xd;    )&#xd;    AND (&#xd;        param.tipo IS NULL &#xd;        OR param.tipo = ''&#xd;        OR EXISTS (&#xd;            SELECT 1 &#xd;            FROM pan.tipos_herramienta th2&#xd;            INNER JOIN core.tablas t3 &#xd;                ON t3.tabl_id = th2.tipo_id&#xd;            WHERE th2.herr_id = h.herr_id&#xd;              AND (&#xd;                  t3.valor = ANY(STRING_TO_ARRAY(param.tipo, ','))&#xd;                  OR t3.descripcion = ANY(STRING_TO_ARRAY(param.tipo, ','))&#xd;              )&#xd;        )&#xd;    )&#xd;    AND (&#xd;        param.cert_vencer IS NULL &#xd;        OR param.cert_vencer = ''&#xd;        OR param.cert_vencer = '0'&#xd;        OR (param.cert_vencer = '1' AND h.estado_certificacion IN ('VENCIDO', 'POR_VENCER'))&#xd;    )&#xd;ORDER BY&#xd;    CASE WHEN LOWER(param.order_dir) = 'asc'  THEN h.fec_alta END ASC,&#xd;    CASE WHEN LOWER(param.order_dir) = 'desc' THEN h.fec_alta END DESC&#xd;LIMIT CAST(:page_size AS INTEGER)&#xd;OFFSET CAST(:start AS INTEGER)</sql>
      <result outputType="json">{&#xd;  "herramientas":{&#xd;    "herramienta":[&#xd;      {&#xd;        "herr_id": "$herr_id",&#xd;        "codigo": "$codigo",&#xd;        "marca": "$marca",&#xd;        "marca_id": "$marca_id",&#xd;        "modelo": "$modelo",&#xd;        "tipo": "$tipo",&#xd;        "descripcion": "$descripcion",&#xd;        "pano_id": "$pano_id",&#xd;        "estado": "$estado",&#xd;        "pan_descrip": "$pan_descrip",&#xd;        "total_count": "$total_count",&#xd;        "establecimiento":"$establecimiento",&#xd;        "colorTipo":"$colorTipo",&#xd;        "tipoHerramienta":"$tipoHerramienta",&#xd;        "estado_certificacion":"$estado_certificacion"&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="empr_id" sqlType="STRING"/>
      <param name="search" sqlType="STRING"/>
      <param name="page_size" sqlType="STRING"/>
      <param name="start" sqlType="STRING"/>
      <param name="order_dir" sqlType="STRING"/>
      <param name="esta_id" sqlType="STRING"/>
      <param name="pano_id" sqlType="STRING"/>
      <param name="tipo" sqlType="STRING"/>
      <param name="cert_vencer" sqlType="STRING"/>
      <param name="dias_vencimiento" sqlType="STRING"/>
   </query>
   <query id="setTiposHerramienta" useConfig="ToolsDataSource">
      <sql>insert into pan.tipos_herramienta(herr_id, tipo_id)&#xd;  values(CAST(:herr_id AS INTEGER), :tipo_id )&#xd;  returning tiphe_id</sql>
      <result outputType="json">{&#xd;  "tipos":{&#xd;    "tipo":[&#xd;      {&#xd;        "tiphe_id": "$tiphe_id"&#xd;&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="herr_id" sqlType="STRING"/>
      <param name="tipo_id" sqlType="STRING"/>
   </query>
   <query id="setInhabilitacion" useConfig="ToolsDataSource">
      <sql>INSERT INTO pan.habilitaciones_herramienta&#xd;    (herr_id, user_app, justificacion, tipo_movimiento)&#xd;VALUES&#xd;    (CAST(:herr_id AS INTEGER),&#xd;     CAST(:user_app AS VARCHAR),&#xd;     CAST(:justificacion AS VARCHAR),&#xd;      CAST(:tipo_movimiento AS VARCHAR))</sql>
      <param name="herr_id" sqlType="STRING"/>
      <param name="user_app" sqlType="STRING"/>
      <param name="justificacion" sqlType="STRING"/>
      <param name="tipo_movimiento" sqlType="STRING"/>
   </query>
   <query id="getMovimientosherramientas" useConfig="ToolsDataSource">
      <sql>SELECT&#xd;    v.nro_vale,&#xd;    v.tipo_movimiento,&#xd;    v.fecha_hora,&#xd;    v.responsable,&#xd;    v.establecimiento_panol,&#xd;    v.justificacion_observacion,&#xd;    v.empr_id,&#xd;    v.eliminado,&#xd;    v.herr_id,&#xd;    v.herr_codigo,&#xd;    v.herr_descripcion,&#xd;    COUNT(*) OVER() AS total_registros&#xd;FROM pan.vw_movimientos_panol v&#xd;CROSS JOIN (&#xd;    SELECT&#xd;        CAST(:empr_id AS integer) AS empr_id_param,&#xd;        CAST(:tipo_movimiento AS text) AS tipo_movimiento_param,&#xd;        CAST(:herr_id AS text) AS herr_id_param,&#xd;        CAST(:fecha_desde AS text) AS fecha_desde_param,&#xd;        CAST(:fecha_hasta AS text) AS fecha_hasta_param,&#xd;        CAST(:busqueda AS text) AS busqueda_param&#xd;) p&#xd;WHERE v.eliminado = false&#xd;  AND v.empr_id = COALESCE(&#xd;        NULLIF(p.empr_id_param, -1),&#xd;        v.empr_id&#xd;      )&#xd;  AND v.tipo_movimiento = COALESCE(&#xd;        NULLIF(p.tipo_movimiento_param, 'TODOS'),&#xd;        v.tipo_movimiento&#xd;      )&#xd;  AND v.herr_id IS NOT DISTINCT FROM COALESCE(&#xd;        CAST(NULLIF(p.herr_id_param, 'TODOS') AS integer),&#xd;        v.herr_id&#xd;      )&#xd;  AND v.fecha_hora &gt;= COALESCE(&#xd;        CAST(NULLIF(p.fecha_desde_param, 'TODOS') AS date),&#xd;        v.fecha_hora::date&#xd;      )&#xd;  AND v.fecha_hora &lt; COALESCE(&#xd;        CAST(NULLIF(p.fecha_hasta_param, 'TODOS') AS date),&#xd;        v.fecha_hora::date&#xd;      ) + INTERVAL '1 day'&#xd;  AND concat_ws(&#xd;        ' ',&#xd;        v.responsable,&#xd;        v.herr_codigo,&#xd;        v.herr_descripcion,&#xd;        v.establecimiento_panol,&#xd;        v.tipo_movimiento, &#xd;        v.justificacion_observacion&#xd;      ) ILIKE '%' || COALESCE(&#xd;        NULLIF(p.busqueda_param, 'TODOS'),&#xd;        ''&#xd;      ) || '%'&#xd;ORDER BY v.fecha_hora DESC&#xd;LIMIT cast(:limit as integer) OFFSET cast(:offset as integer)</sql>
      <result outputType="json">{&#xd;  "movimientos":{&#xd;    "movimiento":[&#xd;      {&#xd;        "nro_vale": "$nro_vale",&#xd;        "herr_id": "$herr_id",&#xd;        "tipo_movimiento": "$tipo_movimiento",&#xd;        "fecha_hora": "$fecha_hora",&#xd;        "responsable": "$responsable",&#xd;        "establecimiento_panol": "$establecimiento_panol",&#xd;        "justificacion_observacion": "$justificacion_observacion",&#xd;        "herr_codigo": "$herr_codigo",&#xd;        "herr_descripcion": "$herr_descripcion",&#xd;        "total_registros": "$total_registros"&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="empr_id" sqlType="STRING"/>
      <param name="tipo_movimiento" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
      <param name="fecha_desde" sqlType="STRING"/>
      <param name="fecha_hasta" sqlType="STRING"/>
      <param name="busqueda" sqlType="STRING"/>
      <param name="limit" sqlType="STRING"/>
      <param name="offset" sqlType="STRING"/>
   </query>
   <query id="setCertificacion" useConfig="ToolsDataSource">
      <sql>insert into pan.certificaciones(herr_id, fecha_hora ,fec_vencimiento, entidad_id, adjunto, adjunto_nombre)&#xd;values (&#xd; cast(:herr_id as integer),&#xd; cast(:fecha_hora as timestamp),&#xd; cast(:fec_vencimiento as timestamp),&#xd; :entidad_id,&#xd; cast(:adjunto as bytea),&#xd; :adjunto_nombre&#xd; )</sql>
      <param name="herr_id" sqlType="STRING"/>
      <param name="fecha_hora" sqlType="STRING"/>
      <param name="fec_vencimiento" sqlType="STRING"/>
      <param name="entidad_id" sqlType="STRING"/>
      <param name="adjunto" sqlType="STRING"/>
      <param name="adjunto_nombre" sqlType="STRING"/>
   </query>
   <query id="getCertificacionxHerrId" useConfig="ToolsDataSource">
      <sql>SELECT&#xd;            c.*,&#xd;            COUNT(*) OVER() AS total_count&#xd;        FROM&#xd;            (&#xd;                SELECT&#xd;                    C.cert_id,&#xd;                    C.herr_id,&#xd;                    H.codigo AS herr_codigo,&#xd;                    H.descripcion AS herr_descripcion,&#xd;                    C.fec_alta,&#xd;                    C.fec_vencimiento,&#xd;                    C.entidad_id,&#xd;C.adjunto,&#xd;C.adjunto_nombre,&#xd;                    T.valor AS entidad_nombre,&#xd;                    C.fecha_hora,&#xd;                    CASE&#xd;                        WHEN C.fec_vencimiento &lt; now() THEN 'VENCIDO'&#xd;                        WHEN C.fec_vencimiento &lt; now() + interval '30 days' THEN 'POR_VENCER'&#xd;                        ELSE 'VIGENTE'&#xd;                    END AS estado_certificacion&#xd;                FROM pan.certificaciones C&#xd;                INNER JOIN pan.herramientas H&#xd;                    ON H.herr_id = C.herr_id&#xd;                LEFT JOIN core.tablas T&#xd;                    ON T.tabl_id = C.entidad_id&#xd;                WHERE&#xd;                    H.empr_id = CAST(:empr_id AS INTEGER)&#xd;                    AND H.eliminado = false&#xd;                    AND (&#xd;                        CAST(:herr_id AS VARCHAR) IS NULL&#xd;                        OR CAST(:herr_id2 AS VARCHAR) = ''&#xd;                        OR C.herr_id = CAST(:herr_id3 AS INTEGER)&#xd;                    )&#xd;            ) c,&#xd;            (&#xd;                SELECT CAST(:search AS VARCHAR)    AS search,&#xd;                       CAST(:order_dir AS VARCHAR) AS order_dir&#xd;            ) param&#xd;        WHERE&#xd;            param.search IS NULL&#xd;            OR param.search = ''&#xd;            OR UPPER(COALESCE(c.herr_codigo, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(c.herr_descripcion, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(c.entidad_nombre, '')) LIKE UPPER('%' || param.search || '%')&#xd;            OR UPPER(COALESCE(c.estado_certificacion, '')) LIKE UPPER('%' || param.search || '%')&#xd;        ORDER BY&#xd;            CASE WHEN LOWER(param.order_dir) = 'asc'  THEN c.fec_vencimiento END ASC,&#xd;            CASE WHEN LOWER(param.order_dir) = 'desc' THEN c.fec_vencimiento END DESC&#xd;        LIMIT CAST(:page_size AS INTEGER)&#xd;        OFFSET CAST(:start AS INTEGER)</sql>
      <result outputType="json">{&#xd;  "certificaciones":{&#xd;    "certificacion":[&#xd;      {&#xd;        "herr_id": "$herr_id",&#xd;        "fecha_hora": "$fecha_hora",&#xd;        "adjunto": "$adjunto",&#xd;        "fec_vencimiento": "$fec_vencimiento",&#xd;        "entidad_nombre": "$entidad_nombre",&#xd;        "adjunto_nombre": "$adjunto_nombre",&#xd;        "total_count": "$total_count"&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="empr_id" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
      <param name="search" sqlType="STRING"/>
      <param name="order_dir" sqlType="STRING"/>
      <param name="page_size" sqlType="STRING"/>
      <param name="start" sqlType="STRING"/>
      <param name="herr_id2" sqlType="STRING"/>
      <param name="herr_id3" sqlType="STRING"/>
   </query>
   <query id="setChecklist" useConfig="ToolsDataSource">
      <sql>insert into pan.checklists (herr_id, fecha_hora,responsable, username, info_id)&#xd;values (&#xd; cast(:herr_id as integer),&#xd; cast(:fecha_hora as timestamp),&#xd; cast(:responsable as integer),&#xd; :username,&#xd; cast(:info_id as integer)&#xd; )</sql>
      <param name="herr_id" sqlType="STRING"/>
      <param name="fecha_hora" sqlType="STRING"/>
      <param name="responsable" sqlType="STRING"/>
      <param name="username" sqlType="STRING"/>
      <param name="info_id" sqlType="STRING"/>
   </query>
   <query id="getchecklist" useConfig="ToolsDataSource">
      <sql>SELECT&#xd;    c.*,&#xd;    COUNT(*) OVER() AS total_count&#xd;FROM&#xd;    (&#xd;        SELECT&#xd;            C.check_id,&#xd;            C.herr_id,&#xd;            H.codigo,&#xd;            H.descripcion AS herramienta,&#xd;            C.responsable,&#xd;            TRIM(COALESCE(U.first_name, '') || ' ' || COALESCE(U.last_name, '')) AS responsable_nombre,&#xd;            C.fecha_hora,&#xd;            C.fec_alta,&#xd;            C.username,&#xd;            C.info_id&#xd;        FROM&#xd;            pan.checklists C&#xd;            LEFT JOIN pan.herramientas H ON C.herr_id = H.herr_id&#xd;            LEFT JOIN seg.users U ON C.responsable = U.id&#xd;        WHERE&#xd;            H.empr_id = CAST(:empr_id AS INTEGER)&#xd;    ) c,&#xd;    (&#xd;        SELECT CAST(:search AS VARCHAR)    AS search,&#xd;               CAST(:order_dir AS VARCHAR) AS order_dir,&#xd;               CAST(:herr_id AS VARCHAR)   AS herr_id&#xd;    ) param&#xd;WHERE&#xd;    (&#xd;        param.search IS NULL&#xd;        OR param.search = ''&#xd;        OR UPPER(COALESCE(c.codigo, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(c.herramienta, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(c.responsable_nombre, '')) LIKE UPPER('%' || param.search || '%')&#xd;        OR UPPER(COALESCE(c.username, '')) LIKE UPPER('%' || param.search || '%')&#xd;    )&#xd;    AND (&#xd;        param.herr_id IS NULL&#xd;        OR param.herr_id = ''&#xd;        OR c.herr_id = CAST(param.herr_id AS INTEGER)&#xd;    )&#xd;ORDER BY&#xd;    CASE WHEN LOWER(param.order_dir) = 'asc'  THEN c.fec_alta END ASC,&#xd;    CASE WHEN LOWER(param.order_dir) = 'desc' THEN c.fec_alta END DESC&#xd;LIMIT CAST(:page_size AS INTEGER)&#xd;OFFSET CAST(:start AS INTEGER)</sql>
      <result outputType="json">{&#xd;       "checklists":{&#xd;           "checklist": [&#xd;               {&#xd;                 "check_id": "$check_id",&#xd;                 "herr_id": "$herr_id",&#xd;                 "codigo": "$codigo",&#xd;                 "herramienta": "$herramienta",&#xd;                 "responsable": "$responsable",&#xd;                 "responsable_nombre": "$responsable_nombre",&#xd;                 "fecha_hora": "$fecha_hora",&#xd;                 "fec_alta": "$fec_alta",&#xd;                 "username": "$username",&#xd;                 "info_id": "$info_id",&#xd;                 "total_count": "$total_count"&#xd;               }&#xd;             ]&#xd;      }&#xd;    }</result>
      <param name="empr_id" sqlType="STRING"/>
      <param name="search" sqlType="STRING"/>
      <param name="order_dir" sqlType="STRING"/>
      <param name="herr_id" sqlType="STRING"/>
      <param name="page_size" sqlType="STRING"/>
      <param name="start" sqlType="STRING"/>
   </query>
   <query id="deleteTipoHerramienta" useConfig="ToolsDataSource">
      <sql>delete from pan.tipos_herramienta where herr_id = CAST(:herr_id AS INTEGER)</sql>
      <param name="herr_id" sqlType="STRING"/>
   </query>
   <query id="getHerramientaxId" useConfig="ToolsDataSource">
      <sql>select H.herr_id, H.codigo, H.marca as marca_id, T.valor as marca, H.modelo, H.tipo, H.descripcion, H.pano_id, H.estado,  P.descripcion as pan_descrip&#xd;  from pan.herramientas H, core.tablas T, pan.panol P&#xd;  where H.herr_id  = cast (:herr_id as INTEGER)&#xd;  and H.marca = T.tabl_id&#xd;  and H.pano_id = P.pano_id&#xd;  and H.eliminado = false</sql>
      <result outputType="json"> {&#xd;  "herramientas":{&#xd;    "herramienta":[&#xd;      {&#xd;        "herr_id": "$herr_id",&#xd;        "codigo": "$codigo",&#xd;        "marca": "$marca",&#xd;        "marca_id": "$marca_id",&#xd;        "modelo": "$modelo",&#xd;        "tipo": "$tipo",&#xd;        "descripcion": "$descripcion",&#xd;        "pano_id": "$pano_id",&#xd;        "estado": "$estado",&#xd;        "pan_descrip": "$pan_descrip"&#xd;      }&#xd;    ]&#xd;  }&#xd;}</result>
      <param name="herr_id" sqlType="STRING"/>
   </query>
