<api xmlns="http://ws.apache.org/ns/synapse" name="toolsNTFAPI" context="/tools/ntf">
   <!-- ══════════════════════════════════════════════════════════════
        Avisos de Tools (ADR-015): la campanita y el push, por JWT.

        Es la puerta para quien llega con token por el APIM: los agentes
        (con su token de máquina, ADR-A10), Bonita y, cuando la tenga, la app
        móvil. El PHP de Tools llama directo a NTFDataService con la sesión,
        como el resto de los módulos.

        La empresa (emprIdFromHeader, ADR-009) y el usuario (usuarioFromHeader)
        salen SIEMPRE del X-JWT-Assertion que firma el APIM; nunca del cuerpo
        ni de la URL. Cada recurso delega en NTFDataService, que a su vez solo
        llama a funciones de ntf: la regla de negocio vive en un solo lugar.

          POST   /avisos                 publica (ntf.publicar)
          GET    /avisos/mios            la campanita del usuario del token
          GET    /avisos/no-leidos       el número de la campanita
          POST   /avisos/{aviso_id}/leido  marca leído uno propio
          POST   /avisos/leidos          marca leídos todos los propios
          POST   /dispositivos           registra el navegador/celular
          DELETE /dispositivos/{token}   lo da de baja
   -->

   <!-- POST /avisos — cuerpo:
        {"tipo":"stock_critico","titulo":"...","cuerpo":"...","origen":"alm",
         "destinatarios":["nick1","nick2"] | "nick1,nick2" | (vacío = suscriptos),
         "severidad":"info|aviso|critica","enlace":"...","entidad_tipo":"...",
         "entidad_id":"...","emisor":"Quirqui","dedupe_key":"..."}
        Devuelve {"respuesta":{"aviso_id":"N"}}; con la misma dedupe_key
        devuelve el aviso existente sin crear nada. -->
   <resource methods="POST" uri-template="/avisos">
      <inSequence>
         <sequence key="emprIdFromHeader"/>
         <sequence key="usuarioFromHeader"/>
         <property name="apiconf" expression="get-property('registry','conf:tools/apiconfig.xml')" scope="default" type="OM"/>
         <property name="dataservices_url" expression="$ctx:apiconf//dataservices_url"/>

         <!-- empr_id del JWT, pisando cualquiera que venga en el cuerpo. -->
         <script language="js"><![CDATA[
            var b = mc.getPayloadJSON() || {};
            function s(v) { return (v === null || v === undefined) ? "" : ("" + v); }
            var dest = b.destinatarios;
            if (dest && typeof dest === "object" && dest.length !== undefined) {
                var lista = [];
                for (var i = 0; i < dest.length; i++) { if (s(dest[i]).trim().length > 0) { lista.push(s(dest[i]).trim()); } }
                dest = lista.join(",");
            }
            var faltan = [];
            if (s(b.tipo).trim().length === 0)   { faltan.push("tipo"); }
            if (s(b.titulo).trim().length === 0) { faltan.push("titulo"); }
            mc.setProperty("ntf_faltan", faltan.join(","));
            mc.setPayloadJSON({"_post_aviso": {
                "empr_id":       s(mc.getProperty("jwt_empr_id")),
                "origen":        s(b.origen).length > 0 ? s(b.origen) : "api",
                "tipo":          s(b.tipo),
                "titulo":        s(b.titulo),
                "cuerpo":        s(b.cuerpo),
                "destinatarios": s(dest),
                "severidad":     s(b.severidad),
                "enlace":        s(b.enlace),
                "entidad_tipo":  s(b.entidad_tipo),
                "entidad_id":    s(b.entidad_id),
                "emisor":        s(b.emisor).length > 0 ? s(b.emisor) : s(mc.getProperty("jwt_usuario")),
                "dedupe_key":    s(b.dedupe_key)
            }});
         ]]></script>

         <filter xpath="string-length(get-property('ntf_faltan')) > 0">
            <then>
               <payloadFactory media-type="json">
                  <format>{"error":"campos_obligatorios","faltan":"$1"}</format>
                  <args><arg evaluator="xml" expression="get-property('ntf_faltan')"/></args>
               </payloadFactory>
               <property name="messageType" scope="axis2" type="STRING" value="application/json"/>
               <property name="HTTP_SC" scope="axis2" type="STRING" value="400"/>
               <respond/>
            </then>
         </filter>

         <log level="custom" category="DEBUG">
            <property name="text"    value="#TRAZA | NTF | toolsNTFAPI | POST /avisos"/>
            <property name="empr_id" expression="get-property('jwt_empr_id')"/>
            <property name="usuario" expression="get-property('jwt_usuario')"/>
         </log>

         <header name="Accept" scope="transport" value="application/json"/>
         <property name="messageType" value="application/json" scope="axis2"/>
         <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>
         <property name="uri.var.ntf_url" expression="fn:concat($ctx:dataservices_url,'/NTFDataService/aviso')"/>
         <call>
            <endpoint><http method="POST" uri-template="{uri.var.ntf_url}"/></endpoint>
         </call>
         <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
            <then>
               <property name="HTTP_SC" value="200" scope="axis2" type="INTEGER"/>
               <respond/>
            </then>
            <else>
               <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
               <property name="TOOLS_ERROR" value="POST /ntf/avisos - NTFDataService error" type="STRING"/>
               <sequence key="toolsFault"/>
            </else>
         </filter>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en POST /ntf/avisos (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

   <!-- GET /avisos/mios — los avisos del usuario del token, no leídos primero. -->
   <resource methods="GET" uri-template="/avisos/mios">
      <inSequence>
         <sequence key="emprIdFromHeader"/>
         <sequence key="usuarioFromHeader"/>
         <property name="apiconf" expression="get-property('registry','conf:tools/apiconfig.xml')" scope="default" type="OM"/>
         <property name="dataservices_url" expression="$ctx:apiconf//dataservices_url"/>
         <property name="uri.var.ntf_url"
                   expression="fn:concat($ctx:dataservices_url,'/NTFDataService/avisos/emprid/',get-property('jwt_empr_id'),'/nick/',get-property('jwt_usuario_url'))"/>
         <header name="Accept" scope="transport" value="application/json"/>
         <property name="messageType" scope="axis2" action="remove"/>
         <property name="ContentType" scope="axis2" action="remove"/>
         <header name="Content-Type" scope="transport" action="remove"/>
         <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>
         <call>
            <endpoint><http method="GET" uri-template="{uri.var.ntf_url}"/></endpoint>
         </call>
         <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
            <then><respond/></then>
            <else>
               <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
               <property name="TOOLS_ERROR" value="GET /ntf/avisos/mios - NTFDataService error" type="STRING"/>
               <sequence key="toolsFault"/>
            </else>
         </filter>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en GET /ntf/avisos/mios (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

   <!-- GET /avisos/no-leidos — el número de la campanita. -->
   <resource methods="GET" uri-template="/avisos/no-leidos">
      <inSequence>
         <sequence key="emprIdFromHeader"/>
         <sequence key="usuarioFromHeader"/>
         <property name="apiconf" expression="get-property('registry','conf:tools/apiconfig.xml')" scope="default" type="OM"/>
         <property name="dataservices_url" expression="$ctx:apiconf//dataservices_url"/>
         <property name="uri.var.ntf_url"
                   expression="fn:concat($ctx:dataservices_url,'/NTFDataService/avisos/noleidos/emprid/',get-property('jwt_empr_id'),'/nick/',get-property('jwt_usuario_url'))"/>
         <header name="Accept" scope="transport" value="application/json"/>
         <property name="messageType" scope="axis2" action="remove"/>
         <property name="ContentType" scope="axis2" action="remove"/>
         <header name="Content-Type" scope="transport" action="remove"/>
         <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>
         <call>
            <endpoint><http method="GET" uri-template="{uri.var.ntf_url}"/></endpoint>
         </call>
         <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
            <then><respond/></then>
            <else>
               <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
               <property name="TOOLS_ERROR" value="GET /ntf/avisos/no-leidos - NTFDataService error" type="STRING"/>
               <sequence key="toolsFault"/>
            </else>
         </filter>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en GET /ntf/avisos/no-leidos (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

   <!-- POST /avisos/{aviso_id}/leido y POST /avisos/leidos — solo los propios:
        la función filtra por empresa y usuario del token. Devuelve
        {"respuesta":{"marcados":"N"}} (0 si el aviso no es del usuario). -->
   <resource methods="POST" uri-template="/avisos/{aviso_id}/leido">
      <inSequence>
         <property name="ntf_aviso_id" expression="get-property('uri.var.aviso_id')"/>
         <sequence key="ntfMarcarLeido"/>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en POST /ntf/avisos/{id}/leido (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>
   <resource methods="POST" uri-template="/avisos/leidos">
      <inSequence>
         <property name="ntf_aviso_id" value=""/>
         <sequence key="ntfMarcarLeido"/>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en POST /ntf/avisos/leidos (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

   <!-- POST /dispositivos — {"token":"<FCM>","plataforma":"web|android|ios"} -->
   <resource methods="POST" uri-template="/dispositivos">
      <inSequence>
         <property name="ntf_token" expression="json-eval($.token)"/>
         <property name="ntf_plataforma" expression="json-eval($.plataforma)"/>
         <property name="ntf_operacion" value="alta"/>
         <sequence key="ntfDispositivo"/>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en POST /ntf/dispositivos (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

   <!-- DELETE /dispositivos/{token} — solo el propio. -->
   <resource methods="DELETE" uri-template="/dispositivos/{token}">
      <inSequence>
         <property name="ntf_token" expression="get-property('uri.var.token')"/>
         <property name="ntf_plataforma" value=""/>
         <property name="ntf_operacion" value="baja"/>
         <sequence key="ntfDispositivo"/>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en DELETE /ntf/dispositivos (toolsNTFAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>
</api>
