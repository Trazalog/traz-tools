<?xml version="1.0" encoding="UTF-8"?>
<!-- MIG-EI65 · Final de POST /tools/man/plan/programar (toolsMANAPI): planificar la tarea de Bonita
     cuando el origen ya tiene caso, actualizar los estados y responder. Está aparte porque se llama
     desde dos lugares: al terminar de lanzar las órdenes (aggregate del iterate) y cuando no hay
     órdenes que lanzar. El EI 6.5 no deja llamar a Bonita dentro de un foreach. -->
<sequence name="manPlanProgramarFin" xmlns="http://ws.apache.org/ns/synapse">

         <filter source="get-property('man_error')" regex="OK"><then><filter source="get-property('man_caso')" regex="0"><then/><else><filter source="get-property('man_tipo')" regex="2"><then><property name="man_nombre" value="Solicitud"/></then><else><property name="man_nombre" value="Backlog"/></else></filter><property name="man_tarea_nombre" expression="fn:concat('Planificar%20', get-property('man_nombre'))"/><property name="man_recurso" expression="fn:concat('/API/bpm/humanTask?p=0&amp;c=20&amp;f=caseId%3D', get-property('man_caso'), '&amp;f=name%3D', get-property('man_tarea_nombre'))"/><call-template target="bpmAPICallTemplate"><with-param name="recurso" value="{$ctx:man_recurso}"/><with-param name="session" value="{$ctx:man_session}"/><with-param name="method" value="GET"/></call-template><property name="man_session" expression="json-eval($.session)"/><property name="man_tarea" expression="json-eval($.payload[0].id)"/><filter source="get-property('man_tarea')" regex="[0-9]+"><then><property name="man_recurso" expression="fn:concat('/API/identity/user?p=0&amp;c=1&amp;f=userName%3D', get-property('man_nick'))"/><call-template target="bpmAPICallTemplate"><with-param name="recurso" value="{$ctx:man_recurso}"/><with-param name="session" value="{$ctx:man_session}"/><with-param name="method" value="GET"/></call-template><property name="man_session" expression="json-eval($.session)"/><property name="man_uid" expression="json-eval($.payload[0].id)"/><filter source="get-property('man_uid')" regex="[0-9]+"><then><property name="man_payload_bpm" expression="fn:concat('{&quot;assigned_id&quot;:&quot;', get-property('man_uid'), '&quot;}')"/><property name="man_recurso" expression="fn:concat('/API/bpm/humanTask/', get-property('man_tarea'))"/><call-template target="bpmAPICallTemplate"><with-param name="recurso" value="{$ctx:man_recurso}"/><with-param name="session" value="{$ctx:man_session}"/><with-param name="method" value="PUT"/><with-param name="payload" value="{$ctx:man_payload_bpm}"/></call-template><property name="man_session" expression="json-eval($.session)"/><property name="man_payload_bpm" expression="'{}'"/><property name="man_recurso" expression="fn:concat('/API/bpm/userTask/', get-property('man_tarea'), '/execution')"/><call-template target="bpmAPICallTemplate"><with-param name="recurso" value="{$ctx:man_recurso}"/><with-param name="session" value="{$ctx:man_session}"/><with-param name="method" value="POST"/><with-param name="payload" value="{$ctx:man_payload_bpm}"/></call-template><property name="man_session" expression="json-eval($.session)"/><filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]"><then/><else><property name="man_error" value="No se pudo cerrar la tarea de Bonita"/></else></filter></then><else><property name="man_error" value="El usuario no existe en Bonita"/></else></filter></then><else><filter source="get-property('man_tipo')" regex="2"><then><property name="man_error" value="La solicitud no esta lista para planificar en Bonita"/></then><else/></filter></else></filter></else></filter></then><else/></filter>
         <filter source="get-property('man_error')" regex="OK"><then><property name="NO_ENTITY_BODY" scope="axis2" action="remove"/><property name="messageType" value="application/json" scope="axis2"/><header name="Accept" scope="transport" value="application/json"/><property name="man_solic" expression="get-property('man_o_sore')"/><filter source="get-property('man_tipo')" regex="[24]"><then/><else><property name="man_solic" value="0"/></else></filter><payloadFactory media-type="json"><format>{"request_box":{"_put_plan_ots_caso":{"case_id":"$3","token":"$1","case_id2":"$3","id_empresa":"$2"},"_put_plan_ots_confirmar":{"token":"$1","id_empresa":"$2"},"_put_plan_estado_preventivo":{"estado":"PL","meses":"$4","fecha":"$5","meses2":"$4","id_origen":"$6","tipo":"$7","id_empresa":"$2"},"_put_plan_estado_predictivo":{"estado":"PL","id_origen":"$6","tipo":"$7","id_empresa":"$2"},"_put_plan_estado_backlog":{"estado":"PL","id_origen":"$6","tipo":"$7","id_empresa":"$2"},"_put_plan_estado_solicitud":{"estado":"PL","id_solicitud":"$8","id_solicitud2":"$8","id_empresa":"$2"}}}</format><args><arg evaluator="xml" expression="get-property('man_token')"/><arg evaluator="xml" expression="get-property('man_empresa')"/><arg evaluator="xml" expression="get-property('man_caso')"/><arg evaluator="xml" expression="get-property('man_meses')"/><arg evaluator="xml" expression="get-property('man_fecha')"/><arg evaluator="xml" expression="get-property('man_origen')"/><arg evaluator="xml" expression="get-property('man_tipo')"/><arg evaluator="xml" expression="get-property('man_solic')"/></args></payloadFactory><property name="uri.var.man_url" expression="fn:concat($ctx:dataservices_url, '/MANDataService/request_box')"/><call><endpoint><http method="POST" uri-template="{uri.var.man_url}"/></endpoint></call><filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]"><then/><else><property name="man_error" value="Se crearon las ordenes pero no se pudieron actualizar los estados"/></else></filter></then><else/></filter>
         <filter source="get-property('man_error')" regex="OK"><then><payloadFactory media-type="json"><format>{"status":true,"cuenta":"$1"}</format><args><arg evaluator="xml" expression="get-property('man_cuenta')"/></args></payloadFactory><property name="HTTP_SC" value="200" scope="axis2" type="STRING"/><respond/></then><else><filter source="get-property('man_creadas')" regex="si"><then><payloadFactory media-type="json"><format>{}</format>
         </payloadFactory><header name="Accept" scope="transport" value="application/json"/><property name="NO_ENTITY_BODY" value="true" scope="axis2" type="BOOLEAN"/><property name="messageType" scope="axis2" action="remove"/><property name="ContentType" scope="axis2" action="remove"/><header name="Content-Type" scope="transport" action="remove"/><property name="uri.var.man_url" expression="fn:concat($ctx:dataservices_url, '/MANDataService/plan/ots/token/', get-property('man_token'), '/empresa/', get-property('man_empresa'))"/><call><endpoint><http method="GET" uri-template="{uri.var.man_url}"/></endpoint></call><script language="js"><![CDATA[ var p = mc.getPayloadJSON(); var q = (p && p.ots && p.ots.ot) ? p.ots.ot : []; if (!(q instanceof Array)) { q = [q]; } mc.setProperty("man_cuenta2", String(q.length)); ]]></script><filter source="get-property('man_cuenta2')" regex="[1-9][0-9]*"><then><iterate expression="json-eval($.ots.ot)" sequential="true" continueParent="true"><target><sequence><property name="man_case" expression="json-eval($.case_id)"/><filter source="get-property('man_case')" regex="[1-9][0-9]*"><then><property name="NO_ENTITY_BODY" scope="axis2" action="remove"/><property name="messageType" value="application/json" scope="axis2"/><header name="Accept" scope="transport" value="application/json"/><payloadFactory media-type="json"><format>{"caseid":"$1","session":"$2"}</format><args><arg evaluator="xml" expression="get-property('man_case')"/><arg evaluator="xml" expression="get-property('man_session')"/></args></payloadFactory><property name="uri.var.man_url" expression="fn:concat($ctx:api_url, '/bpm/proceso/instancia')"/><call><endpoint><http method="DELETE" uri-template="{uri.var.man_url}"/></endpoint></call></then><else/></filter><drop/></sequence></target></iterate></then><else/></filter><property name="NO_ENTITY_BODY" scope="axis2" action="remove"/><property name="messageType" value="application/json" scope="axis2"/><header name="Accept" scope="transport" value="application/json"/><payloadFactory media-type="json"><format>{"request_box":{"_put_plan_ots_borrar_casos":{"token":"$1","id_empresa":"$2","id_empresa2":"$2"},"_put_plan_ots_borrar_herramientas":{"token":"$1","id_empresa":"$2"},"_put_plan_ots_borrar_insumos":{"token":"$1","id_empresa":"$2"},"_put_plan_ots_borrar_adjuntos":{"token":"$1","id_empresa":"$2"},"_put_plan_ots_borrar":{"token":"$1","id_empresa":"$2"}}}</format><args><arg evaluator="xml" expression="get-property('man_token')"/><arg evaluator="xml" expression="get-property('man_empresa')"/></args></payloadFactory><property name="uri.var.man_url" expression="fn:concat($ctx:dataservices_url, '/MANDataService/request_box')"/><call><endpoint><http method="POST" uri-template="{uri.var.man_url}"/></endpoint></call></then><else/></filter><payloadFactory media-type="json"><format>{"status":false,"msj":"$1"}</format><args><arg evaluator="xml" expression="get-property('man_error')"/></args></payloadFactory><property name="HTTP_SC" value="500" scope="axis2" type="STRING"/><respond/></else></filter>
      
</sequence>
