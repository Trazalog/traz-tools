   <!-- alm_crear_pedido_materiales — crea un pedido de materiales. Toda la
        orquestación (INSERT + BPM + rollback) vive en toolsALMAPI; acá solo
        se resuelve empr_id del JWT y se inyecta en el payload antes de
        delegar. El agente NUNCA manda empr_id — si lo manda, se ignora y
        se pisa con el del JWT. -->
   <resource methods="POST" uri-template="/mcp/alm/pedido">
      <inSequence>
         <sequence key="emprIdFromHeader"/>

         <property xmlns:ns2="http://org.apache.synapse/xsd" xmlns:ns="http://org.apache.synapse/xsd"
                   name="apiconf"
                   expression="get-property('registry','conf:tools/apiconfig.xml')"
                   scope="default" type="OM"/>
         <property xmlns:ns2="http://org.apache.synapse/xsd" xmlns:ns="http://org.apache.synapse/xsd"
                   name="api_url" expression="$ctx:apiconf//api_url"/>

         <!-- Inyectar empr_id del JWT en el body ANTES de delegar — nunca el
              que mande el agente. justificacion/ortr_id/articulos pasan tal
              cual vinieron del request. -->
         <!-- jwt_empr_id (PostgreSQL), no empr_id_mysql — ver nota en alm_get_stock -->
         <script language="js"><![CDATA[
            var body = mc.getPayloadJSON();
            body.empr_id = "" + mc.getProperty('jwt_empr_id');
            mc.setPayloadJSON(body);
         ]]></script>

         <log level="custom" category="DEBUG">
            <property name="text"    value="#TRAZA | MCP | alm_crear_pedido_materiales | iniciando (toolsMCPAPI -> toolsALMAPI)"/>
            <property name="empr_id" expression="get-property('jwt_empr_id')"/>
         </log>

         <header name="Accept" scope="transport" value="application/json"/>
         <property name="messageType" value="application/json" scope="axis2"/>
         <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>
         <property name="uri.var.almCrearPedido_url"
                   expression="fn:concat($ctx:api_url,'/alm/pedido')"/>

         <call>
            <endpoint>
               <http method="POST" uri-template="{uri.var.almCrearPedido_url}"/>
            </endpoint>
         </call>

         <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
            <then>
               <respond/>
            </then>
            <else>
               <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
               <property name="TOOLS_ERROR" value="POST /mcp/alm/pedido - toolsALMAPI error" type="STRING"/>
               <sequence key="toolsFault"/>
            </else>
         </filter>
      </inSequence>
      <faultSequence>
         <property name="ERROR_MESSAGE" expression="json-eval($)" type="STRING"/>
         <property name="TOOLS_ERROR" value="Error en MCP alm_crear_pedido_materiales (toolsMCPAPI)" type="STRING"/>
         <sequence key="toolsFault"/>
      </faultSequence>
   </resource>

