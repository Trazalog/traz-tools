   <!-- ══════════════════════════════════════════════════════════════
        E2-MCP-13 (ADR-013): tools de Almacenes. A diferencia de mantenimiento
        (que replica la lógica de toolsMANAPI inline), estas 4 tools son
        FACHADA DELGADA de verdad: solo resuelven empr_id del JWT y delegan
        toda la orquestación a toolsALMAPI (nueva, ver artifacts/apis/
        toolsALMAPI.xml) — que recibe empr_id como parámetro explícito, no
        derivado de un header. Decisión de Rodolfo: así toolsALMAPI queda
        reusable a futuro por el PHP de v2 (que hoy hace esta orquestación
        a mano, sin rollback), no solo por el MCP.
   ══════════════════════════════════════════════════════════════ -->

   <!-- alm_get_stock — lista de artículos con stock agregado de la empresa. -->
   <resource methods="GET" uri-template="/mcp/alm/stock">
      <inSequence>
         <sequence key="emprIdFromHeader"/>

         <property xmlns:ns2="http://org.apache.synapse/xsd" xmlns:ns="http://org.apache.synapse/xsd"
                   name="apiconf"
                   expression="get-property('registry','conf:tools/apiconfig.xml')"
                   scope="default" type="OM"/>
         <property xmlns:ns2="http://org.apache.synapse/xsd" xmlns:ns="http://org.apache.synapse/xsd"
                   name="api_url" expression="$ctx:apiconf//api_url"/>

         <!-- usa jwt_empr_id (id de PostgreSQL) — NUNCA el empr_id_mysql de assetv2.
              ALMDataService corre sobre ToolsDataSource (PostgreSQL) y filtra por
              alm.alm_lotes.empr_id, que es el id de core.empresas (ADR-012). -->
         <property name="uri.var.almStock_url"
                   expression="fn:concat($ctx:api_url,'/alm/stock/',get-property('jwt_empr_id'))"/>

         <log level="custom" category="DEBUG">
            <property name="text"    value="#TRAZA | MCP | alm_get_stock | iniciando (toolsMCPAPI -> toolsALMAPI)"/>
            <property name="empr_id" expression="get-property('jwt_empr_id')"/>
         </log>

         <header name="Accept" scope="transport" value="application/json"/>
         <property name="messageType" scope="axis2" action="remove"/>
         <property name="ContentType" scope="axis2" action="remove"/>
         <header name="Content-Type" scope="transport" action="remove"/>
         <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>

         <call>
            <endpoint>
