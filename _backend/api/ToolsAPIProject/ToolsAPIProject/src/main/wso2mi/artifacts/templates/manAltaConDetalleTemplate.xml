<?xml version="1.0" encoding="UTF-8"?>
<!-- MIG-ASSET-2 · Alta encadenada de MAN: cabecera + herramientas + insumos (ADR-014, regla 3).
     La usan los recursos POST /man/preventivo, /man/predictivo y /man/backlog de toolsMANAPI.

     Entrada (payload): {"cabecera":{...params de POST /<entidad> de MANDataService, con id_empresa...},
                         "herramientas":[{"herrId","cantidad"}], "insumos":[{"artId","cantidad"}]}
     Pasos: 1) POST /<entidad> devuelve el id nuevo ({"alta":{"id":N}}; vacío si el equipo no es de la empresa).
            2) Lote de herramientas y 3) lote de insumos, cada uno en una transacción (_batch_req), con el id agregado
               a cada elemento. 4) Si 2 o 3 fallan, compensa con un request_box que borra detalle y cabecera.
     Salida: {"status":true,"id":"N"} o, si falla, HTTP 500 con {"status":false,"msj":...}. No usa toolsFault:
     termina en <send/> y, llamado desde el flujo de entrada, reenvía el mensaje en vez de responder.
     Solo mediadores nativos (regla 4). -->
<template name="manAltaConDetalleTemplate" xmlns="http://ws.apache.org/ns/synapse">
   <parameter name="entidad"/>
   <parameter name="pk"/>
   <sequence>
      <property name="apiconf" expression="get-property('registry','conf:tools/apiconfig.xml')" scope="default" type="OM"
                xmlns:ns="http://org.apache.synapse/xsd"/>
      <property name="dataservices_url" expression="$ctx:apiconf//dataservices_url" xmlns:ns="http://org.apache.synapse/xsd"/>
      <property name="mv_entidad" expression="$func:entidad"/>
      <property name="mv_pk" expression="$func:pk"/>
      <property name="mv_cabecera" expression="json-eval($.cabecera)"/>
      <property name="mv_herramientas" expression="json-eval($.herramientas)"/>
      <property name="mv_insumos" expression="json-eval($.insumos)"/>
      <property name="mv_id_empresa" expression="json-eval($.cabecera.id_empresa)"/>
      <property name="man_entidad" expression="$func:entidad"/>
      <property name="messageType" value="application/json" scope="axis2"/>
      <header name="Accept" scope="transport" value="application/json"/>
      <property name="FORCE_ERROR_ON_SOAP_FAULT" value="true" scope="default" type="STRING"/>

      <!-- 1) Cabecera -->
      <payloadFactory media-type="json">
         <format>{"_post_$1": $2}</format>
         <args>
            <arg evaluator="xml" expression="$ctx:mv_entidad"/>
            <arg evaluator="xml" expression="$ctx:mv_cabecera"/>
         </args>
      </payloadFactory>
      <property name="uri.var.ds_url" expression="concat($ctx:dataservices_url, '/MANDataService/', $ctx:man_entidad)"/>
      <call>
         <endpoint>
            <http method="POST" uri-template="{uri.var.ds_url}"/>
         </endpoint>
      </call>
      <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
         <then/>
         <else>
            <property name="mv_msj" value="MAN alta con detalle - falló la cabecera"/>
            <payloadFactory media-type="json">
               <format>{"status":false,"msj":"$1"}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_msj"/>
               </args>
            </payloadFactory>
            <property name="HTTP_SC" value="500" scope="axis2" type="STRING"/>
            <respond/>
         </else>
      </filter>
      <property name="mv_id" expression="json-eval($.alta.id)"/>
      <property name="man_id" expression="json-eval($.alta.id)"/>
      <filter source="get-property('man_id')" regex="[0-9]+">
         <then/>
         <else>
            <property name="mv_msj" value="MAN alta con detalle - la cabecera no se creó"/>
            <payloadFactory media-type="json">
               <format>{"status":false,"msj":"$1"}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_msj"/>
               </args>
            </payloadFactory>
            <property name="HTTP_SC" value="500" scope="axis2" type="STRING"/>
            <respond/>
         </else>
      </filter>
      <property name="man_falla" value="no"/>

      <!-- 2) Herramientas -->
      <filter xpath="string-length($ctx:mv_herramientas) &gt; 2">
         <then>
            <payloadFactory media-type="json">
               <format>{"lista": $1}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_herramientas"/>
               </args>
            </payloadFactory>
            <script language="js"><![CDATA[
               function v(x) { return (x === undefined || x === null) ? "" : String(x); }
               var p = mc.getPayloadJSON(); var l = p.lista || []; var r = [];
               for (var i = 0; i < l.length; i++) { var it = l[i]; var o = {}; o[v(mc.getProperty("mv_pk"))] = v(mc.getProperty("mv_id")); o["herrId"] = v(it.herrId); o["cantidad"] = v(it.cantidad); o["id_empresa"] = v(mc.getProperty("mv_id_empresa")); r.push(o); }
               p.lista = r; mc.setPayloadJSON(p);
            ]]></script>
            <payloadFactory media-type="json">
               <format>{"_post_$1_herramienta_batch_req":{"_post_$2_herramienta": $3}}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                  <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                  <arg evaluator="json" expression="$.lista"/>
               </args>
            </payloadFactory>
            <property name="uri.var.ds_url" expression="concat($ctx:dataservices_url, '/MANDataService/', $ctx:man_entidad, '/herramienta_batch_req')"/>
            <call>
               <endpoint>
                  <http method="POST" uri-template="{uri.var.ds_url}"/>
               </endpoint>
            </call>
            <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
               <then/>
               <else>
                  <property name="man_falla" value="herramientas"/>
               </else>
            </filter>
         </then>
         <else/>
      </filter>

      <!-- 3) Insumos -->
      <filter source="get-property('man_falla')" regex="no">
         <then>
            <filter xpath="string-length($ctx:mv_insumos) &gt; 2">
               <then>
                  <payloadFactory media-type="json">
                     <format>{"lista": $1}</format>
                     <args>
                        <arg evaluator="xml" expression="$ctx:mv_insumos"/>
                     </args>
                  </payloadFactory>
                  <script language="js"><![CDATA[
                     function v(x) { return (x === undefined || x === null) ? "" : String(x); }
                     var p = mc.getPayloadJSON(); var l = p.lista || []; var r = [];
                     for (var i = 0; i < l.length; i++) { var it = l[i]; var o = {}; o[v(mc.getProperty("mv_pk"))] = v(mc.getProperty("mv_id")); o["artId"] = v(it.artId); o["cantidad"] = v(it.cantidad); o["id_empresa"] = v(mc.getProperty("mv_id_empresa")); r.push(o); }
                     p.lista = r; mc.setPayloadJSON(p);
                  ]]></script>
                  <payloadFactory media-type="json">
                     <format>{"_post_$1_insumo_batch_req":{"_post_$2_insumo": $3}}</format>
                     <args>
                        <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                        <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                        <arg evaluator="json" expression="$.lista"/>
                     </args>
                  </payloadFactory>
                  <property name="uri.var.ds_url" expression="concat($ctx:dataservices_url, '/MANDataService/', $ctx:man_entidad, '/insumo_batch_req')"/>
                  <call>
                     <endpoint>
                        <http method="POST" uri-template="{uri.var.ds_url}"/>
                     </endpoint>
                  </call>
                  <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
                     <then/>
                     <else>
                        <property name="man_falla" value="insumos"/>
                     </else>
                  </filter>
               </then>
               <else/>
            </filter>
         </then>
         <else/>
      </filter>

      <!-- 4) Compensación: si falló un lote, se borra lo creado -->
      <filter source="get-property('man_falla')" regex="no">
         <then/>
         <else>
            <payloadFactory media-type="json">
               <format>{"request_box":{"_put_$1_herramientas_borrar":{"$2":"$3","id_empresa":"$4"},"_put_$5_insumos_borrar":{"$6":"$7","id_empresa":"$8"},"_put_$9_borrar":{"$10":"$11","id_empresa":"$12"}}}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                  <arg evaluator="xml" expression="$ctx:mv_pk"/>
                  <arg evaluator="xml" expression="$ctx:mv_id"/>
                  <arg evaluator="xml" expression="$ctx:mv_id_empresa"/>
                  <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                  <arg evaluator="xml" expression="$ctx:mv_pk"/>
                  <arg evaluator="xml" expression="$ctx:mv_id"/>
                  <arg evaluator="xml" expression="$ctx:mv_id_empresa"/>
                  <arg evaluator="xml" expression="$ctx:mv_entidad"/>
                  <arg evaluator="xml" expression="$ctx:mv_pk"/>
                  <arg evaluator="xml" expression="$ctx:mv_id"/>
                  <arg evaluator="xml" expression="$ctx:mv_id_empresa"/>
               </args>
            </payloadFactory>
            <property name="uri.var.ds_url" expression="concat($ctx:dataservices_url, '/MANDataService/request_box')"/>
            <call>
               <endpoint>
                  <http method="POST" uri-template="{uri.var.ds_url}"/>
               </endpoint>
            </call>
            <property name="mv_msj" value="MAN alta con detalle - falló un lote de detalle; se borró la cabecera"/>
            <filter source="get-property('axis2', 'HTTP_SC')" regex="2[0-9][0-9]">
               <then/>
               <else>
                  <!-- La compensación falló: queda una cabecera sin detalle completo que hay que borrar a mano. -->
                  <log category="ERROR" level="custom">
                     <property name="text" value="#TRAZA | toolsMANAPI | manAltaConDetalle | falló la compensación"/>
                     <property name="entidad" expression="$ctx:man_entidad"/>
                     <property name="id" expression="$ctx:man_id"/>
                  </log>
                  <property name="mv_msj" value="MAN alta con detalle - falló un lote de detalle y también la compensación; quedó una cabecera incompleta (ver log)"/>
               </else>
            </filter>
            <payloadFactory media-type="json">
               <format>{"status":false,"msj":"$1"}</format>
               <args>
                  <arg evaluator="xml" expression="$ctx:mv_msj"/>
               </args>
            </payloadFactory>
            <property name="HTTP_SC" value="500" scope="axis2" type="STRING"/>
            <respond/>
         </else>
      </filter>

      <payloadFactory media-type="json">
         <format>{"status":true,"id":"$1"}</format>
         <args>
            <arg evaluator="xml" expression="$ctx:mv_id"/>
         </args>
      </payloadFactory>
      <property name="HTTP_SC" value="200" scope="axis2" type="STRING"/>
   </sequence>
</template>
