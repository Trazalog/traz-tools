<data name="BandejaDataService" transports="http https local">
   <description>Bandeja de entrada con paginado y busqueda en la base. Resuelve en una sola query las tareas pendientes de un usuario en Bonita (misma logica que API/bpm/humanTask?f=user_id=X: asignadas a el + candidatas por actor mapping), filtradas por empresa via core.case_empresa y por texto de busqueda, ordenadas, con total y cantidad filtrada. Lee la BD de Bonita en solo lectura por el servidor dblink "bonita_bpm" (ver _backend/database/scripts/versiones/bandeja_bonita_dblink.sql). Ver doc/v3/bandeja-paginado-real.md.&#xd;                                </description>
   <config enableOData="false" id="ToolsDataSource">
      <property name="carbon_datasource_name">ToolsDataSource</property>
   </config>
   <query id="getBandejaTareas" useConfig="ToolsDataSource">
      <sql>SELECT bandeja.* FROM (&#xd;WITH p AS (&#xd;  SELECT CAST(:user_id AS bigint) AS uid,&#xd;         CAST(:empr_id AS integer) AS empr,&#xd;         COALESCE(CAST(:buscar AS varchar), '') AS buscar,&#xd;         CAST(:limit AS integer) AS lim,&#xd;         CAST(:offset AS integer) AS desde,&#xd;         CAST(:procesos AS json) AS procesos&#xd;),&#xd;t AS (&#xd;  SELECT x.*&#xd;  FROM p, dblink('bonita_bpm', replace('&#xd;    WITH mis_actores AS (&#xd;      SELECT am.actorid FROM actormember am&#xd;      WHERE am.tenantid = 1 AND am.userid = @uid@&#xd;      UNION&#xd;      SELECT am.actorid FROM actormember am&#xd;      JOIN user_membership um ON um.tenantid = am.tenantid AND um.userid = @uid@&#xd;       AND ( (am.groupid = um.groupid AND am.roleid = -1)&#xd;          OR (am.roleid = um.roleid AND am.groupid = -1)&#xd;          OR (am.groupid = um.groupid AND am.roleid = um.roleid))&#xd;      WHERE am.tenantid = 1&#xd;    )&#xd;    SELECT fi.id, fi.logicalgroup2, fi.logicalgroup1, fi.name, fi.displayname, fi.statename,&#xd;           fi.assigneeid, fi.claimeddate, fi.reachedstatedate, fi.expectedenddate, fi.priority&#xd;    FROM flownode_instance fi&#xd;    WHERE fi.tenantid = 1 AND fi.kind IN (''user'',''manual'')&#xd;      AND fi.stable AND NOT fi.terminal AND NOT fi.state_executing&#xd;      AND fi.statecategory = ''NORMAL''&#xd;      AND ( fi.assigneeid = @uid@&#xd;         OR (fi.assigneeid = 0 AND EXISTS (&#xd;              SELECT 1 FROM pending_mapping pm&#xd;              WHERE pm.tenantid = 1 AND pm.activityid = fi.id&#xd;                AND (pm.userid = @uid@ OR pm.actorid IN (SELECT actorid FROM mis_actores)))))&#xd;  ',&#xd;    '@uid@', CAST(p.uid AS varchar)))&#xd;    AS x(task_id bigint, case_id bigint, process_id bigint, name varchar, display_name varchar, state varchar,&#xd;         assigned_id bigint, claimed_date bigint, reached_state_date bigint, due_date bigint, priority smallint)&#xd;  WHERE CAST(x.case_id AS varchar) IN (&#xd;    SELECT CAST(ce.case_id AS varchar) FROM core.case_empresa ce WHERE ce.empr_id = (SELECT empr FROM p))&#xd;),&#xd;tm AS (&#xd;  SELECT t.task_id, t.case_id, t.display_name, t.name,&#xd;         COALESCE(p.value -&gt;&gt; 'model', 'Gentareas') AS model,&#xd;         COALESCE(p.value -&gt;&gt; 'nombre', '') AS nombre_proceso,&#xd;         COALESCE(CAST(p.value -&gt;&gt; 'tst' AS boolean), false) AS es_tst,&#xd;         CAST(t.case_id AS varchar) AS case_txt&#xd;  FROM t&#xd;  LEFT JOIN json_each((SELECT procesos FROM p)) p ON p.key = CAST(t.process_id AS varchar)&#xd;),&#xd;tx AS (&#xd;  SELECT tm.task_id,&#xd;    translate(&#xd;      CASE WHEN tm.es_tst THEN COALESCE(tst.nombre, '') ELSE COALESCE(tm.display_name, tm.name, '') END&#xd;      || ' ' || CASE WHEN tm.es_tst THEN 'Tarea Planificada' ELSE tm.nombre_proceso END&#xd;      || ' ' || tm.case_txt&#xd;      || ' ' || CASE tm.model&#xd;           WHEN 'Yudiproctareas' THEN COALESCE(pt.descripcion, 'Sin Descripción')&#xd;           WHEN 'Proceso_tareas' THEN COALESCE(pt.descripcion, 'Sin Descripción')&#xd;           WHEN 'Sicpoatareas'   THEN COALESCE(pt.descripcion, 'Sin Descripción')&#xd;           WHEN 'Almtareas' THEN CASE WHEN alm.pema_id IS NOT NULL&#xd;                                      THEN COALESCE(NULLIF(alm.justificacion, ''), 'Pedido Materiales sin Justificación')&#xd;                                      ELSE 'Sin Descripción' END&#xd;           WHEN 'Tsttareas' THEN COALESCE(tst.descripcion, 'Sin Descripción')&#xd;           WHEN 'Pedidocontenedores' THEN COALESCE(soc.observaciones, 'Sin Descripción')&#xd;           WHEN 'Retirocontenedores' THEN ''&#xd;           WHEN 'Entregaordentransportes' THEN 'Ingreso de contenedores a PTA'&#xd;           ELSE 'Te falto definir el modelo para la tarea pa' END&#xd;      || ' ' || CASE WHEN tm.model = 'Sicpoatareas' THEN 'oculto' ELSE '' END&#xd;      || CASE tm.model&#xd;           WHEN 'Yudiproctareas' THEN ' N° Orden:  ' || COALESCE(CAST(pt.petr_id AS varchar), '')&#xd;                || ' N° Codigo:  ' || COALESCE(pt.cod_proyecto, '')&#xd;                || ' Objetivo:  ' || COALESCE(CAST(pt.objetivo AS varchar), '') || '   ' || COALESCE(pt.unidad_medida, '')&#xd;                || ' Estado: ' || COALESCE(pt.estado, '') || ' '&#xd;                || ' Fecha Inicio: ' || COALESCE(to_char(pt.fec_inicio, 'YYYY/MM/DD'), '')&#xd;                || ' Fecha Entrega: ' || COALESCE(to_char(pt.fec_entrega, 'YYYY/MM/DD'), '')&#xd;           WHEN 'Proceso_tareas' THEN ' N° Orden:  ' || COALESCE(CAST(pt.petr_id AS varchar), '')&#xd;                || ' N° Codigo:  ' || COALESCE(pt.cod_proyecto, '')&#xd;                || ' Objetivo:  ' || COALESCE(CAST(pt.objetivo AS varchar), '') || '   ' || COALESCE(pt.unidad_medida, '')&#xd;                || ' Estado: ' || COALESCE(pt.estado, '') || ' '&#xd;                || ' Fecha Inicio: ' || COALESCE(to_char(pt.fec_inicio, 'YYYY/MM/DD'), '')&#xd;                || ' Fecha Entrega: ' || COALESCE(to_char(pt.fec_entrega, 'YYYY/MM/DD'), '')&#xd;           WHEN 'Sicpoatareas' THEN ' Estado: ' || COALESCE(pt.estado, '') || ' '&#xd;                || ' Fecha Inicio: ' || COALESCE(to_char(pt.fec_inicio, 'YYYY/MM/DD'), '')&#xd;                || ' Dominio: ' || COALESCE(pat.valor, '')&#xd;           WHEN 'Almtareas' THEN CASE WHEN alm.pema_id IS NOT NULL&#xd;                THEN ' N° Pedido: ' || alm.pema_id || ' Lote: ' || COALESCE(alm.lote_id, '')&#xd;                  || ' Estado: ' || COALESCE(alm.estado, '') || ' Fecha: ' || COALESCE(to_char(alm.fecha, 'DD/MM/YYYY'), '')&#xd;                ELSE ' N° Pedido: ' || COALESCE(CAST(np.pema_id AS varchar), '') || ' Estado: ' || COALESCE(np.estado, '')&#xd;                  || ' Fecha: ' || COALESCE(to_char(np.fecha, 'DD/MM/YYYY'), '') || ' '&#xd;                  || ' Justificacion: ' || COALESCE(np.justificacion, '') END&#xd;           WHEN 'Tsttareas' THEN ' Estado: ' || COALESCE(tst.estado, '')&#xd;                || CASE tst.origen&#xd;                     WHEN 'PETR' THEN ' Origen: Pedido de trabajo Id Ped.Trabajo: ' || COALESCE(CAST(tst.orta_id AS varchar), '') || ' '&#xd;                     WHEN 'BATCH' THEN ' Origen: Producción de Lotes Batch:  ' || COALESCE(CAST(tst.orta_id AS varchar), '') || ' ' || COALESCE(lot.lote_id, '')&#xd;                     WHEN 'ETAP' THEN ' Origen: Etapas  '&#xd;                     ELSE ' Origen: ' || COALESCE(tst.origen, '') || ' ID: ' || COALESCE(CAST(tst.orta_id AS varchar), '') || ' Nro de Pedido: ' END&#xd;                || ' Asignado: ' || COALESCE(tst.user_id, '')&#xd;                || ' Fecha: ' || COALESCE(to_char(tst.fecha, 'DD/MM/YYYY'), '')&#xd;           WHEN 'Pedidocontenedores' THEN ' Estado: ' || COALESCE(soc.estado, '')&#xd;                || ' Fecha Solic.: ' || COALESCE(to_char(soc.fec_alta, 'DD-MM-YYYY'), '')&#xd;                || ' Solicitante: ' || COALESCE(soc.razon_social, '')&#xd;           WHEN 'Retirocontenedores' THEN ' Fecha: ' || COALESCE(&#xd;                   to_char(sre.fec_local, 'YYYY-MM-DD"T"HH24') || ':' || to_char(sre.fec_local, 'MI') || ':'&#xd;                   || to_char(sre.fec_local, 'SS.MS') || '-03' || ':' || '00', '')&#xd;                || ' Ord. pedido: ' || COALESCE(CAST(sre.sore_id AS varchar), '')&#xd;                || ' Solicitante: ' || COALESCE(gen.razon_social, '')&#xd;           WHEN 'Entregaordentransportes' THEN ' Estado: ' || COALESCE(ot.estado, '')&#xd;                || ' Ord. Transporte: ' || COALESCE(CAST(ot.ortr_id AS varchar), '')&#xd;                || ' Dominio: ' || COALESCE(NULLIF(ot.dominiopesado, ''), ot.dominio, '')&#xd;                || ' Sector de Descarga: ' || COALESCE(dep.descripcion, '')&#xd;           ELSE '' END,&#xd;      'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz') AS texto&#xd;  FROM tm&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT pe.objetivo, pe.cod_proyecto, pe.descripcion, pe.fec_inicio, pe.fec_entrega, pe.info_id,&#xd;           t1.valor AS unidad_medida, t2.descripcion AS estado, pe.petr_id, count(*) OVER () AS n&#xd;    FROM pro.pedidos_trabajo pe, core.tablas t1, core.tablas t2, core.tablas t3&#xd;    WHERE tm.model IN ('Yudiproctareas', 'Proceso_tareas', 'Sicpoatareas')&#xd;      AND pe.case_id = tm.case_txt AND pe.umti_id = t1.tabl_id AND pe.estado = t2.tabl_id&#xd;      AND pe.tipt_id = t3.tabl_id AND pe.eliminado != true&#xd;    LIMIT 1) pt ON tm.model IN ('Yudiproctareas', 'Proceso_tareas', 'Sicpoatareas') AND pt.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT i.valor FROM frm.instancias_formularios i&#xd;    WHERE tm.model = 'Sicpoatareas' AND pt.info_id IS NOT NULL&#xd;      AND i.info_id = pt.info_id AND i.eliminado = false AND i.name = 'dominio'&#xd;      AND EXISTS (SELECT 1 FROM frm.instancias_formularios a JOIN frm.formularios c ON c.form_id = a.form_id&#xd;                  WHERE a.info_id = pt.info_id AND a.eliminado = false)&#xd;    ORDER BY i.orden DESC LIMIT 1) pat ON tm.model = 'Sicpoatareas'&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT CAST(pm.pema_id AS varchar) AS pema_id, pm.fecha, pm.justificacion, pm.estado,&#xd;           CAST(lo.lote_id AS varchar) AS lote_id, count(*) OVER () AS n&#xd;    FROM alm.alm_pedidos_materiales pm JOIN prd.lotes lo ON lo.batch_id = pm.batch_id&#xd;    WHERE tm.model = 'Almtareas' AND pm.case_id = CAST(tm.case_id AS integer)&#xd;    LIMIT 1) alm ON tm.model = 'Almtareas' AND alm.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT apm.pema_id, apm.estado, apm.fecha, apm.justificacion&#xd;    FROM alm.alm_pedidos_materiales apm&#xd;    WHERE tm.model = 'Almtareas' AND apm.case_id = CAST(tm.case_id AS integer)&#xd;    LIMIT 1) np ON tm.model = 'Almtareas'&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT tp.nombre, tp.descripcion, tp.estado, tp.user_id, tp.fecha, otp.origen, otp.orta_id&#xd;    FROM tst.tareas_planificadas tp JOIN tst.origen_tarea_planficada otp ON otp.tapl_id = tp.tapl_id&#xd;    WHERE tm.model = 'Tsttareas' AND tp.case_id = tm.case_txt&#xd;    LIMIT 1) tst ON tm.model = 'Tsttareas'&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT CAST(lote.lote_id AS varchar) AS lote_id, count(*) OVER () AS n&#xd;    FROM prd.etapas etap, prd.establecimientos esta, prd.recipientes reci, prd.lotes lote, alm.alm_depositos depo&#xd;    WHERE lote.etap_id = etap.etap_id AND lote.reci_id = reci.reci_id AND reci.depo_id = depo.depo_id&#xd;      AND depo.esta_id = esta.esta_id AND tst.origen = 'BATCH' AND lote.batch_id = tst.orta_id&#xd;    LIMIT 1) lot ON tst.origen = 'BATCH' AND lot.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT sc.estado, sc.observaciones, sc.fec_alta, st.razon_social&#xd;    FROM log.solicitudes_contenedor sc, log.solicitantes_transporte st, log.contenedores_solicitados cs&#xd;    WHERE tm.model = 'Pedidocontenedores' AND sc.sotr_id = st.sotr_id AND sc.soco_id = cs.soco_id AND sc.case_id = tm.case_txt AND sc.eliminado = 0&#xd;    LIMIT 1) soc ON tm.model = 'Pedidocontenedores'&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT sr.sore_id, (sr.fec_alta AT TIME ZONE 'UTC') AT TIME ZONE 'America/Argentina/Buenos_Aires' AS fec_local,&#xd;           count(*) OVER () AS n&#xd;    FROM log.solicitudes_retiro sr WHERE tm.model = 'Retirocontenedores' AND sr.case_id = tm.case_txt&#xd;    LIMIT 1) sre ON tm.model = 'Retirocontenedores' AND sre.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT st.razon_social, count(*) OVER () AS n&#xd;    FROM log.solicitantes_transporte st, core.tablas ttipo, core.departamentos depa, core.zonas zona, core.tablas trub&#xd;    WHERE tm.model = 'Retirocontenedores' AND st.sotr_id = (SELECT sr.sotr_id FROM log.solicitudes_retiro sr WHERE sr.case_id = tm.case_txt)&#xd;      AND st.tist_id = ttipo.tabl_id AND st.depa_id = depa.depa_id AND st.zona_id = zona.zona_id AND st.rubr_id = trub.tabl_id&#xd;    LIMIT 1) gen ON tm.model = 'Retirocontenedores' AND gen.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT ot1.ortr_id, ot1.estado, e.dominio, CAST(NULL AS varchar) AS dominiopesado, count(*) OVER () AS n&#xd;    FROM log.ordenes_transporte ot1, core.equipos e, log.choferes ch&#xd;    WHERE tm.model = 'Entregaordentransportes' AND COALESCE(tm.display_name, tm.name) != 'Certifica Vuelco'&#xd;      AND ot1.case_id = tm.case_txt AND ot1.equi_id = e.equi_id AND ot1.chof_id = ch.documento&#xd;    UNION ALL&#xd;    SELECT * FROM (&#xd;      SELECT ot2.ortr_id, ot2.estado, e1.dominio, e2.dominio AS dominiopesado, 1 AS n&#xd;      FROM log.ordenes_transporte ot2&#xd;      JOIN core.equipos e1 ON e1.equi_id = ot2.equi_id&#xd;      JOIN log.choferes ch2 ON ch2.documento = ot2.chof_id&#xd;      LEFT JOIN log.contenedores_entregados ce2 ON ce2.ortr_id = ot2.ortr_id&#xd;      LEFT JOIN core.equipos e2 ON e2.equi_id = ce2.equi_id_pesado&#xd;      WHERE tm.model = 'Entregaordentransportes' AND COALESCE(tm.display_name, tm.name) = 'Certifica Vuelco'&#xd;        AND ot2.case_id = tm.case_txt&#xd;      LIMIT 1) v&#xd;    LIMIT 1) ot ON tm.model = 'Entregaordentransportes' AND ot.n = 1&#xd;  LEFT JOIN LATERAL (&#xd;    SELECT de.descripcion, count(*) OVER () AS n&#xd;    FROM log.contenedores_entregados ce, alm.alm_depositos de&#xd;    WHERE tm.model = 'Entregaordentransportes' AND ot.ortr_id IS NOT NULL AND ce.ortr_id = ot.ortr_id AND de.depo_id = ce.depo_id AND ce.tiva_id IS NULL AND ce.fec_descarga IS NULL&#xd;    LIMIT 1) dep ON tm.model = 'Entregaordentransportes' AND dep.n = 1&#xd;),&#xd;f AS (&#xd;  SELECT t.* FROM t&#xd;  WHERE (SELECT buscar FROM p) = ''&#xd;     OR t.task_id IN (SELECT tx.task_id FROM tx WHERE strpos(tx.texto, (SELECT buscar FROM p)) &gt; 0)&#xd;)&#xd;SELECT&#xd;  f.task_id AS id,&#xd;  f.case_id,&#xd;  f.process_id,&#xd;  f.name,&#xd;  COALESCE(f.display_name, f.name) AS display_name,&#xd;  f.state,&#xd;  CASE WHEN f.assigned_id = 0 THEN '' ELSE CAST(f.assigned_id AS varchar) END AS assigned_id,&#xd;  CASE WHEN f.assigned_id = 0 OR f.claimed_date IS NULL OR f.claimed_date = 0 THEN ''&#xd;       ELSE to_char(to_timestamp(f.claimed_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'YYYY-MM-DD HH24') || ':'&#xd;            || to_char(to_timestamp(f.claimed_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'MI') || ':'&#xd;            || to_char(to_timestamp(f.claimed_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'SS.MS') END AS assigned_date,&#xd;  CASE WHEN f.due_date IS NULL OR f.due_date = 0 THEN ''&#xd;       ELSE to_char(to_timestamp(f.due_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'YYYY-MM-DD HH24') || ':'&#xd;            || to_char(to_timestamp(f.due_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'MI') || ':'&#xd;            || to_char(to_timestamp(f.due_date / 1000.0) AT TIME ZONE 'America/Argentina/Buenos_Aires', 'SS.MS') END AS due_date,&#xd;  CASE f.priority WHEN 0 THEN 'lowest' WHEN 1 THEN 'under_normal' WHEN 3 THEN 'above_normal' WHEN 4 THEN 'highest' ELSE 'normal' END AS priority,&#xd;  (SELECT count(*) FROM t) AS total,&#xd;  count(*) OVER () AS filtered,&#xd;  row_number() OVER (ORDER BY f.reached_state_date DESC, f.task_id DESC) AS fila&#xd;FROM f&#xd;ORDER BY f.reached_state_date DESC, f.task_id DESC&#xd;LIMIT (SELECT CASE WHEN lim &gt; 0 THEN lim END FROM p)&#xd;OFFSET (SELECT desde FROM p)&#xd;) bandeja&#xd;ORDER BY bandeja.fila</sql>
      <result outputType="json">{  "tareas": {    "tarea": [      {        "id": "$id",        "caseId": "$case_id",        "processId": "$process_id",        "name": "$name",        "displayName": "$display_name",        "state": "$state",        "assigned_id": "$assigned_id",        "assigned_date": "$assigned_date",        "dueDate": "$due_date",        "priority": "$priority",        "total": "$total",        "filtered": "$filtered"      }    ]  }}</result>
      <param name="user_id" sqlType="STRING"/>
      <param name="empr_id" sqlType="STRING"/>
      <param name="limit" sqlType="STRING"/>
      <param name="offset" sqlType="STRING"/>
      <param name="buscar" sqlType="STRING"/>
      <param name="procesos" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/bandeja/tareas/usuario/{user_id}/empresa/{empr_id}/offset/{offset}/limit/{limit}">
      <call-query href="getBandejaTareas">
         <with-param name="user_id" query-param="user_id"/>
         <with-param name="empr_id" query-param="empr_id"/>
         <with-param name="offset" query-param="offset"/>
         <with-param name="limit" query-param="limit"/>
         <with-param name="buscar" query-param="buscar"/>
         <with-param name="procesos" query-param="procesos"/>
      </call-query>
   </resource>
</data>
