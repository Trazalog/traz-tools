   <!-- MIG-ASSET-2 · Preventivo, Predictivo y Backlog (ABM con herramientas e insumos). Reemplaza el acceso directo de
        models/Preventivos.php, Predictivos.php y Backlogs.php (ADR-014). Toda query queda limitada a la empresa (id de asset).
        Las inserciones de detalle no tienen resultado para que el DataService habilite el pedido por lotes (_batch_req):
        request_box no admite repetir una operación. El alta encadenada (cabecera + detalle) es un recurso de toolsMANAPI. -->
   <query id="getUnidadesTiempoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_unidad, unidaddescrip FROM unidad_tiempo</sql>
      <result outputType="json">{"unidades":{"unidad":[{"id_unidad":"$id_unidad","unidaddescrip":"$unidaddescrip"}]}}</result>
   </query>
   <query id="getTareasActivasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_tarea AS value, descripcion AS label FROM tareas WHERE id_empresa = :id_empresa AND estado = 'AC' AND (IFNULL(:patron, '') = '' OR LOWER(descripcion) LIKE CONCAT('%', LOWER(:patron), '%')) ORDER BY label ASC</sql>
      <result outputType="json">{"tareas":{"tarea":[{"value":"$value","label":"$label"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="patron" sqlType="STRING"/>
   </query>
   <query id="getTareasEmpresaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_tarea, descripcion, estado, id_empresa, form_asoc, visible FROM tareas WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"tareas":{"tarea":[{"id_tarea":"$id_tarea","descripcion":"$descripcion","estado":"$estado","id_empresa":"$id_empresa","form_asoc":"$form_asoc","visible":"$visible"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquiposNoInMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.descripcion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, CAST(e.fecha_baja AS CHAR) AS fecha_baja, CAST(e.fecha_garantia AS CHAR) AS fecha_garantia, e.marca, e.codigo, e.ubicacion, e.id_empresa, e.id_sector, CAST(e.id_hubicacion AS CHAR) AS id_hubicacion, e.id_grupo, e.id_customer, e.id_criticidad, e.estado, CAST(e.fecha_ultimalectura AS CHAR) AS fecha_ultimalectura, CAST(e.ultima_lectura AS CHAR) AS ultima_lectura, e.tipo_horas, CAST(e.`id-centrodecosto` AS CHAR) AS idcentrodecosto, CAST(e.valor_reposicion AS CHAR) AS valor_reposicion, CAST(e.fecha_reposicion AS CHAR) AS fecha_reposicion, CAST(e.id_proveedor AS CHAR) AS id_proveedor, CAST(e.valor AS CHAR) AS valor, e.comprobante, e.descrip_tecnica, e.id_unidad, e.id_area, e.id_proceso, e.numero_serie, e.adjunto, e.meta_disponibilidad FROM equipos e WHERE e.estado != 'IN' AND e.id_empresa = :id_empresa ORDER BY e.id_equipo</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","descripcion":"$descripcion","fecha_ingreso":"$fecha_ingreso","fecha_baja":"$fecha_baja","fecha_garantia":"$fecha_garantia","marca":"$marca","codigo":"$codigo","ubicacion":"$ubicacion","id_empresa":"$id_empresa","id_sector":"$id_sector","id_hubicacion":"$id_hubicacion","id_grupo":"$id_grupo","id_customer":"$id_customer","id_criticidad":"$id_criticidad","estado":"$estado","fecha_ultimalectura":"$fecha_ultimalectura","ultima_lectura":"$ultima_lectura","tipo_horas":"$tipo_horas","id-centrodecosto":"$idcentrodecosto","valor_reposicion":"$valor_reposicion","fecha_reposicion":"$fecha_reposicion","id_proveedor":"$id_proveedor","valor":"$valor","comprobante":"$comprobante","descrip_tecnica":"$descrip_tecnica","id_unidad":"$id_unidad","id_area":"$id_area","id_proceso":"$id_proceso","numero_serie":"$numero_serie","adjunto":"$adjunto","meta_disponibilidad":"$meta_disponibilidad"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquipoMarcaLeftMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.descripcion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, CAST(e.fecha_baja AS CHAR) AS fecha_baja, CAST(e.fecha_garantia AS CHAR) AS fecha_garantia, e.marca, e.codigo, e.ubicacion, e.id_empresa, e.id_sector, CAST(e.id_hubicacion AS CHAR) AS id_hubicacion, e.id_grupo, e.id_customer, e.id_criticidad, e.estado, CAST(e.fecha_ultimalectura AS CHAR) AS fecha_ultimalectura, CAST(e.ultima_lectura AS CHAR) AS ultima_lectura, e.tipo_horas, CAST(e.`id-centrodecosto` AS CHAR) AS idcentrodecosto, CAST(e.valor_reposicion AS CHAR) AS valor_reposicion, CAST(e.fecha_reposicion AS CHAR) AS fecha_reposicion, CAST(e.id_proveedor AS CHAR) AS id_proveedor, CAST(e.valor AS CHAR) AS valor, e.comprobante, e.descrip_tecnica, e.id_unidad, e.id_area, e.id_proceso, e.numero_serie, e.adjunto, e.meta_disponibilidad, m.marcaid, m.marcadescrip, m.estado AS marca_estado, m.id_empresa AS marca_empresa FROM equipos e LEFT JOIN marcasequipos m ON e.marca = m.marcaid WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","descripcion":"$descripcion","fecha_ingreso":"$fecha_ingreso","fecha_baja":"$fecha_baja","fecha_garantia":"$fecha_garantia","marca":"$marca","codigo":"$codigo","ubicacion":"$ubicacion","id_empresa":"$id_empresa","id_sector":"$id_sector","id_hubicacion":"$id_hubicacion","id_grupo":"$id_grupo","id_customer":"$id_customer","id_criticidad":"$id_criticidad","estado":"$estado","fecha_ultimalectura":"$fecha_ultimalectura","ultima_lectura":"$ultima_lectura","tipo_horas":"$tipo_horas","id-centrodecosto":"$idcentrodecosto","valor_reposicion":"$valor_reposicion","fecha_reposicion":"$fecha_reposicion","id_proveedor":"$id_proveedor","valor":"$valor","comprobante":"$comprobante","descrip_tecnica":"$descrip_tecnica","id_unidad":"$id_unidad","id_area":"$id_area","id_proceso":"$id_proceso","numero_serie":"$numero_serie","adjunto":"$adjunto","meta_disponibilidad":"$meta_disponibilidad","marcaid":"$marcaid","marcadescrip":"$marcadescrip","marca_estado":"$marca_estado","marca_empresa":"$marca_empresa"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
