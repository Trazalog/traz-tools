         <with-param name="id_empresa" query-param="id_empresa"/>
      </call-query>
   </resource>
   <resource method="GET" path="/mcp/ot/{id_empresa}/{id_solicitud}">
      <call-query href="getSolicitudServicioById">
         <with-param name="id_empresa"   query-param="id_empresa"/>
         <with-param name="id_solicitud" query-param="id_solicitud"/>
      </call-query>
   </resource>
   <resource method="GET" path="/mcp/ots/{id_empresa}">
      <call-query href="getOTsByEmpresa">
         <with-param name="id_empresa" query-param="id_empresa"/>
         <with-param name="estado"     query-param="estado"/>
      </call-query>
   </resource>
   <resource method="GET" path="mcp/lecturas/{id_empresa}">
      <call-query href="getLecturasResumenMcp">
         <with-param name="id_empresa" query-param="id_empresa"/>
      </call-query>
   </resource>
   <resource method="GET" path="mcp/preventivos/{id_empresa}">
      <call-query href="getPreventivosMcp">
         <with-param name="id_empresa" query-param="id_empresa"/>
      </call-query>
   </resource>
   <query id="getEquipoIsolated" useConfig="AssetPlannerDataSource">
      <sql>select e.id_equipo,e.codigo,e.descripcion,e.estado, e2.id_empresa empr_id,e2.descripcion empresa,m.marcadescrip marca, s.descripcion sector,g.descripcion grupo,c.descripcion criticidad,a.descripcion area,p.descripcion proceso&#xd;from equipos e &#xd;join empresas e2 on e2.id_empresa = e.id_empresa &#xd;left join marcasequipos m on m.marcaid = e.marca &#xd;left join sector s on s.id_sector = e.id_sector &#xd;left join grupo g on g.id_grupo =e.id_grupo&#xd;left join criticidad c on c.id_criti = e.id_criticidad &#xd;left join area a on a.id_area = e.id_area &#xd;left join proceso p on p.id_proceso = e.id_proceso &#xd;where e.id_equipo = :equi_id&#xd;AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{&#xd;   "equipo":{&#xd;      "id_equipo":"$id_equipo",&#xd;      "codigo":"$codigo",&#xd;      "descripcion":"$descripcion",&#xd;      "estado":"$estado",&#xd;      "empr_id":"$empr_id",&#xd;      "empresa":"$empresa",&#xd;      "marca":"$marca",&#xd;      "sector":"$sector",&#xd;      "grupo":"$grupo",&#xd;      "criticidad":"$criticidad",&#xd;      "area":"$area",&#xd;      "proceso":"$proceso"&#xd;   }&#xd;}&#xd;</result>
      <param name="equi_id" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getLecturasResumenMcp" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.codigo AS equipo, e.descripcion AS equipo_descripcion,&#xd;       e.estado AS equipo_estado, COALESCE(c.descripcion,'') AS criticidad,&#xd;       COUNT(h.id_lectura) AS cantidad_lecturas,&#xd;       MAX(h.lectura) AS lectura_actual,&#xd;       DATE_FORMAT(MAX(h.fecha),'%Y-%m-%d') AS fecha_ultima_lectura,&#xd;       DATEDIFF(CURDATE(), MAX(h.fecha)) AS dias_sin_lectura&#xd;FROM equipos e&#xd;LEFT JOIN historial_lecturas h ON h.id_equipo = e.id_equipo&#xd;LEFT JOIN criticidad c ON c.id_criti = e.id_criticidad&#xd;WHERE e.id_empresa = cast(:id_empresa as signed integer)&#xd;AND e.estado != 'AN'&#xd;GROUP BY e.id_equipo, e.codigo, e.descripcion, e.estado, c.descripcion&#xd;ORDER BY dias_sin_lectura DESC, e.codigo</sql>
      <result outputType="json">{&#xd;    "lecturas": {&#xd;        "equipo": [&#xd;            {&#xd;                "id_equipo": "$id_equipo",&#xd;                "equipo": "$equipo",&#xd;                "equipo_descripcion": "$equipo_descripcion",&#xd;                "equipo_estado": "$equipo_estado",&#xd;                "criticidad": "$criticidad",&#xd;                "cantidad_lecturas": "$cantidad_lecturas",&#xd;                "lectura_actual": "$lectura_actual",&#xd;                "fecha_ultima_lectura": "$fecha_ultima_lectura",&#xd;                "dias_sin_lectura": "$dias_sin_lectura"&#xd;            }&#xd;        ]&#xd;    }&#xd;}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOTsByEmpresa" useConfig="AssetPlannerDataSource">
      <sql>SELECT sr.id_solicitud, sr.numero, sr.id_tipo, sr.solicitante, sr.id_equipo,&#xd;       sr.correctivo, sr.causa, sr.observaciones, sr.estado, sr.usrId, sr.id_empresa,&#xd;       sr.urgente, DATE_FORMAT(sr.f_solicitado,'%Y-%m-%d %H:%i:%s') AS f_solicitado,&#xd;       e.codigo AS equipo, s.descripcion AS sector, g.descripcion AS grupo,&#xd;       e.ubicacion AS ubicacion, sr.case_id, ot.id_usuario_a,&#xd;       u.usrName AS mantenedor,&#xd;       DATE_FORMAT(ot.fecha_terminada,'%Y-%m-%d %H:%i:%s') AS fecha_terminada,&#xd;       DATE_FORMAT(ot.fecha_inicio,'%Y-%m-%d %H:%i:%s') AS f_inicio,&#xd;       DATE_FORMAT(ot.f_asignacion,'%Y-%m-%d %H:%i:%s') AS f_asignacion&#xd;FROM solicitud_reparacion sr&#xd;LEFT JOIN equipos e ON sr.id_equipo = e.id_equipo&#xd;LEFT JOIN sector s ON e.id_sector = s.id_sector&#xd;LEFT JOIN grupo g ON e.id_grupo = g.id_grupo&#xd;LEFT JOIN orden_trabajo ot ON ot.case_id = sr.case_id AND ot.id_orden = (SELECT MAX(ot2.id_orden) FROM orden_trabajo ot2 WHERE ot2.case_id = sr.case_id)&#xd;LEFT JOIN sisusers u ON ot.id_usuario_a = u.usrId&#xd;WHERE sr.estado != 'AN'&#xd;AND sr.id_empresa = cast(:id_empresa as signed integer)&#xd;AND (COALESCE(:estado,'') = '' OR sr.estado = :estado)&#xd;ORDER BY sr.id_solicitud DESC</sql>
      <result outputType="json">{&#xd;    "solicitudes": {&#xd;        "solicitud": [&#xd;            {&#xd;                "id_solicitud": "$id_solicitud",&#xd;                "numero": "$numero",&#xd;                "id_tipo": "$id_tipo",&#xd;                "solicitante": "$solicitante",&#xd;                "id_equipo": "$id_equipo",&#xd;                "correctivo": "$correctivo",&#xd;                "causa": "$causa",&#xd;                "observaciones": "$observaciones",&#xd;                "estado": "$estado",&#xd;                "usrId": "$usrId",&#xd;                "id_empresa": "$id_empresa",&#xd;                "urgente": "$urgente",&#xd;                "equipo": "$equipo",&#xd;                "sector": "$sector",&#xd;                "grupo": "$grupo",&#xd;                "ubicacion": "$ubicacion",&#xd;                "case_id": "$case_id",&#xd;                "id_usuario_a": "$id_usuario_a",&#xd;                "mantenedor": "$mantenedor",&#xd;                "fecha_terminada": "$fecha_terminada",&#xd;                "f_inicio": "$f_inicio",&#xd;                "f_asignacion": "$f_asignacion",&#xd;                "f_solicitado": "$f_solicitado"&#xd;            }&#xd;        ]&#xd;    }&#xd;}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="estado"     sqlType="STRING" optional="true" defaultValue=""/>
   </query>
   <query id="getPreventivosMcp" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.prevId, p.id_equipo, e.codigo AS equipo, e.descripcion AS equipo_descripcion,&#xd;       e.estado AS equipo_estado, c.descripcion AS criticidad,&#xd;       COALESCE(t.descripcion,'') AS tarea, COALESCE(pe.descripcion,'') AS periodicidad,&#xd;       p.cantidad AS intervalo, DATE_FORMAT(p.ultimo,'%Y-%m-%d') AS ultima_ejecucion,&#xd;       p.estadoprev, p.critico1 AS umbral_alerta, p.lectura_base, p.prev_duracion AS duracion_estimada,&#xd;       (SELECT MAX(h.lectura) FROM historial_lecturas h WHERE h.id_equipo = e.id_equipo) AS lectura_actual,&#xd;       (SELECT DATE_FORMAT(MAX(h2.fecha),'%Y-%m-%d') FROM historial_lecturas h2 WHERE h2.id_equipo = e.id_equipo) AS fecha_ultima_lectura&#xd;FROM preventivo p&#xd;JOIN equipos e ON e.id_equipo = p.id_equipo AND e.id_empresa = p.id_empresa&#xd;LEFT JOIN tareas t ON t.id_tarea = p.id_tarea&#xd;LEFT JOIN periodo pe ON pe.idperiodo = p.perido&#xd;LEFT JOIN criticidad c ON c.id_criti = e.id_criticidad&#xd;WHERE p.id_empresa = cast(:id_empresa as signed integer)&#xd;AND e.estado != 'AN'&#xd;AND p.estadoprev != 'AN'&#xd;ORDER BY e.codigo, p.prevId</sql>
      <result outputType="json">{&#xd;    "preventivos": {&#xd;        "preventivo": [&#xd;            {&#xd;                "prevId": "$prevId",&#xd;                "id_equipo": "$id_equipo",&#xd;                "equipo": "$equipo",&#xd;                "equipo_descripcion": "$equipo_descripcion",&#xd;                "equipo_estado": "$equipo_estado",&#xd;                "criticidad": "$criticidad",&#xd;                "tarea": "$tarea",&#xd;                "periodicidad": "$periodicidad",&#xd;                "intervalo": "$intervalo",&#xd;                "ultima_ejecucion": "$ultima_ejecucion",&#xd;                "estadoprev": "$estadoprev",&#xd;                "umbral_alerta": "$umbral_alerta",&#xd;                "lectura_base": "$lectura_base",&#xd;                "lectura_actual": "$lectura_actual",&#xd;                "fecha_ultima_lectura": "$fecha_ultima_lectura",&#xd;                "duracion_estimada": "$duracion_estimada"&#xd;            }&#xd;        ]&#xd;    }&#xd;}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getSolicitudServicioById" useConfig="AssetPlannerDataSource">
      <sql>select solicitud_reparacion.id_solicitud as id_solicitud,&#xd;	solicitud_reparacion.numero as numero,&#xd;	solicitud_reparacion.id_tipo as id_tipo,&#xd;	solicitud_reparacion.solicitante as solicitante,&#xd;	solicitud_reparacion.id_equipo as id_equipo,&#xd;	solicitud_reparacion.correctivo as correctivo,&#xd;	solicitud_reparacion.causa as causa,&#xd;        solicitud_reparacion.observaciones as observaciones,&#xd;	solicitud_reparacion.estado as estado,&#xd;	solicitud_reparacion.usrId as usrId,&#xd;        solicitud_reparacion.id_empresa as id_empresa,&#xd;	solicitud_reparacion.urgente as urgente,&#xd;        DATE_FORMAT(solicitud_reparacion.f_solicitado , '%Y-%m-%d %H:%i:%s') AS f_solicitado,&#xd;        equipos.codigo AS equipo,&#xd;        sector.descripcion AS sector,&#xd;        grupo.descripcion AS grupo,&#xd;        equipos.ubicacion as ubicacion,&#xd;        solicitud_reparacion.case_id as case_id,&#xd;        orden_trabajo.id_usuario_a as id_usuario_a,&#xd;        sisusers.usrName AS mantenedor,&#xd;        DATE_FORMAT(orden_trabajo.fecha_terminada, '%Y-%m-%d %H:%i:%s') AS fecha_terminada,&#xd;        DATE_FORMAT(orden_trabajo.fecha_inicio, '%Y-%m-%d %H:%i:%s') AS f_inicio,&#xd;        DATE_FORMAT(orden_trabajo.f_asignacion, '%Y-%m-%d %H:%i:%s') AS f_asignacion&#xd;from solicitud_reparacion&#xd;LEFT JOIN equipos ON solicitud_reparacion.id_equipo = equipos.id_equipo&#xd;LEFT JOIN sector ON equipos.id_sector = sector.id_sector&#xd;LEFT JOIN grupo ON equipos.id_grupo = grupo.id_grupo&#xd;LEFT JOIN orden_trabajo ON orden_trabajo.case_id = solicitud_reparacion.case_id AND orden_trabajo.id_orden = (SELECT MAX(ot2.id_orden) FROM orden_trabajo ot2 WHERE ot2.case_id = solicitud_reparacion.case_id)&#xd;LEFT JOIN sisusers ON orden_trabajo.id_usuario_a = sisusers.usrId&#xd;WHERE solicitud_reparacion.id_empresa = cast(:id_empresa as integer)&#xd;AND solicitud_reparacion.id_solicitud = cast(:id_solicitud as integer)</sql>
      <result outputType="json">{&#xd;    "solicitudes": {&#xd;        "solicitud": [&#xd;            {&#xd;                "id_solicitud": "$id_solicitud",&#xd;                "numero": "$numero",&#xd;                "id_tipo":"$id_tipo",&#xd;                "solicitante":"$solicitante",&#xd;                "id_equipo":"$id_equipo",&#xd;                "correctivo":"$correctivo",&#xd;                "causa":"$causa",&#xd;                "observaciones":"$observaciones",&#xd;                "estado":"$estado",&#xd;                "usrId":"$usrId",&#xd;                "id_empresa" :"$id_empresa",&#xd;                "urgente":"$urgente",&#xd;                "equipo":"$equipo",&#xd;                "sector":"$sector",&#xd;                "grupo":"$grupo",&#xd;                "ubicacion":"$ubicacion",&#xd;                "case_id":"$case_id",&#xd;                "id_usuario_a":"$id_usuario_a",&#xd;                "mantenedor":"$mantenedor",&#xd;                "fecha_terminada":"$fecha_terminada",&#xd;                "f_inicio":"$f_inicio",&#xd;                "f_asignacion":"$f_asignacion",&#xd;                "f_solicitado":"$f_solicitado"&#xd;            }&#xd;        ]&#xd;    }&#xd;}</result>
      <param name="id_empresa"   sqlType="STRING"/>
      <param name="id_solicitud" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/ots/sin-cerrar/usuario/{usrId}/empresa/{id_empresa}">
      <call-query href="otsSinCerrarPorUsuario"><with-param name="usrId" query-param="usrId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/ot/vale" returnRequestStatus="true">
      <call-query href="setOtVale"><with-param name="otId" query-param="otId"/><with-param name="sapa_id" query-param="sapa_id"/><with-param name="origen" query-param="origen"/><with-param name="usrId" query-param="usrId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/ot/herramienta-usada" returnRequestStatus="true">
      <call-query href="setOtHerramientaUsada"><with-param name="otId" query-param="otId"/><with-param name="herrId" query-param="herrId"/><with-param name="sapa_id" query-param="sapa_id"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-1 · Área (ABM). Reemplaza el acceso directo de models/Areas.php (ADR-014). Toda query filtra por id_empresa (id de asset). -->
   <query id="getAreasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_area, descripcion, id_empresa, estado FROM area WHERE estado = 'AC' AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"areas":{"area":[{"id_area":"$id_area","descripcion":"$descripcion","id_empresa":"$id_empresa","estado":"$estado"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getAreaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_area, descripcion, id_empresa, estado FROM area WHERE id_area = :id_area AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"areas":{"area":[{"id_area":"$id_area","descripcion":"$descripcion","id_empresa":"$id_empresa","estado":"$estado"}]}}</result>
      <param name="id_area" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setAreaMan" keyColumns="id_area" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO area (descripcion, id_empresa, estado) VALUES (:descripcion, :id_empresa, 'AC')</sql>
      <result outputType="json">{"area":{"id_area":"$GENERATED_KEY"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateAreaMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE area SET descripcion = :descripcion WHERE id_area = :id_area AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"area":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_area" sqlType="STRING"/>
      <param name="descripcion" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="bajaAreaMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE area SET estado = 'AN' WHERE id_area = :id_area AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"area":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_area" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/areas/empresa/{id_empresa}">
      <call-query href="getAreasMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/area/{id_area}/empresa/{id_empresa}">
      <call-query href="getAreaMan"><with-param name="id_area" query-param="id_area"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/area">
      <call-query href="setAreaMan"><with-param name="descripcion" query-param="descripcion"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/area">
      <call-query href="updateAreaMan"><with-param name="id_area" query-param="id_area"/><with-param name="descripcion" query-param="descripcion"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/area/baja">
      <call-query href="bajaAreaMan"><with-param name="id_area" query-param="id_area"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-1 · Proceso (ABM). Reemplaza el acceso directo de models/Procesos.php (ADR-014). Toda query filtra por id_empresa (id de asset). -->
   <query id="getProcesosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_proceso, descripcion, id_empresa, estado FROM proceso WHERE estado = 'AC' AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"procesos":{"proceso":[{"id_proceso":"$id_proceso","descripcion":"$descripcion","id_empresa":"$id_empresa","estado":"$estado"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getProcesoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_proceso, descripcion, id_empresa, estado FROM proceso WHERE id_proceso = :id_proceso AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"procesos":{"proceso":[{"id_proceso":"$id_proceso","descripcion":"$descripcion","id_empresa":"$id_empresa","estado":"$estado"}]}}</result>
      <param name="id_proceso" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setProcesoMan" keyColumns="id_proceso" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO proceso (descripcion, id_empresa, estado) VALUES (:descripcion, :id_empresa, 'AC')</sql>
      <result outputType="json">{"proceso":{"id_proceso":"$GENERATED_KEY"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateProcesoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE proceso SET descripcion = :descripcion WHERE id_proceso = :id_proceso AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"proceso":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_proceso" sqlType="STRING"/>
      <param name="descripcion" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="bajaProcesoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE proceso SET estado = 'AN' WHERE id_proceso = :id_proceso AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"proceso":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_proceso" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/procesos/empresa/{id_empresa}">
      <call-query href="getProcesosMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/proceso/{id_proceso}/empresa/{id_empresa}">
      <call-query href="getProcesoMan"><with-param name="id_proceso" query-param="id_proceso"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/proceso">
      <call-query href="setProcesoMan"><with-param name="descripcion" query-param="descripcion"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/proceso">
      <call-query href="updateProcesoMan"><with-param name="id_proceso" query-param="id_proceso"/><with-param name="descripcion" query-param="descripcion"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/proceso/baja">
      <call-query href="bajaProcesoMan"><with-param name="id_proceso" query-param="id_proceso"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-1 · Parámetros de equipo (setupparam). Reemplaza el acceso directo de models/Parametros.php (ADR-014).
        Toda query filtra por la empresa del equipo (id de asset). maximo/minimo salen como CHAR para que el texto
        sea el mismo que devolvía mysqli (10 y no 10.0). -->
   <query id="getEquiposParamMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_equipo, codigo FROM equipos WHERE estado = 'AC' AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","codigo":"$codigo"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getSetupParamsEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT s.id_equipo, s.id_parametro, CAST(s.maximo AS CHAR) AS maximo, CAST(s.minimo AS CHAR) AS minimo, p.paramdescrip, e.descripcion FROM setupparam s JOIN parametros p ON p.paramId = s.id_parametro JOIN equipos e ON e.id_equipo = s.id_equipo WHERE e.id_equipo = :id_equipo AND e.estado = 'AC' AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"parametros":{"parametro":[{"id_equipo":"$id_equipo","id_parametro":"$id_parametro","maximo":"$maximo","minimo":"$minimo","paramdescrip":"$paramdescrip","descripcion":"$descripcion"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getSetupParamMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT s.id_equipo, s.id_parametro, CAST(s.maximo AS CHAR) AS maximo, CAST(s.minimo AS CHAR) AS minimo, e.codigo, p.paramdescrip FROM setupparam s JOIN parametros p ON p.paramId = s.id_parametro JOIN equipos e ON e.id_equipo = s.id_equipo WHERE s.id_equipo = :id_equipo AND s.id_parametro = :id_parametro AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"parametros":{"parametro":[{"id_equipo":"$id_equipo","id_parametro":"$id_parametro","maximo":"$maximo","minimo":"$minimo","codigo":"$codigo","paramdescrip":"$paramdescrip"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_parametro" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateSetupParamMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE setupparam s JOIN equipos e ON e.id_equipo = s.id_equipo SET s.maximo = :maximo, s.minimo = :minimo WHERE s.id_equipo = :id_equipo AND s.id_parametro = :id_parametro AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"setupparam":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="maximo" sqlType="STRING"/>
      <param name="minimo" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_parametro" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="deleteSetupParamMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE s FROM setupparam s JOIN equipos e ON e.id_equipo = s.id_equipo WHERE s.id_equipo = :id_equipo AND s.id_parametro = :id_parametro AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"setupparam":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_parametro" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setSetupParamMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO setupparam (id_equipo, id_parametro, maximo, minimo, id_empresa) SELECT e.id_equipo, :id_parametro, :maximo, :minimo, e.id_empresa FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"setupparam":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_parametro" sqlType="STRING"/>
      <param name="maximo" sqlType="STRING"/>
      <param name="minimo" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setParametroMan" keyColumns="paramId" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO parametros (paramdescrip, id_empresa, estado) VALUES (:paramdescrip, :id_empresa, 'AC')</sql>
      <result outputType="json">{"parametro":{"paramId":"$GENERATED_KEY"}}</result>
      <param name="paramdescrip" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getParametrosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT paramId, paramdescrip, min, estado, id_empresa FROM parametros WHERE id_empresa = :id_empresa AND estado != 'AN'</sql>
      <result outputType="json">{"parametros":{"parametro":[{"paramId":"$paramId","paramdescrip":"$paramdescrip","min":"$min","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/parametros/equipos/empresa/{id_empresa}">
      <call-query href="getEquiposParamMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/parametros/equipo/{id_equipo}/empresa/{id_empresa}">
      <call-query href="getSetupParamsEquipoMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/parametros/equipo/{id_equipo}/parametro/{id_parametro}/empresa/{id_empresa}">
      <call-query href="getSetupParamMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_parametro" query-param="id_parametro"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/parametros/equipo">
      <call-query href="updateSetupParamMan"><with-param name="maximo" query-param="maximo"/><with-param name="minimo" query-param="minimo"/><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_parametro" query-param="id_parametro"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/parametros/equipo/baja">
      <call-query href="deleteSetupParamMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_parametro" query-param="id_parametro"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/parametros/equipo">
      <call-query href="setSetupParamMan"><with-param name="id_parametro" query-param="id_parametro"/><with-param name="maximo" query-param="maximo"/><with-param name="minimo" query-param="minimo"/><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/parametro">
      <call-query href="setParametroMan"><with-param name="paramdescrip" query-param="paramdescrip"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/parametros/empresa/{id_empresa}">
      <call-query href="getParametrosMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-1 · Componentes (catálogo y asignación a equipos). Reemplaza el acceso directo de models/Componentes.php
        (ADR-014). Toda query queda limitada a la empresa (id de asset). Las columnas salen como CHAR para que el texto sea el
        mismo que devolvía mysqli (fechas y decimales). -->
   <query id="getComponentesAbmMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT c.id_componente, c.descripcion, c.informacion, c.marcaid, c.pdf, m.marcadescrip FROM componentes c JOIN marcasequipos m ON c.marcaid = m.marcaid WHERE c.id_empresa = :id_empresa AND c.estado = 'AC' AND m.estado = 'AC'</sql>
      <result outputType="json">{"componentes":{"componente":[{"id_componente":"$id_componente","descripcion":"$descripcion","informacion":"$informacion","marcaid":"$marcaid","pdf":"$pdf","marcadescrip":"$marcadescrip"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponentesEquiposMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.codigo, e.descripcion, c.id_componente, c.descripcion AS descomp, c.pdf, s.descripcion AS sistema, ce.idcomponenteequipo, ce.estado, ce.codigo AS codcomponente FROM equipos e JOIN componenteequipo ce ON ce.id_equipo = e.id_equipo JOIN componentes c ON c.id_componente = ce.id_componente JOIN sistema s ON ce.sistemaid = s.sistemaid WHERE c.id_empresa = :id_empresa</sql>
      <result outputType="json">{"componentes":{"componente":[{"id_equipo":"$id_equipo","codigo":"$codigo","descripcion":"$descripcion","id_componente":"$id_componente","descomp":"$descomp","pdf":"$pdf","sistema":"$sistema","idcomponenteequipo":"$idcomponenteequipo","estado":"$estado","codcomponente":"$codcomponente"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquiposCompMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT CAST(`id_equipo` AS CHAR) AS id_equipo, CAST(`descripcion` AS CHAR) AS descripcion, CAST(`fecha_ingreso` AS CHAR) AS fecha_ingreso, CAST(`fecha_baja` AS CHAR) AS fecha_baja, CAST(`fecha_garantia` AS CHAR) AS fecha_garantia, CAST(`marca` AS CHAR) AS marca, CAST(`codigo` AS CHAR) AS codigo, CAST(`ubicacion` AS CHAR) AS ubicacion, CAST(`id_empresa` AS CHAR) AS id_empresa, CAST(`id_sector` AS CHAR) AS id_sector, CAST(`id_hubicacion` AS CHAR) AS id_hubicacion, CAST(`id_grupo` AS CHAR) AS id_grupo, CAST(`id_customer` AS CHAR) AS id_customer, CAST(`id_criticidad` AS CHAR) AS id_criticidad, CAST(`estado` AS CHAR) AS estado, CAST(`fecha_ultimalectura` AS CHAR) AS fecha_ultimalectura, CAST(`ultima_lectura` AS CHAR) AS ultima_lectura, CAST(`tipo_horas` AS CHAR) AS tipo_horas, CAST(`id-centrodecosto` AS CHAR) AS id_centrodecosto, CAST(`valor_reposicion` AS CHAR) AS valor_reposicion, CAST(`fecha_reposicion` AS CHAR) AS fecha_reposicion, CAST(`id_proveedor` AS CHAR) AS id_proveedor, CAST(`valor` AS CHAR) AS valor, CAST(`comprobante` AS CHAR) AS comprobante, CAST(`descrip_tecnica` AS CHAR) AS descrip_tecnica, CAST(`id_unidad` AS CHAR) AS id_unidad, CAST(`id_area` AS CHAR) AS id_area, CAST(`id_proceso` AS CHAR) AS id_proceso, CAST(`numero_serie` AS CHAR) AS numero_serie, CAST(`adjunto` AS CHAR) AS adjunto, CAST(`meta_disponibilidad` AS CHAR) AS meta_disponibilidad FROM equipos WHERE estado != 'AN' AND id_empresa = :id_empresa ORDER BY id_equipo ASC</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","descripcion":"$descripcion","fecha_ingreso":"$fecha_ingreso","fecha_baja":"$fecha_baja","fecha_garantia":"$fecha_garantia","marca":"$marca","codigo":"$codigo","ubicacion":"$ubicacion","id_empresa":"$id_empresa","id_sector":"$id_sector","id_hubicacion":"$id_hubicacion","id_grupo":"$id_grupo","id_customer":"$id_customer","id_criticidad":"$id_criticidad","estado":"$estado","fecha_ultimalectura":"$fecha_ultimalectura","ultima_lectura":"$ultima_lectura","tipo_horas":"$tipo_horas","id-centrodecosto":"$id_centrodecosto","valor_reposicion":"$valor_reposicion","fecha_reposicion":"$fecha_reposicion","id_proveedor":"$id_proveedor","valor":"$valor","comprobante":"$comprobante","descrip_tecnica":"$descrip_tecnica","id_unidad":"$id_unidad","id_area":"$id_area","id_proceso":"$id_proceso","numero_serie":"$numero_serie","adjunto":"$adjunto","meta_disponibilidad":"$meta_disponibilidad"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquipoDescripcionMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT descripcion FROM equipos WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"descripcion":"$descripcion"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getMarcasCompMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT marcaid, marcadescrip, estado, id_empresa FROM marcasequipos WHERE id_empresa = :id_empresa AND estado != 'AN' ORDER BY marcadescrip</sql>
      <result outputType="json">{"marcas":{"marca":[{"marcaid":"$marcaid","marcadescrip":"$marcadescrip","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponentesAutocompletarMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT CONCAT(c.descripcion, ' - ', m.marcadescrip, ' - ', c.informacion) AS label, c.id_componente AS value FROM componentes c JOIN marcasequipos m ON c.marcaid = m.marcaid WHERE c.id_empresa = :id_empresa AND c.estado != 'AN' ORDER BY label ASC</sql>
      <result outputType="json">{"componentes":{"componente":[{"label":"$label","value":"$value"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getSistemasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT sistemaid, descripcion, estado, id_empresa FROM sistema WHERE id_empresa = :id_empresa AND estado = 'AC' ORDER BY descripcion</sql>
      <result outputType="json">{"sistemas":{"sistema":[{"sistemaid":"$sistemaid","descripcion":"$descripcion","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setComponenteMan" keyColumns="id_componente" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO componentes (id_equipo, descripcion, informacion, fechahora, marcaid, estado, pdf, id_empresa) VALUES (-1, :descripcion, :informacion, NOW(), :marcaid, :estado, '', :id_empresa)</sql>
      <result outputType="json">{"componente":{"id_componente":"$GENERATED_KEY"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="informacion" sqlType="STRING"/>
      <param name="marcaid" sqlType="STRING"/>
      <param name="estado" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setComponenteEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO componenteequipo (id_equipo, id_componente, codigo, estado, sistemaid, id_empresa) SELECT e.id_equipo, :id_componente, :codigo, 'AC', COALESCE(NULLIF(:sistemaid, ''), 0), e.id_empresa FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"componenteequipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_componente" sqlType="STRING"/>
      <param name="codigo" sqlType="STRING"/>
      <param name="sistemaid" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponentesDeEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.descripcion, m.marcadescrip, c.descripcion AS dee11, c.informacion, ce.id_componente FROM equipos e LEFT JOIN componenteequipo ce ON ce.id_equipo = e.id_equipo AND ce.estado = 'AC' LEFT JOIN componentes c ON c.id_componente = ce.id_componente LEFT JOIN marcasequipos m ON c.marcaid = m.marcaid WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa ORDER BY dee11</sql>
      <result outputType="json">{"componentes":{"componente":[{"id_equipo":"$id_equipo","descripcion":"$descripcion","marcadescrip":"$marcadescrip","dee11":"$dee11","informacion":"$informacion","id_componente":"$id_componente"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateComponentePdfMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE componentes SET pdf = :pdf WHERE id_componente = :id_componente AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"componente":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="pdf" sqlType="STRING"/>
      <param name="id_componente" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="bajaComponenteEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE componenteequipo ce JOIN equipos e ON e.id_equipo = ce.id_equipo SET ce.estado = 'AN' WHERE ce.id_componente = :id_componente AND ce.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"componenteequipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_componente" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponenteEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT ce.idcomponenteequipo, ce.id_equipo, ce.id_componente, ce.codigo, e.codigo AS codigoEq, e.descripcion FROM componenteequipo ce JOIN equipos e ON ce.id_equipo = e.id_equipo WHERE ce.estado = 'AC' AND ce.id_empresa = :id_empresa AND ce.idcomponenteequipo = :idcomponenteequipo</sql>
      <result outputType="json">{"componentes":{"componente":[{"idcomponenteequipo":"$idcomponenteequipo","id_equipo":"$id_equipo","id_componente":"$id_componente","codigo":"$codigo","codigoEq":"$codigoEq","descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="idcomponenteequipo" sqlType="STRING"/>
   </query>
   <query id="updateComponenteEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE componenteequipo ce JOIN equipos e ON e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa SET ce.id_equipo = e.id_equipo, ce.id_componente = :id_componente, ce.codigo = :codigo WHERE ce.idcomponenteequipo = :idcomponenteequipo AND ce.id_empresa = :id_empresa</sql>
      <result outputType="json">{"componenteequipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_componente" sqlType="STRING"/>
      <param name="codigo" sqlType="STRING"/>
      <param name="idcomponenteequipo" sqlType="STRING"/>
   </query>
   <query id="bajaComponenteMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE componentes SET estado = 'AN' WHERE id_componente = :id_componente AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"componente":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_componente" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateComponenteMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE componentes SET descripcion = :descripcion, informacion = :informacion, marcaid = :marcaid, pdf = COALESCE(NULLIF(:pdf, ''), pdf) WHERE id_componente = :id_componente AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"componente":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="informacion" sqlType="STRING"/>
      <param name="marcaid" sqlType="STRING"/>
      <param name="pdf" sqlType="STRING"/>
      <param name="id_componente" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/componentes/abm/empresa/{id_empresa}">
      <call-query href="getComponentesAbmMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/equipos/empresa/{id_empresa}">
      <call-query href="getComponentesEquiposMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/equipos-empresa/{id_empresa}">
      <call-query href="getEquiposCompMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/equipo/{id_equipo}/descripcion/empresa/{id_empresa}">
      <call-query href="getEquipoDescripcionMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/marcas/empresa/{id_empresa}">
      <call-query href="getMarcasCompMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/autocompletar/empresa/{id_empresa}">
      <call-query href="getComponentesAutocompletarMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/sistemas/empresa/{id_empresa}">
      <call-query href="getSistemasMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/componente">
      <call-query href="setComponenteMan"><with-param name="descripcion" query-param="descripcion"/><with-param name="informacion" query-param="informacion"/><with-param name="marcaid" query-param="marcaid"/><with-param name="estado" query-param="estado"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/componente/equipo">
      <call-query href="setComponenteEquipoMan"><with-param name="id_componente" query-param="id_componente"/><with-param name="codigo" query-param="codigo"/><with-param name="sistemaid" query-param="sistemaid"/><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componentes/equipo/{id_equipo}/empresa/{id_empresa}">
      <call-query href="getComponentesDeEquipoMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/componente/pdf">
      <call-query href="updateComponentePdfMan"><with-param name="pdf" query-param="pdf"/><with-param name="id_componente" query-param="id_componente"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/componente/equipo/baja">
      <call-query href="bajaComponenteEquipoMan"><with-param name="id_componente" query-param="id_componente"/><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/componente/equipo/{idcomponenteequipo}/empresa/{id_empresa}">
      <call-query href="getComponenteEquipoMan"><with-param name="idcomponenteequipo" query-param="idcomponenteequipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/componente/equipo">
      <call-query href="updateComponenteEquipoMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/><with-param name="id_componente" query-param="id_componente"/><with-param name="codigo" query-param="codigo"/><with-param name="idcomponenteequipo" query-param="idcomponenteequipo"/></call-query>
   </resource>
   <resource method="PUT" path="/componente/baja">
      <call-query href="bajaComponenteMan"><with-param name="id_componente" query-param="id_componente"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/componente">
      <call-query href="updateComponenteMan"><with-param name="descripcion" query-param="descripcion"/><with-param name="informacion" query-param="informacion"/><with-param name="marcaid" query-param="marcaid"/><with-param name="pdf" query-param="pdf"/><with-param name="id_componente" query-param="id_componente"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-1 · Equipos (listado, alta, edición, estados, lecturas, adjuntos, contratistas y metas). Reemplaza el acceso
        directo de models/Equipos.php (ADR-014). Toda query queda limitada a la empresa (id de asset), salvo la unicidad del
        código, que en asset es global. Fechas y decimales salen como CHAR para que el texto sea el mismo que devolvía mysqli.
        En las escrituras se pasan explícitos los valores que MariaDB completaba sola (decisión E13).
        historial_lecturas es MyISAM (sin transacciones) y su trigger actualizaLectura actualiza equipos: el INSERT no puede
        leer equipos (error 1442), así que la pertenencia a la empresa la verifica el model con getEquipoDeEmpresaMan. -->
   <query id="getEquiposPaginadosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.codigo, e.descripcion AS deeq, e.estado AS estadoEquipo, e.meta_disponibilidad AS meta_disp, u.id_unidad, u.descripcion AS deun, a.id_area, a.descripcion AS dear, em.id_empresa, em.descripcion AS deem, s.id_sector, s.descripcion AS desec, c.id_criti, c.descripcion AS decri, g.form_id, g.id_grupo, cl.cliId, cl.cliRazonSocial AS clie, p.id_proceso, p.descripcion AS depro FROM equipos e INNER JOIN sector s ON s.id_sector = e.id_sector INNER JOIN empresas em ON em.id_empresa = e.id_empresa INNER JOIN unidad_industrial u ON u.id_unidad = e.id_unidad INNER JOIN criticidad c ON c.id_criti = e.id_criticidad INNER JOIN area a ON a.id_area = e.id_area INNER JOIN proceso p ON p.id_proceso = e.id_proceso INNER JOIN grupo g ON g.id_grupo = e.id_grupo INNER JOIN admcustomers cl ON cl.cliId = e.id_customer WHERE e.estado != 'AN' AND e.id_empresa = :id_empresa AND (IFNULL(:buscar, '') = '' OR e.codigo LIKE CONCAT('%', :buscar, '%') OR e.descripcion LIKE CONCAT('%', :buscar, '%') OR a.descripcion LIKE CONCAT('%', :buscar, '%') OR p.descripcion LIKE CONCAT('%', :buscar, '%') OR s.descripcion LIKE CONCAT('%', :buscar, '%') OR c.descripcion LIKE CONCAT('%', :buscar, '%') OR cl.cliRazonSocial LIKE CONCAT('%', :buscar, '%') OR e.estado LIKE CONCAT('%', :buscar, '%')) ORDER BY e.id_equipo ASC LIMIT :inicio, :cantidad</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","codigo":"$codigo","deeq":"$deeq","estadoEquipo":"$estadoEquipo","meta_disp":"$meta_disp","id_unidad":"$id_unidad","deun":"$deun","id_area":"$id_area","dear":"$dear","id_empresa":"$id_empresa","deem":"$deem","id_sector":"$id_sector","desec":"$desec","id_criti":"$id_criti","decri":"$decri","form_id":"$form_id","id_grupo":"$id_grupo","cliId":"$cliId","clie":"$clie","id_proceso":"$id_proceso","depro":"$depro"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="buscar" sqlType="STRING"/>
      <param name="inicio" sqlType="INTEGER"/>
      <param name="cantidad" sqlType="INTEGER"/>
   </query>
   <query id="getEquiposPaginadosCantMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT COUNT(1) AS cant FROM equipos e INNER JOIN sector s ON s.id_sector = e.id_sector INNER JOIN empresas em ON em.id_empresa = e.id_empresa INNER JOIN unidad_industrial u ON u.id_unidad = e.id_unidad INNER JOIN criticidad c ON c.id_criti = e.id_criticidad INNER JOIN area a ON a.id_area = e.id_area INNER JOIN proceso p ON p.id_proceso = e.id_proceso INNER JOIN admcustomers cl ON cl.cliId = e.id_customer WHERE e.estado != 'AN' AND e.id_empresa = :id_empresa AND (IFNULL(:buscar, '') = '' OR e.codigo LIKE CONCAT('%', :buscar, '%') OR e.descripcion LIKE CONCAT('%', :buscar, '%') OR a.descripcion LIKE CONCAT('%', :buscar, '%') OR p.descripcion LIKE CONCAT('%', :buscar, '%') OR s.descripcion LIKE CONCAT('%', :buscar, '%') OR c.descripcion LIKE CONCAT('%', :buscar, '%') OR cl.cliRazonSocial LIKE CONCAT('%', :buscar, '%') OR e.estado LIKE CONCAT('%', :buscar, '%'))</sql>
      <result outputType="json">{"equipos":{"equipo":[{"cant":"$cant"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="buscar" sqlType="STRING"/>
   </query>
   <query id="getEquipoEditarMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.descripcion AS deeq, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, CAST(e.fecha_garantia AS CHAR) AS fecha_garantia, e.codigo, e.ubicacion, CAST(e.fecha_ultimalectura AS CHAR) AS fecha_ultimalectura, CAST(e.ultima_lectura AS CHAR) AS ultima_lectura, e.descrip_tecnica, e.numero_serie, e.estado, u.id_unidad, u.descripcion AS deun, a.id_area, a.descripcion AS dear, em.id_empresa, em.descripcion AS deem, s.id_sector, s.descripcion AS desec, c.id_criti, c.descripcion AS decri, p.id_proceso, p.descripcion AS depro, m.marcaid, m.marcadescrip, cl.cliId, cl.cliRazonSocial, g.id_grupo, g.descripcion AS degr FROM equipos e JOIN sector s ON s.id_sector = e.id_sector JOIN empresas em ON em.id_empresa = e.id_empresa JOIN unidad_industrial u ON u.id_unidad = e.id_unidad JOIN criticidad c ON c.id_criti = e.id_criticidad JOIN area a ON a.id_area = e.id_area JOIN proceso p ON p.id_proceso = e.id_proceso JOIN marcasequipos m ON m.marcaid = e.marca LEFT JOIN admcustomers cl ON cl.cliId = e.id_customer LEFT JOIN grupo g ON g.id_grupo = e.id_grupo WHERE e.id_empresa = :id_empresa AND e.estado != 'AN' AND e.id_equipo = :id_equipo</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","deeq":"$deeq","fecha_ingreso":"$fecha_ingreso","fecha_garantia":"$fecha_garantia","codigo":"$codigo","ubicacion":"$ubicacion","fecha_ultimalectura":"$fecha_ultimalectura","ultima_lectura":"$ultima_lectura","descrip_tecnica":"$descrip_tecnica","numero_serie":"$numero_serie","estado":"$estado","id_unidad":"$id_unidad","deun":"$deun","id_area":"$id_area","dear":"$dear","id_empresa":"$id_empresa","deem":"$deem","id_sector":"$id_sector","desec":"$desec","id_criti":"$id_criti","decri":"$decri","id_proceso":"$id_proceso","depro":"$depro","marcaid":"$marcaid","marcadescrip":"$marcadescrip","cliId":"$cliId","cliRazonSocial":"$cliRazonSocial","id_grupo":"$id_grupo","degr":"$degr"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getAdjuntosEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT ad.id_adjunto, ad.adjunto FROM equipos e JOIN equipos_archi_adjuntos ad ON e.id_equipo = ad.id_equipo WHERE ad.eliminado != 1 AND e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa ORDER BY ad.id_adjunto</sql>
      <result outputType="json">{"adjuntos":{"adjunto":[{"id_adjunto":"$id_adjunto","adjunto":"$adjunto"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCriticidadesEqMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_criti, descripcion, id_empresa, estado FROM criticidad WHERE id_empresa = :id_empresa AND estado = 'AC'</sql>
      <result outputType="json">{"criticidades":{"criticidad":[{"id_criti":"$id_criti","descripcion":"$descripcion","id_empresa":"$id_empresa","estado":"$estado"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getSectoresEqMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_sector, descripcion, estado, id_empresa FROM sector WHERE id_empresa = :id_empresa AND estado = 'AC'</sql>
      <result outputType="json">{"sectores":{"sector":[{"id_sector":"$id_sector","descripcion":"$descripcion","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getGruposEqMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_grupo, descripcion, estado, id_empresa, form_id FROM grupo WHERE id_empresa = :id_empresa AND estado = 'AC'</sql>
      <result outputType="json">{"grupos":{"grupo":[{"id_grupo":"$id_grupo","descripcion":"$descripcion","estado":"$estado","id_empresa":"$id_empresa","form_id":"$form_id"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getMarcasEqMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT marcaid, marcadescrip, estado, id_empresa FROM marcasequipos WHERE id_empresa = :id_empresa AND estado = 'AC'</sql>
      <result outputType="json">{"marcas":{"marca":[{"marcaid":"$marcaid","marcadescrip":"$marcadescrip","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getClientesEqMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT cliId, cliName, cliLastName, cliDni, CAST(cliDateOfBirth AS CHAR) AS cliDateOfBirth, cliNroCustomer, cliAddress, cliPhone, cliMovil, cliEmail, cliImagePath, zonaId, cliDay, cliColor, estado, id_empresa, cliRazonSocial, plant_id FROM admcustomers WHERE estado != 'AN' AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"clientes":{"cliente":[{"cliId":"$cliId","cliName":"$cliName","cliLastName":"$cliLastName","cliDni":"$cliDni","cliDateOfBirth":"$cliDateOfBirth","cliNroCustomer":"$cliNroCustomer","cliAddress":"$cliAddress","cliPhone":"$cliPhone","cliMovil":"$cliMovil","cliEmail":"$cliEmail","cliImagePath":"$cliImagePath","zonaId":"$zonaId","cliDay":"$cliDay","cliColor":"$cliColor","estado":"$estado","id_empresa":"$id_empresa","cliRazonSocial":"$cliRazonSocial","plant_id":"$plant_id"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getContratistasEmpresaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_contratista, nombre, contradireccion, contramail, contramail1, contracelular1, contracelular2, contratelefono, contracontacto, estado, id_empresa FROM contratistas WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"contratistas":{"contratista":[{"id_contratista":"$id_contratista","nombre":"$nombre","contradireccion":"$contradireccion","contramail":"$contramail","contramail1":"$contramail1","contracelular1":"$contracelular1","contracelular2":"$contracelular2","contratelefono":"$contratelefono","contracontacto":"$contracontacto","estado":"$estado","id_empresa":"$id_empresa"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getContratistasEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT ce.id_equipo, ce.id_contratista, e.codigo, c.nombre FROM contratistaquipo ce JOIN equipos e ON e.id_equipo = ce.id_equipo JOIN contratistas c ON c.id_contratista = ce.id_contratista WHERE ce.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"contratistas":{"contratista":[{"id_equipo":"$id_equipo","id_contratista":"$id_contratista","codigo":"$codigo","nombre":"$nombre"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquipoConMarcaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.descripcion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, CAST(e.fecha_baja AS CHAR) AS fecha_baja, CAST(e.fecha_garantia AS CHAR) AS fecha_garantia, e.marca, e.codigo, e.ubicacion, m.id_empresa, e.id_sector, CAST(e.id_hubicacion AS CHAR) AS id_hubicacion, e.id_grupo, e.id_customer, e.id_criticidad, m.estado, CAST(e.fecha_ultimalectura AS CHAR) AS fecha_ultimalectura, CAST(e.ultima_lectura AS CHAR) AS ultima_lectura, e.tipo_horas, CAST(e.`id-centrodecosto` AS CHAR) AS idcentrodecosto, CAST(e.valor_reposicion AS CHAR) AS valor_reposicion, CAST(e.fecha_reposicion AS CHAR) AS fecha_reposicion, CAST(e.id_proveedor AS CHAR) AS id_proveedor, CAST(e.valor AS CHAR) AS valor, e.comprobante, e.descrip_tecnica, e.id_unidad, e.id_area, e.id_proceso, e.numero_serie, e.adjunto, e.meta_disponibilidad, m.marcaid, m.marcadescrip FROM equipos e JOIN marcasequipos m ON e.marca = m.marcaid WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","descripcion":"$descripcion","fecha_ingreso":"$fecha_ingreso","fecha_baja":"$fecha_baja","fecha_garantia":"$fecha_garantia","marca":"$marca","codigo":"$codigo","ubicacion":"$ubicacion","id_empresa":"$id_empresa","id_sector":"$id_sector","id_hubicacion":"$id_hubicacion","id_grupo":"$id_grupo","id_customer":"$id_customer","id_criticidad":"$id_criticidad","estado":"$estado","fecha_ultimalectura":"$fecha_ultimalectura","ultima_lectura":"$ultima_lectura","tipo_horas":"$tipo_horas","id-centrodecosto":"$idcentrodecosto","valor_reposicion":"$valor_reposicion","fecha_reposicion":"$fecha_reposicion","id_proveedor":"$id_proveedor","valor":"$valor","comprobante":"$comprobante","descrip_tecnica":"$descrip_tecnica","id_unidad":"$id_unidad","id_area":"$id_area","id_proceso":"$id_proceso","numero_serie":"$numero_serie","adjunto":"$adjunto","meta_disponibilidad":"$meta_disponibilidad","marcaid":"$marcaid","marcadescrip":"$marcadescrip"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getLecturasEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT h.id_lectura, h.id_equipo, h.lectura, CAST(h.fecha AS CHAR) AS fecha, h.usrId, h.observacion, h.operario_nom, h.turno, h.estado, h.obs, h.info_id FROM historial_lecturas h JOIN equipos e ON e.id_equipo = h.id_equipo WHERE h.id_equipo = :id_equipo AND e.id_empresa = :id_empresa ORDER BY h.id_lectura</sql>
      <result outputType="json">{"lecturas":{"lectura":[{"id_lectura":"$id_lectura","id_equipo":"$id_equipo","lectura":"$lectura","fecha":"$fecha","usrId":"$usrId","observacion":"$observacion","operario_nom":"$operario_nom","turno":"$turno","estado":"$estado","obs":"$obs","info_id":"$info_id"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getUltimaLecturaEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.id_equipo, e.codigo, e.id_grupo, h.lectura, CAST(h.fecha AS CHAR) AS fecha, h.estado, h.id_lectura FROM historial_lecturas h JOIN equipos e ON e.id_equipo = h.id_equipo WHERE h.id_equipo = :id_equipo AND e.id_empresa = :id_empresa ORDER BY h.id_lectura DESC LIMIT 1</sql>
      <result outputType="json">{"lecturas":{"lectura":[{"id_equipo":"$id_equipo","codigo":"$codigo","id_grupo":"$id_grupo","lectura":"$lectura","fecha":"$fecha","estado":"$estado","id_lectura":"$id_lectura"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getLecturasVecinasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT (SELECT h.lectura FROM historial_lecturas h WHERE h.id_lectura = (SELECT MAX(h1.id_lectura) FROM historial_lecturas h1 WHERE h1.id_lectura &lt; :id_lectura AND h1.id_equipo = e.id_equipo)) AS anterior, (SELECT h.lectura FROM historial_lecturas h WHERE h.id_lectura = (SELECT MIN(h2.id_lectura) FROM historial_lecturas h2 WHERE h2.id_lectura &gt; :id_lectura AND h2.id_equipo = e.id_equipo)) AS posterior FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"lecturas":{"lectura":[{"anterior":"$anterior","posterior":"$posterior"}]}}</result>
      <param name="id_lectura" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getMetaEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT meta_disponibilidad FROM equipos WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"meta_disponibilidad":"$meta_disponibilidad"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCodigoEquipoExisteMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT COUNT(1) AS cant FROM equipos WHERE codigo = :codigo</sql>
      <result outputType="json">{"equipos":{"equipo":[{"cant":"$cant"}]}}</result>
      <param name="codigo" sqlType="STRING"/>
   </query>
   <query id="getUsuarioAssetMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT s.usrId FROM sisusers s JOIN usuarioasempresa ue ON ue.usrId = s.usrId WHERE s.usrNick = :usrNick AND ue.empresaid = :id_empresa ORDER BY s.usrId LIMIT 1</sql>
      <result outputType="json">{"usuarios":{"usuario":[{"usrId":"$usrId"}]}}</result>
      <param name="usrNick" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setEquipoMan" keyColumns="id_equipo" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO equipos (descripcion, fecha_ingreso, fecha_baja, fecha_garantia, marca, codigo, ubicacion, id_empresa, id_sector, id_hubicacion, id_grupo, id_customer, id_criticidad, estado, fecha_ultimalectura, ultima_lectura, tipo_horas, `id-centrodecosto`, valor_reposicion, fecha_reposicion, id_proveedor, valor, comprobante, descrip_tecnica, id_unidad, id_area, id_proceso, numero_serie) VALUES (LEFT(:descripcion, 255), :fecha_ingreso, '0000-00-00', :fecha_garantia, LEFT(:marca, 255), LEFT(:codigo, 255), '', :id_empresa, :id_sector, :id_hubicacion, :id_grupo, :id_customer, :id_criticidad, 'AL', :fecha_ultimalectura, :ultima_lectura, '', 0, 0, '0000-00-00', 0, 0, '', :descrip_tecnica, :id_unidad, :id_area, :id_proceso, LEFT(:numero_serie, 255))</sql>
      <result outputType="json">{"equipo":{"id_equipo":"$GENERATED_KEY"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="fecha_ingreso" sqlType="STRING"/>
      <param name="fecha_garantia" sqlType="STRING"/>
      <param name="marca" sqlType="STRING"/>
      <param name="codigo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_sector" sqlType="STRING"/>
      <param name="id_hubicacion" sqlType="STRING"/>
      <param name="id_grupo" sqlType="STRING"/>
      <param name="id_customer" sqlType="STRING"/>
      <param name="id_criticidad" sqlType="STRING"/>
      <param name="fecha_ultimalectura" sqlType="STRING"/>
      <param name="ultima_lectura" sqlType="STRING"/>
      <param name="descrip_tecnica" sqlType="STRING"/>
      <param name="id_unidad" sqlType="STRING"/>
      <param name="id_area" sqlType="STRING"/>
      <param name="id_proceso" sqlType="STRING"/>
      <param name="numero_serie" sqlType="STRING"/>
   </query>
   <query id="updateEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE equipos SET descripcion = LEFT(:descripcion, 255), fecha_ingreso = :fecha_ingreso, fecha_garantia = :fecha_garantia, marca = LEFT(:marca, 255), codigo = LEFT(:codigo, 255), ubicacion = LEFT(:ubicacion, 100), id_sector = :id_sector, id_grupo = :id_grupo, id_area = :id_area, id_proceso = :id_proceso, id_criticidad = :id_criticidad, id_customer = :id_customer, numero_serie = LEFT(:numero_serie, 255), estado = LEFT(:estado, 2), fecha_ultimalectura = :fecha_ultimalectura, ultima_lectura = :ultima_lectura, descrip_tecnica = :descrip_tecnica WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="descripcion" sqlType="STRING"/>
      <param name="fecha_ingreso" sqlType="STRING"/>
      <param name="fecha_garantia" sqlType="STRING"/>
      <param name="marca" sqlType="STRING"/>
      <param name="codigo" sqlType="STRING"/>
      <param name="ubicacion" sqlType="STRING"/>
      <param name="id_sector" sqlType="STRING"/>
      <param name="id_grupo" sqlType="STRING"/>
      <param name="id_area" sqlType="STRING"/>
      <param name="id_proceso" sqlType="STRING"/>
      <param name="id_criticidad" sqlType="STRING"/>
      <param name="id_customer" sqlType="STRING"/>
      <param name="numero_serie" sqlType="STRING"/>
      <param name="estado" sqlType="STRING"/>
      <param name="fecha_ultimalectura" sqlType="STRING"/>
      <param name="ultima_lectura" sqlType="STRING"/>
      <param name="descrip_tecnica" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateEquipoEstadoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE equipos SET estado = :estado WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="estado" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateEquipoMetaMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE equipos SET meta_disponibilidad = :meta WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="meta" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getEquipoDeEmpresaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT id_equipo, estado FROM equipos WHERE id_equipo = :id_equipo AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"id_equipo":"$id_equipo","estado":"$estado"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setLecturaEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO historial_lecturas (id_equipo, lectura, fecha, usrId, observacion, operario_nom, turno, estado) VALUES (:id_equipo, :lectura, :fecha, :usrId, :observacion, LEFT(:operario_nom, 50), LEFT(:turno, 11), LEFT(:estado, 4))</sql>
      <result outputType="json">{"lectura":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="lectura" sqlType="STRING"/>
      <param name="fecha" sqlType="STRING"/>
      <param name="usrId" sqlType="STRING"/>
      <param name="observacion" sqlType="STRING"/>
      <param name="operario_nom" sqlType="STRING"/>
      <param name="turno" sqlType="STRING"/>
      <param name="estado" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
   </query>
   <query id="updateLecturaEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE historial_lecturas h JOIN equipos e ON e.id_equipo = h.id_equipo SET h.lectura = :lectura, h.observacion = :observacion WHERE h.id_lectura = :id_lectura AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"lectura":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="lectura" sqlType="STRING"/>
      <param name="observacion" sqlType="STRING"/>
      <param name="id_lectura" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setAdjuntoEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO equipos_archi_adjuntos (id_equipo, adjunto, eliminado) SELECT e.id_equipo, :adjunto, 0 FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"adjunto":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="adjunto" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateAdjuntoEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE equipos_archi_adjuntos ad JOIN equipos e ON e.id_equipo = ad.id_equipo SET ad.adjunto = :adjunto WHERE ad.id_adjunto = :id_adjunto AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"adjunto":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="adjunto" sqlType="STRING"/>
      <param name="id_adjunto" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="bajaAdjuntoEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE equipos_archi_adjuntos ad JOIN equipos e ON e.id_equipo = ad.id_equipo SET ad.eliminado = 1 WHERE ad.id_adjunto = :id_adjunto AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"adjunto":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_adjunto" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setContratistaEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO contratistaquipo (id_equipo, id_contratista) SELECT e.id_equipo, c.id_contratista FROM equipos e JOIN contratistas c ON c.id_contratista = :id_contratista AND c.id_empresa = e.id_empresa WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"contratista":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_contratista" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="bajaContratistaEquipoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE ce FROM contratistaquipo ce JOIN equipos e ON e.id_equipo = ce.id_equipo WHERE ce.id_contratista = :id_contratista AND ce.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"contratista":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_contratista" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setCriticidadEqMan" keyColumns="id_criti" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO criticidad (descripcion, id_empresa, estado) VALUES (LEFT(:descripcion, 50), :id_empresa, 'AC')</sql>
      <result outputType="json">{"criticidad":{"id_criti":"$GENERATED_KEY"}}</result>
