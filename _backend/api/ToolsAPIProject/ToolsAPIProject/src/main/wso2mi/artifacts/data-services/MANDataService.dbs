      <param name="cliId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOtConClienteMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT ot.id_orden AS id_orden, ot.id_tarea AS id_tarea, ot.nro AS nro, CAST(ot.fecha AS CHAR) AS fecha, CAST(ot.fecha_program AS CHAR) AS fecha_program, CAST(ot.fecha_inicio AS CHAR) AS fecha_inicio, CAST(ot.fecha_entrega AS CHAR) AS fecha_entrega, CAST(ot.fecha_terminada AS CHAR) AS fecha_terminada, CAST(ot.fecha_aviso AS CHAR) AS fecha_aviso, CAST(ot.fecha_entregada AS CHAR) AS fecha_entregada, ot.descripcion AS descripcion, ot.cliId AS cliId, ot.id_usuario AS id_usuario, ot.id_usuario_a AS id_usuario_a, ot.id_usuario_e AS id_usuario_e, ot.id_sucursal AS id_sucursal, ot.id_proveedor AS id_proveedor, ot.id_solicitud AS id_solicitud, ot.tipo AS tipo, ot.id_equipo AS id_equipo, CAST(ot.duracion AS CHAR) AS duracion, ot.id_tareapadre AS id_tareapadre, CAST(ot.lectura_programada AS CHAR) AS lectura_programada, CAST(ot.lectura_ejecutada AS CHAR) AS lectura_ejecutada, ot.case_id AS case_id, ot.latitud AS latitud, ot.longitud AS longitud, ot.justificacion AS justificacion, CAST(ot.f_asignacion AS CHAR) AS f_asignacion, ot.id_usuario_eliminada AS id_usuario_eliminada, CAST(ot.fecha_eliminada AS CHAR) AS fecha_eliminada, ot.motivo_eliminada AS motivo_eliminada, cl.cliId AS cliId2, cl.cliName, cl.cliLastName, cl.cliDni, CAST(cl.cliDateOfBirth AS CHAR) AS cliDateOfBirth, cl.cliNroCustomer, cl.cliAddress, cl.cliPhone, cl.cliMovil, cl.cliEmail, cl.cliImagePath, cl.zonaId, cl.cliDay, cl.cliColor, cl.estado, cl.id_empresa, cl.cliRazonSocial, cl.plant_id FROM orden_trabajo ot JOIN admcustomers cl ON cl.cliId = ot.cliId WHERE ot.id_orden = :id_orden AND ot.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"id_orden":"$id_orden","id_tarea":"$id_tarea","nro":"$nro","fecha":"$fecha","fecha_program":"$fecha_program","fecha_inicio":"$fecha_inicio","fecha_entrega":"$fecha_entrega","fecha_terminada":"$fecha_terminada","fecha_aviso":"$fecha_aviso","fecha_entregada":"$fecha_entregada","descripcion":"$descripcion","cliId":"$cliId","id_usuario":"$id_usuario","id_usuario_a":"$id_usuario_a","id_usuario_e":"$id_usuario_e","id_sucursal":"$id_sucursal","id_proveedor":"$id_proveedor","id_solicitud":"$id_solicitud","tipo":"$tipo","id_equipo":"$id_equipo","duracion":"$duracion","id_tareapadre":"$id_tareapadre","lectura_programada":"$lectura_programada","lectura_ejecutada":"$lectura_ejecutada","case_id":"$case_id","latitud":"$latitud","longitud":"$longitud","justificacion":"$justificacion","f_asignacion":"$f_asignacion","id_usuario_eliminada":"$id_usuario_eliminada","fecha_eliminada":"$fecha_eliminada","motivo_eliminada":"$motivo_eliminada","cliId2":"$cliId2","cliName":"$cliName","cliLastName":"$cliLastName","cliDni":"$cliDni","cliDateOfBirth":"$cliDateOfBirth","cliNroCustomer":"$cliNroCustomer","cliAddress":"$cliAddress","cliPhone":"$cliPhone","cliMovil":"$cliMovil","cliEmail":"$cliEmail","cliImagePath":"$cliImagePath","zonaId":"$zonaId","cliDay":"$cliDay","cliColor":"$cliColor","estado":"$estado","id_empresa":"$id_empresa","cliRazonSocial":"$cliRazonSocial","plant_id":"$plant_id"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateOtEditarMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo ot JOIN equipos e ON e.id_equipo = :id_equipo AND e.id_empresa = ot.id_empresa SET ot.fecha_program = :fecha_program, ot.fecha_entrega = :fecha_entrega, ot.id_tarea = :id_tarea, ot.descripcion = :descripcion, ot.id_sucursal = :id_sucursal, ot.id_proveedor = :id_proveedor, ot.id_equipo = e.id_equipo WHERE ot.id_orden = :id_orden AND ot.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="fecha_program" sqlType="STRING"/>
      <param name="fecha_entrega" sqlType="STRING"/>
      <param name="id_tarea" sqlType="STRING"/>
      <param name="descripcion" sqlType="STRING"/>
      <param name="id_sucursal" sqlType="STRING"/>
      <param name="id_proveedor" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
