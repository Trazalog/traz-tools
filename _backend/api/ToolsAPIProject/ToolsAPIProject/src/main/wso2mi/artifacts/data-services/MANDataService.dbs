      <sql>UPDATE predictivo SET tarea_descrip = :tarea_descrip, fecha = :fecha, periodo = LEFT(:periodo, 50), cantidad = :cantidad, horash = :horash, estado = 'C', pred_duracion = :pred_duracion, id_unidad = :id_unidad, pred_canth = :pred_canth WHERE predId = :predId AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"predictivo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
