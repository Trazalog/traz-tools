   <query id="setOtMan" keyColumns="id_orden" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO orden_trabajo (id_tarea, fecha, fecha_program, fecha_inicio, fecha_entrega, fecha_terminada, fecha_aviso, fecha_entregada, descripcion, estado, id_usuario, id_usuario_e, id_sucursal, id_proveedor, id_solicitud, tipo, id_equipo, id_empresa) SELECT :id_tarea, '0000-00-00', :fecha_program, CAST('0000-00-00' AS DATETIME), :fecha_entrega, CAST('0000-00-00' AS DATETIME), CAST('0000-00-00' AS DATETIME), CAST('0000-00-00' AS DATETIME), IFNULL((SELECT t.descripcion FROM tareas t WHERE t.id_tarea = :id_tarea AND :id_tarea != 0 LIMIT 1), :descripcion), 'PL', :id_usuario, 0, :id_sucursal, :id_proveedor, 0, 1, e.id_equipo, e.id_empresa FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"alta":{"id":"$GENERATED_KEY"}}</result>
      <param name="id_tarea" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="fecha_program" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="fecha_entrega" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="descripcion" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_usuario" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_sucursal" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_proveedor" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
