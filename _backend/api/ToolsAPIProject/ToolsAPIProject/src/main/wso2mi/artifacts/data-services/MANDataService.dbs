   <resource method="PUT" path="/predictivo/estado">
      <call-query href="updatePredictivoEstadoMan"><with-param name="estado" query-param="estado"/><with-param name="predId" query-param="predId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/predictivo/adjunto">
      <call-query href="updatePredictivoAdjuntoMan"><with-param name="pred_adjunto" query-param="pred_adjunto"/><with-param name="predId" query-param="predId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/backlogs/empresa/{id_empresa}">
      <call-query href="getBacklogsMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/backlog/{backId}/datos/empresa/{id_empresa}">
      <call-query href="getBacklogMan"><with-param name="backId" query-param="backId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/backlog/{backId}/equipo/{id_equipo}/empresa/{id_empresa}">
      <call-query href="getBacklogEquipoMan"><with-param name="backId" query-param="backId"/><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/backlogs/componentes/empresa/{id_empresa}">
      <call-query href="getComponentesBacklogMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="id_equipo" query-param="id_equipo"/></call-query>
   </resource>
   <resource method="POST" path="/backlog">
      <call-query href="setBacklogMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_tarea" query-param="id_tarea"/><with-param name="fecha" query-param="fecha"/><with-param name="horash" query-param="horash"/><with-param name="back_duracion" query-param="back_duracion"/><with-param name="id_unidad" query-param="id_unidad"/><with-param name="back_canth" query-param="back_canth"/><with-param name="id_empresa" query-param="id_empresa"/><with-param name="idcomponenteequipo" query-param="idcomponenteequipo"/><with-param name="tarea_opcional" query-param="tarea_opcional"/></call-query>
   </resource>
   <resource method="PUT" path="/backlog">
      <call-query href="updateBacklogMan"><with-param name="backId" query-param="backId"/><with-param name="id_tarea" query-param="id_tarea"/><with-param name="fecha" query-param="fecha"/><with-param name="horash" query-param="horash"/><with-param name="back_duracion" query-param="back_duracion"/><with-param name="back_canth" query-param="back_canth"/><with-param name="id_unidad" query-param="id_unidad"/><with-param name="tarea_opcional" query-param="tarea_opcional"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/backlog/estado">
      <call-query href="updateBacklogEstadoMan"><with-param name="estado" query-param="estado"/><with-param name="backId" query-param="backId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/backlog/adjunto">
      <call-query href="updateBacklogAdjuntoMan"><with-param name="back_adjunto" query-param="back_adjunto"/><with-param name="backId" query-param="backId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-3t · Acciones de la tarea de la Bandeja (tomar, soltar, urgencia, inicio, ejecutar, verificar informe y conformidad).
        Las usa toolsMANAPI /bandeja/tarea/* y /bandeja/ot/inicio. Todo queda limitado a la empresa (id de asset); asset confiaba
        en los números que mandaba el navegador y acá se sacan del caso de la tarea. -->
   <query id="getBandejaTareaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT cx.case_id, o.id_orden, o.tipo, o.id_solicitud, b.sore_id, s.id_solicitud AS ss, CAST(o.fecha_inicio AS CHAR) AS fecha_inicio FROM case_empresa cx LEFT JOIN orden_trabajo o ON o.case_id = cx.case_id AND o.id_empresa = cx.empr_id LEFT JOIN tbl_back b ON o.tipo = '4' AND b.backId = o.id_solicitud AND b.id_empresa = cx.empr_id LEFT JOIN solicitud_reparacion s ON s.case_id = cx.case_id AND s.id_empresa = cx.empr_id WHERE cx.case_id = :case_id AND cx.empr_id = :id_empresa LIMIT 1</sql>
      <result outputType="json">{"tareas":{"tarea":[{"case_id":"$case_id","id_orden":"$id_orden","tipo":"$tipo","id_solicitud":"$id_solicitud","sore_id":"$sore_id","ss":"$ss","fecha_inicio":"$fecha_inicio"}]}}</result>
      <param name="case_id" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOtInicioMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT CAST(fecha_inicio AS CHAR) AS fecha_inicio FROM orden_trabajo WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"fecha_inicio":"$fecha_inicio"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateOtInicioMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET fecha_inicio = :fecha, latitud = :latitud, longitud = :longitud, estado = 'C' WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="fecha" sqlType="STRING"/>
      <param name="latitud" sqlType="STRING"/>
      <param name="longitud" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateBacklogSolicitudEstadoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE solicitud_reparacion SET estado = :estado WHERE id_empresa = :id_empresa AND id_solicitud = (SELECT sore_id FROM tbl_back WHERE backId = :backId AND id_empresa = :id_empresa2)</sql>
      <result outputType="json">{"solicitud":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="estado" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="backId" sqlType="STRING"/>
      <param name="id_empresa2" sqlType="STRING"/>
   </query>
   <query id="updateOtResponsableMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET id_usuario_a = :id_usuario_a WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_usuario_a" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateOtJustificacionMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET justificacion = LEFT(:justificacion, 100) WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="justificacion" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOtResponsableNickMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT u.usrNick FROM orden_trabajo o JOIN sisusers u ON u.usrId = o.id_usuario_a WHERE o.id_orden = :id_orden AND o.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"usrNick":"$usrNick"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOtOrigenPostMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT tipo, id_solicitud FROM orden_trabajo WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"tipo":"$tipo","id_solicitud":"$id_solicitud"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getOtEquipoEstadoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.estado FROM orden_trabajo ot JOIN equipos e ON e.id_equipo = ot.id_equipo WHERE ot.id_orden = :id_orden AND ot.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"estado":"$estado"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setInformeLecturaBandejaMan" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO historial_lecturas (id_equipo, lectura, fecha, usrId, observacion, operario_nom, turno, estado) SELECT ot.id_equipo, IFNULL(os.horometrofin, 0), IFNULL(os.fechahorafin, NOW()), ot.id_usuario_a, CONCAT('Descripcion: ', IF(t.id_tarea IS NULL, ot.descripcion, t.descripcion), ' | OT: ', ot.id_orden), CONCAT(u.usrLastName, ', ', u.usrName), '-', :estado FROM orden_trabajo ot JOIN sisusers u ON u.usrId = ot.id_usuario_a LEFT JOIN tareas t ON t.id_tarea = ot.id_tarea LEFT JOIN orden_servicio os ON os.id_ot = ot.id_orden WHERE ot.id_orden = :id_ot AND ot.id_empresa = :id_empresa ORDER BY os.id_orden LIMIT 1</sql>
      <param name="estado" sqlType="STRING"/>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="POST" path="/bandeja/tarea/caso">
      <call-query href="getBandejaTareaMan"><with-param name="case_id" query-param="case_id"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/ot/{id_orden}/inicio/empresa/{id_empresa}">
      <call-query href="getOtInicioMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/ot/inicio">
      <call-query href="updateOtInicioMan"><with-param name="fecha" query-param="fecha"/><with-param name="latitud" query-param="latitud"/><with-param name="longitud" query-param="longitud"/><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/backlog/solicitud/estado">
      <call-query href="updateBacklogSolicitudEstadoMan"><with-param name="estado" query-param="estado"/><with-param name="id_empresa" query-param="id_empresa"/><with-param name="backId" query-param="backId"/><with-param name="id_empresa2" query-param="id_empresa2"/></call-query>
   </resource>
   <resource method="PUT" path="/ot/responsable">
      <call-query href="updateOtResponsableMan"><with-param name="id_usuario_a" query-param="id_usuario_a"/><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/ot/justificacion">
      <call-query href="updateOtJustificacionMan"><with-param name="justificacion" query-param="justificacion"/><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/ot/responsable/nick">
      <call-query href="getOtResponsableNickMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/ot/origen">
      <call-query href="getOtOrigenPostMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/ot/equipo/estado">
      <call-query href="getOtEquipoEstadoMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/informe/lectura/bandeja">
      <call-query href="setInformeLecturaBandejaMan"><with-param name="estado" query-param="estado"/><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-3d · Detalle de la tarea de la Bandeja: cabecera (equipo, solicitud, OT) y subtareas de la OT.
        Reemplaza las consultas directas de cabecera_helper y de models/Tareas.php (ADR-014); todo limitado a la empresa. -->
   <query id="getTareaCabeceraEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.descripcion AS descripcionEquipo, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, e.codigo, e.ubicacion, e.estado, c.cliRazonSocial AS cliente, m.marcadescrip AS marca FROM equipos e LEFT JOIN marcasequipos m ON m.marcaid = e.marca LEFT JOIN admcustomers c ON c.cliId = e.id_customer WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"descripcionEquipo":"$descripcionEquipo","fecha_ingreso":"$fecha_ingreso","codigo":"$codigo","ubicacion":"$ubicacion","estado":"$estado","cliente":"$cliente","marca":"$marca"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getTareaCabeceraSolicitudMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT s.id_solicitud, s.id_equipo, s.solicitante, s.causa, CAST(s.f_solicitado AS CHAR) AS f_solicitado, e.codigo AS equipo, se.descripcion AS descripcionSector, g.descripcion AS descripcionGrupo FROM solicitud_reparacion s LEFT JOIN equipos e ON e.id_equipo = s.id_equipo LEFT JOIN sector se ON se.id_sector = e.id_sector LEFT JOIN grupo g ON g.id_grupo = e.id_grupo WHERE s.id_solicitud = :id_solicitud AND s.id_empresa = :id_empresa</sql>
      <result outputType="json">{"solicitudes":{"solicitud":[{"id_solicitud":"$id_solicitud","id_equipo":"$id_equipo","solicitante":"$solicitante","causa":"$causa","f_solicitado":"$f_solicitado","equipo":"$equipo","descripcionSector":"$descripcionSector","descripcionGrupo":"$descripcionGrupo"}]}}</result>
      <param name="id_solicitud" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getTareaCabeceraOtMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT t.descripcion AS tareaDescrip, o.descripcion AS otDescrip, CAST(o.fecha_program AS CHAR) AS fecha, o.id_orden, o.duracion, c.cliRazonSocial AS cliente, o.estado, o.id_equipo, o.justificacion, (SELECT COUNT(*) FROM orden_servicio os WHERE os.id_ot = o.id_orden AND os.id_empresa = o.id_empresa) AS tiene_informe FROM orden_trabajo o LEFT JOIN tareas t ON t.id_tarea = o.id_tarea LEFT JOIN equipos e ON e.id_equipo = o.id_equipo LEFT JOIN admcustomers c ON c.cliId = e.id_customer WHERE o.id_orden = :id_orden AND o.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"tareaDescrip":"$tareaDescrip","otDescrip":"$otDescrip","fecha":"$fecha","id_orden":"$id_orden","duracion":"$duracion","cliente":"$cliente","estado":"$estado","id_equipo":"$id_equipo","justificacion":"$justificacion","tiene_informe":"$tiene_informe"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getTareaSubtareasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT l.id_listarea, l.id_orden, l.estado, l.id_subtarea, s.tareadescrip AS subtareadescrip, s.duracion_prog, s.form_asoc FROM tbl_listarea l JOIN orden_trabajo o ON o.id_orden = l.id_orden AND o.id_empresa = :id_empresa LEFT JOIN asp_subtareas s ON s.id_subtarea = l.id_subtarea WHERE l.id_orden = :id_orden</sql>
      <result outputType="json">{"subtareas":{"subtarea":[{"id_listarea":"$id_listarea","id_orden":"$id_orden","estado":"$estado","id_subtarea":"$id_subtarea","subtareadescrip":"$subtareadescrip","duracion_prog":"$duracion_prog","form_asoc":"$form_asoc"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
   </query>
   <query id="getOtProcedimientoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.prev_adjunto FROM orden_trabajo o LEFT JOIN preventivo p ON o.tipo = '3' AND p.prevId = o.id_solicitud AND p.id_empresa = o.id_empresa WHERE o.id_orden = :id_orden AND o.id_empresa = :id_empresa</sql>
      <result outputType="json">{"ots":{"ot":[{"prev_adjunto":"$prev_adjunto"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getBacklogSolicitudEditarMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT b.backId, b.id_equipo, b.id_tarea, CAST(b.fecha AS CHAR) AS fecha, CAST(b.horash AS CHAR) AS horash, b.estado, b.back_duracion, b.id_unidad, b.back_canth, b.idcomponenteequipo, b.back_adjunto, b.sore_id, b.tarea_opcional, e.codigo, e.descripcion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, e.ubicacion, m.marcadescrip AS marca, ce.codigo AS componentecodigo, c.descripcion AS componentedescrip, s.descripcion AS sistemadescrip FROM tbl_back b JOIN equipos e ON e.id_equipo = b.id_equipo LEFT JOIN marcasequipos m ON m.marcaid = e.marca LEFT JOIN componenteequipo ce ON ce.idcomponenteequipo = b.idcomponenteequipo LEFT JOIN componentes c ON c.id_componente = ce.id_componente LEFT JOIN sistema s ON s.sistemaid = ce.sistemaid WHERE b.sore_id = :sore_id AND b.id_empresa = :id_empresa</sql>
      <result outputType="json">{"backlogs":{"backlog":[{"backId":"$backId","id_equipo":"$id_equipo","id_tarea":"$id_tarea","fecha":"$fecha","horash":"$horash","estado":"$estado","back_duracion":"$back_duracion","id_unidad":"$id_unidad","back_canth":"$back_canth","idcomponenteequipo":"$idcomponenteequipo","back_adjunto":"$back_adjunto","sore_id":"$sore_id","tarea_opcional":"$tarea_opcional","codigo":"$codigo","descripcion":"$descripcion","fecha_ingreso":"$fecha_ingreso","ubicacion":"$ubicacion","marca":"$marca","componentecodigo":"$componentecodigo","componentedescrip":"$componentedescrip","sistemadescrip":"$sistemadescrip"}]}}</result>
      <param name="sore_id" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateBacklogReenviarMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE tbl_back SET estado = 'S', idcomponenteequipo = IF(:idcomponenteequipo = '0', idcomponenteequipo, :idcomponenteequipo2) WHERE backId = :backId AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"backlog":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="idcomponenteequipo" sqlType="STRING"/>
      <param name="idcomponenteequipo2" sqlType="STRING"/>
      <param name="backId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/tarea/cabecera/equipo/{id_equipo}/empresa/{id_empresa}">
      <call-query href="getTareaCabeceraEquipoMan"><with-param name="id_equipo" query-param="id_equipo"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/tarea/cabecera/solicitud/{id_solicitud}/empresa/{id_empresa}">
      <call-query href="getTareaCabeceraSolicitudMan"><with-param name="id_solicitud" query-param="id_solicitud"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/tarea/cabecera/ot/{id_orden}/empresa/{id_empresa}">
      <call-query href="getTareaCabeceraOtMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/tarea/subtareas/ot/{id_orden}/empresa/{id_empresa}">
      <call-query href="getTareaSubtareasMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="id_orden" query-param="id_orden"/></call-query>
   </resource>
   <resource method="GET" path="/ot/{id_orden}/procedimiento/empresa/{id_empresa}">
      <call-query href="getOtProcedimientoMan"><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/backlog/solicitud/{sore_id}/editar/empresa/{id_empresa}">
      <call-query href="getBacklogSolicitudEditarMan"><with-param name="sore_id" query-param="sore_id"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/backlog/reenviar">
      <call-query href="updateBacklogReenviarMan"><with-param name="idcomponenteequipo" query-param="idcomponenteequipo"/><with-param name="idcomponenteequipo2" query-param="idcomponenteequipo2"/><with-param name="backId" query-param="backId"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-3i · Informe de servicio desde la Bandeja: operarios, borrado del informe anterior y alta (informe, tareas, operarios y
        evidencias). Sin herramientas ni insumos (pañol y almacenes no se migran). Todo limitado a la empresa. -->
   <query id="getInformeOperariosListaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT DISTINCT CONCAT(u.usrname, ', ', u.usrLastName) AS label, u.usrId AS value FROM sisusers u JOIN usuarioasempresa ue ON ue.usrId = u.usrId WHERE ue.empresaid = :id_empresa AND ue.estado = 'AC'</sql>
      <result outputType="json">{"operarios":{"operario":[{"label":"$label","value":"$value"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getInformeRrhhOtMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT DISTINCT CONCAT(u.usrLastName, ', ', u.usrName) AS label, l.id_usuario AS value FROM tbl_listarea l JOIN sisusers u ON u.usrId = l.id_usuario JOIN orden_trabajo o ON o.id_orden = l.id_orden AND o.id_empresa = :id_empresa WHERE l.id_orden = :id_orden</sql>
      <result outputType="json">{"recursos":{"recurso":[{"label":"$label","value":"$value"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
   </query>
   <query id="deleteInformeAdjuntosMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE FROM orden_servicio_adjuntos WHERE id_orden IN (SELECT id_orden FROM orden_servicio WHERE id_ot = :id_ot AND id_empresa = :id_empresa)</sql>
      <result outputType="json">{"informe":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="deleteInformeDetalleMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE FROM deta_ordenservicio WHERE id_ordenservicio IN (SELECT id_orden FROM orden_servicio WHERE id_ot = :id_ot AND id_empresa = :id_empresa)</sql>
      <result outputType="json">{"informe":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="deleteInformeOperariosMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE FROM asignausuario WHERE id_orden IN (SELECT id_orden FROM orden_servicio WHERE id_ot = :id_ot AND id_empresa = :id_empresa)</sql>
      <result outputType="json">{"informe":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="deleteInformeMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>DELETE FROM orden_servicio WHERE id_ot = :id_ot AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"informe":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setInformeMan" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO orden_servicio (lectura, fecha, comprobante, id_equipo, id_contratista, id_solicitudreparacion, valesid, estado, id_ordenherraminetas, id_orden_insumo, id_ot, id_empresa, fechahorainicio, fechahorafin, horometroinicio, horometrofin) SELECT 0, CURDATE(), '', o.id_equipo, 0, :id_solicitudreparacion, 0, 'C', 0, 0, o.id_orden, o.id_empresa, :fecha_inicio, :fecha_fin, :horometro_inicio, :horometro_fin FROM orden_trabajo o WHERE o.id_orden = :id_ot AND o.id_empresa = :id_empresa</sql>
      <param name="id_solicitudreparacion" sqlType="STRING"/>
      <param name="fecha_inicio" sqlType="STRING"/>
      <param name="fecha_fin" sqlType="STRING"/>
      <param name="horometro_inicio" sqlType="STRING"/>
      <param name="horometro_fin" sqlType="STRING"/>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setInformeTareaMan" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO deta_ordenservicio (id_ordenservicio, id_tarea, tiempo, observacion, monto, id_componente) SELECT os.id_orden, :tarea, '', NULL, 0, 0 FROM orden_servicio os WHERE os.id_ot = :id_ot AND os.id_empresa = :id_empresa ORDER BY os.id_orden DESC LIMIT 1</sql>
      <param name="tarea" sqlType="STRING"/>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setInformeOperarioMan" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO asignausuario (usrId, id_orden, fechahora) SELECT ue.usrId, os.id_orden, NOW() FROM orden_servicio os JOIN usuarioasempresa ue ON ue.usrId = :usrId AND ue.empresaid = os.id_empresa WHERE os.id_ot = :id_ot AND os.id_empresa = :id_empresa ORDER BY os.id_orden DESC LIMIT 1</sql>
      <param name="usrId" sqlType="STRING"/>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setInformeEvidenciaMan" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO orden_servicio_adjuntos (id_orden, valor_base64, nombre) SELECT os.id_orden, :valor_base64, LEFT(:nombre, 100) FROM orden_servicio os WHERE os.id_ot = :id_ot AND os.id_empresa = :id_empresa ORDER BY os.id_orden DESC LIMIT 1</sql>
      <param name="valor_base64" sqlType="STRING"/>
      <param name="nombre" sqlType="STRING"/>
      <param name="id_ot" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/informe/operarios/empresa/{id_empresa}">
      <call-query href="getInformeOperariosListaMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/informe/ot/{id_orden}/rrhh/empresa/{id_empresa}">
      <call-query href="getInformeRrhhOtMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="id_orden" query-param="id_orden"/></call-query>
   </resource>
   <resource method="PUT" path="/informe/adjuntos/borrar">
      <call-query href="deleteInformeAdjuntosMan"><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/informe/detalle/borrar">
      <call-query href="deleteInformeDetalleMan"><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/informe/operarios/borrar">
      <call-query href="deleteInformeOperariosMan"><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/informe/borrar">
      <call-query href="deleteInformeMan"><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/informe/alta">
      <call-query href="setInformeMan"><with-param name="id_solicitudreparacion" query-param="id_solicitudreparacion"/><with-param name="fecha_inicio" query-param="fecha_inicio"/><with-param name="fecha_fin" query-param="fecha_fin"/><with-param name="horometro_inicio" query-param="horometro_inicio"/><with-param name="horometro_fin" query-param="horometro_fin"/><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/informe/tarea">
      <call-query href="setInformeTareaMan"><with-param name="tarea" query-param="tarea"/><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/informe/operario">
      <call-query href="setInformeOperarioMan"><with-param name="usrId" query-param="usrId"/><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="POST" path="/informe/evidencia">
      <call-query href="setInformeEvidenciaMan"><with-param name="valor_base64" query-param="valor_base64"/><with-param name="nombre" query-param="nombre"/><with-param name="id_ot" query-param="id_ot"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <!-- MIG-ASSET-4c · Calendario (Plan de Mantenimiento): períodos, órdenes del calendario, opciones del filtro, tablas de lo que falta
        programar y cambios de fecha y duración. Reemplaza el acceso directo de models/Calendarios.php (ADR-014). Toda query queda limitada a
        la empresa (id de asset); asset no filtraba por empresa los cambios de fecha y duración (T47). -->
   <query id="getPeriodosEmpresaMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT idperiodo, descripcion FROM periodo WHERE id_empresa = :id_empresa AND estado = 'AC' ORDER BY descripcion</sql>
      <result outputType="json">{"periodos":{"periodo":[{"idperiodo":"$idperiodo","descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCalendarioOtMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT OT.id_orden, OT.nro, CAST(OT.fecha_program AS CHAR) AS fecha_program, OT.tipo, OT.descripcion, CAST(OT.duracion AS CHAR) AS duracion, OT.id_usuario_a, EQ.codigo, A.descripcion AS area, G.descripcion AS grupo, S.descripcion AS sector, TOT.descripcion AS origen FROM orden_trabajo OT LEFT JOIN equipos EQ ON EQ.id_equipo = OT.id_equipo LEFT JOIN area A ON A.id_area = EQ.id_area LEFT JOIN grupo G ON G.id_grupo = EQ.id_grupo LEFT JOIN sector S ON S.id_sector = EQ.id_sector LEFT JOIN tbl_tipoordentrabajo TOT ON TOT.tipo_orden = OT.tipo WHERE OT.id_empresa = :id_empresa AND OT.estado != 'T' AND OT.estado != 'AN' AND OT.fecha_program &gt;= :desde AND OT.fecha_program &lt; :hasta ORDER BY OT.id_orden</sql>
      <result outputType="json">{"ots":{"ot":[{"id_orden":"$id_orden","nro":"$nro","fecha_program":"$fecha_program","tipo":"$tipo","descripcion":"$descripcion","duracion":"$duracion","id_usuario_a":"$id_usuario_a","codigo":"$codigo","area":"$area","grupo":"$grupo","sector":"$sector","origen":"$origen"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="desde" sqlType="STRING"/>
      <param name="hasta" sqlType="STRING"/>
   </query>
   <query id="getCalendarioFiltroEquiposMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT codigo AS descripcion FROM equipos WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"opciones":{"opcion":[{"descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCalendarioFiltroAreasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT descripcion AS descripcion FROM area WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"opciones":{"opcion":[{"descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCalendarioFiltroGruposMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT descripcion AS descripcion FROM grupo WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"opciones":{"opcion":[{"descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCalendarioFiltroSectoresMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT descripcion AS descripcion FROM sector WHERE id_empresa = :id_empresa</sql>
      <result outputType="json">{"opciones":{"opcion":[{"descripcion":"$descripcion"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getCalendarioFiltroOrigenesMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT descripcion FROM tbl_tipoordentrabajo</sql>
      <result outputType="json">{"opciones":{"opcion":[{"descripcion":"$descripcion"}]}}</result>
   </query>
   <query id="getPlanPreventivosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT x.prevId, x.id_tarea, x.perido, x.cantidad, CAST(x.ultimo AS CHAR) AS ultimo, x.id_equipo, x.codigo, x.descripcion, CAST(x.prox AS CHAR) AS prox, x.desc_periodo FROM (SELECT p.prevId, p.id_tarea, p.perido, p.cantidad, p.ultimo, p.id_equipo, e.codigo, t.descripcion, pe.descripcion AS desc_periodo, CASE pe.descripcion WHEN 'Semanal' THEN DATE_ADD(p.ultimo, INTERVAL 7 * p.cantidad DAY) WHEN 'Mensual' THEN DATE_ADD(p.ultimo, INTERVAL p.cantidad MONTH) WHEN 'Semestral' THEN DATE_ADD(p.ultimo, INTERVAL 6 * p.cantidad MONTH) WHEN 'Anual' THEN DATE_ADD(p.ultimo, INTERVAL p.cantidad YEAR) ELSE DATE_ADD(p.ultimo, INTERVAL p.cantidad DAY) END AS prox FROM preventivo p JOIN equipos e ON p.id_equipo = e.id_equipo JOIN tareas t ON p.id_tarea = t.id_tarea JOIN periodo pe ON p.perido = pe.idperiodo WHERE p.estadoprev = 'C' AND p.id_empresa = :id_empresa AND pe.descripcion NOT IN ('Ciclos', 'Horas') AND pe.descripcion NOT LIKE 'Kil%metros') x WHERE :ym IN (DATE_FORMAT(x.prox, '%Y-%m'), DATE_FORMAT(x.ultimo, '%Y-%m')) ORDER BY x.prevId</sql>
      <result outputType="json">{"preventivos":{"preventivo":[{"prevId":"$prevId","id_tarea":"$id_tarea","perido":"$perido","cantidad":"$cantidad","ultimo":"$ultimo","id_equipo":"$id_equipo","codigo":"$codigo","descripcion":"$descripcion","prox":"$prox","desc_periodo":"$desc_periodo"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="ym" sqlType="STRING"/>
   </query>
   <query id="getPlanPreventivosContadorMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.prevId, p.id_tarea, p.perido, p.cantidad, CAST(p.ultimo AS CHAR) AS ultimo, p.id_equipo, CAST(p.critico1 AS CHAR) AS critico1, CAST(p.lectura_base AS CHAR) AS lectura_base, e.codigo, CAST(e.ultima_lectura AS CHAR) AS ultima_lectura, t.descripcion, pe.descripcion AS desc_periodo, CAST(DATE_ADD(p.ultimo, INTERVAL p.cantidad DAY) AS CHAR) AS prox, CAST(p.lectura_base + p.cantidad AS CHAR) AS proximoServicio, IF(e.ultima_lectura &gt;= p.lectura_base + p.cantidad, 'R', 'A') AS alerta FROM preventivo p JOIN equipos e ON p.id_equipo = e.id_equipo JOIN tareas t ON p.id_tarea = t.id_tarea JOIN periodo pe ON p.perido = pe.idperiodo WHERE p.id_empresa = :id_empresa AND (p.estadoprev = 'C' OR p.estadoprev = 'M') AND (pe.descripcion IN ('Ciclos', 'Horas') OR pe.descripcion LIKE 'Kil%metros') AND e.ultima_lectura &gt;= p.lectura_base + p.critico1 ORDER BY p.prevId</sql>
      <result outputType="json">{"preventivos":{"preventivo":[{"prevId":"$prevId","id_tarea":"$id_tarea","perido":"$perido","cantidad":"$cantidad","ultimo":"$ultimo","id_equipo":"$id_equipo","critico1":"$critico1","lectura_base":"$lectura_base","codigo":"$codigo","ultima_lectura":"$ultima_lectura","descripcion":"$descripcion","desc_periodo":"$desc_periodo","prox":"$prox","proximoServicio":"$proximoServicio","alerta":"$alerta"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getPlanBacklogsMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT b.backId, b.sore_id, b.estado, CAST(b.fecha AS CHAR) AS fecha, b.id_tarea, b.id_equipo, b.back_duracion, b.tarea_opcional, e.descripcion, e.codigo, t.descripcion AS tarea FROM tbl_back b JOIN equipos e ON e.id_equipo = b.id_equipo LEFT JOIN tareas t ON t.id_tarea = b.id_tarea WHERE b.id_empresa = :id_empresa AND DATE_FORMAT(b.fecha, '%Y-%m') = :ym AND (b.estado = 'C' OR b.estado = 'S') ORDER BY b.backId</sql>
      <result outputType="json">{"backlogs":{"backlog":[{"backId":"$backId","sore_id":"$sore_id","estado":"$estado","fecha":"$fecha","id_tarea":"$id_tarea","id_equipo":"$id_equipo","back_duracion":"$back_duracion","tarea_opcional":"$tarea_opcional","descripcion":"$descripcion","codigo":"$codigo","tarea":"$tarea"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="ym" sqlType="STRING"/>
   </query>
   <query id="getPlanPredictivosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.predId, p.tarea_descrip, p.periodo, pe.descripcion AS desc_periodo, p.cantidad, CAST(p.fecha AS CHAR) AS fecha, CAST(p.horash AS CHAR) AS horash, p.id_equipo, e.codigo, t.descripcion, s.descripcion AS sector FROM predictivo p JOIN equipos e ON p.id_equipo = e.id_equipo JOIN tareas t ON p.tarea_descrip = t.id_tarea JOIN sector s ON s.id_sector = e.id_sector LEFT JOIN periodo pe ON pe.idperiodo = p.periodo WHERE p.id_empresa = :id_empresa AND DATE_FORMAT(p.fecha, '%Y-%m') = :ym AND p.estado = 'C' ORDER BY p.predId</sql>
      <result outputType="json">{"predictivos":{"predictivo":[{"predId":"$predId","tarea_descrip":"$tarea_descrip","periodo":"$periodo","desc_periodo":"$desc_periodo","cantidad":"$cantidad","fecha":"$fecha","horash":"$horash","id_equipo":"$id_equipo","codigo":"$codigo","descripcion":"$descripcion","sector":"$sector"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="ym" sqlType="STRING"/>
   </query>
   <query id="getPlanCorrectivosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT sr.case_id, sr.id_solicitud, sr.numero, sr.id_tipo, sr.nivel, sr.solicitante, CAST(sr.f_solicitado AS CHAR) AS f_solicitado, CAST(sr.f_sugerido AS CHAR) AS f_sugerido, sr.hora_sug, sr.estado, sr.correctivo, sr.causa, e.descripcion, e.codigo, e.id_equipo, s.descripcion AS sector FROM solicitud_reparacion sr JOIN equipos e ON e.id_equipo = sr.id_equipo JOIN sector s ON s.id_sector = e.id_sector WHERE sr.id_empresa = :id_empresa AND sr.estado = 'S' AND sr.urgente != 0 AND DATE_FORMAT(sr.f_solicitado, '%Y-%m') = :ym AND FIND_IN_SET(sr.case_id, REPLACE(REPLACE(REPLACE(REPLACE(:ids, '[', ''), ']', ''), CHAR(34), ''), ' ', ''))</sql>
      <result outputType="json">{"solicitudes":{"solicitud":[{"case_id":"$case_id","id_solicitud":"$id_solicitud","numero":"$numero","id_tipo":"$id_tipo","nivel":"$nivel","solicitante":"$solicitante","f_solicitado":"$f_solicitado","f_sugerido":"$f_sugerido","hora_sug":"$hora_sug","estado":"$estado","correctivo":"$correctivo","causa":"$causa","descripcion":"$descripcion","codigo":"$codigo","id_equipo":"$id_equipo","sector":"$sector"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="ym" sqlType="STRING"/>
      <param name="ids" sqlType="STRING"/>
   </query>
   <query id="updateCalendarioOtFechaMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET fecha_program = :fecha_program WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="fecha_program" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateCalendarioOtDuracionMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET duracion = IFNULL(duracion, 0) + :minutos WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="minutos" sqlType="STRING"/>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <resource method="GET" path="/periodos/empresa/{id_empresa}">
      <call-query href="getPeriodosEmpresaMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/ot/empresa/{id_empresa}/desde/{desde}/hasta/{hasta}">
      <call-query href="getCalendarioOtMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="desde" query-param="desde"/><with-param name="hasta" query-param="hasta"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/filtro/equipos/empresa/{id_empresa}">
      <call-query href="getCalendarioFiltroEquiposMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/filtro/areas/empresa/{id_empresa}">
      <call-query href="getCalendarioFiltroAreasMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/filtro/grupos/empresa/{id_empresa}">
      <call-query href="getCalendarioFiltroGruposMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/filtro/sectores/empresa/{id_empresa}">
      <call-query href="getCalendarioFiltroSectoresMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/calendario/filtro/origenes">
      <call-query href="getCalendarioFiltroOrigenesMan"></call-query>
   </resource>
   <resource method="GET" path="/plan/preventivos/empresa/{id_empresa}/mes/{ym}">
      <call-query href="getPlanPreventivosMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="ym" query-param="ym"/></call-query>
   </resource>
   <resource method="GET" path="/plan/preventivos-contador/empresa/{id_empresa}">
      <call-query href="getPlanPreventivosContadorMan"><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="GET" path="/plan/backlogs/empresa/{id_empresa}/mes/{ym}">
      <call-query href="getPlanBacklogsMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="ym" query-param="ym"/></call-query>
   </resource>
   <resource method="GET" path="/plan/predictivos/empresa/{id_empresa}/mes/{ym}">
      <call-query href="getPlanPredictivosMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="ym" query-param="ym"/></call-query>
   </resource>
   <resource method="POST" path="/plan/correctivos">
      <call-query href="getPlanCorrectivosMan"><with-param name="id_empresa" query-param="id_empresa"/><with-param name="ym" query-param="ym"/><with-param name="ids" query-param="ids"/></call-query>
   </resource>
   <resource method="PUT" path="/calendario/ot/fecha">
      <call-query href="updateCalendarioOtFechaMan"><with-param name="fecha_program" query-param="fecha_program"/><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
   <resource method="PUT" path="/calendario/ot/duracion">
      <call-query href="updateCalendarioOtDuracionMan"><with-param name="minutos" query-param="minutos"/><with-param name="id_orden" query-param="id_orden"/><with-param name="id_empresa" query-param="id_empresa"/></call-query>
   </resource>
</data>
