   <query id="updateOtAsignarMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET fecha_entrega = :fecha_entrega, estado = 'As', id_usuario_a = :id_usuario_a WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"ot":{"filas":"$UPDATED_ROW_COUNT"}}</result>
