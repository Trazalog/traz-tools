   <query id="getOtTareasMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT lt.id_listarea, lt.id_orden, lt.tareadescrip, lt.id_usuario, CAST(lt.fecha AS CHAR) AS fecha, lt.estado, lt.info_id, lt.id_subtarea, u.usrId, u.usrName, u.usrLastName FROM tbl_listarea lt JOIN orden_trabajo ot ON ot.id_orden = lt.id_orden LEFT JOIN sisusers u ON u.usrId = lt.id_usuario WHERE lt.id_orden = :id_orden AND ot.id_empresa = :id_empresa ORDER BY lt.id_listarea</sql>
      <result outputType="json">{"tareas":{"tarea":[{"id_listarea":"$id_listarea","id_orden":"$id_orden","tareadescrip":"$tareadescrip","id_usuario":"$id_usuario","fecha":"$fecha","estado":"$estado","info_id":"$info_id","id_subtarea":"$id_subtarea","usrId":"$usrId","usrName":"$usrName","usrLastName":"$usrLastName"}]}}</result>
      <param name="id_orden" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setOtTareaMan" keyColumns="id_listarea" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO tbl_listarea (id_orden, tareadescrip, estado) SELECT ot.id_orden, LEFT(:tareadescrip, 5000), LEFT(:estado, 5) FROM orden_trabajo ot WHERE ot.id_orden = :id_orden AND ot.id_empresa = :id_empresa</sql>
