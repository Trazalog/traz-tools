   <query id="getPreventivosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.prevId, p.id_equipo, t.descripcion AS deta, e.descripcion AS des, g.descripcion AS des1, c.descripcion, pe.descripcion AS periodoDesc, CAST(p.cantidad AS CHAR) AS cantidad, CAST(p.ultimo AS CHAR) AS ultimo, p.horash, p.prev_adjunto, p.estadoprev AS estado FROM preventivo p JOIN equipos e ON e.id_equipo = p.id_equipo JOIN grupo g ON e.id_grupo = g.id_grupo JOIN tareas t ON t.id_tarea = p.id_tarea JOIN componentes c ON c.id_componente = p.id_componente JOIN periodo pe ON pe.idperiodo = p.perido WHERE p.estadoprev != 'AN' AND p.id_empresa = :id_empresa ORDER BY p.prevId DESC</sql>
      <result outputType="json">{"preventivos":{"preventivo":[{"prevId":"$prevId","id_equipo":"$id_equipo","deta":"$deta","des":"$des","des1":"$des1","descripcion":"$descripcion","periodoDesc":"$periodoDesc","cantidad":"$cantidad","ultimo":"$ultimo","horash":"$horash","prev_adjunto":"$prev_adjunto","estado":"$estado"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getPreventivoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.prevId, p.perido, CAST(p.cantidad AS CHAR) AS cantidad, CAST(p.ultimo AS CHAR) AS ultimo, CAST(p.critico1 AS CHAR) AS critico1, p.estadoprev, p.horash, CAST(p.prev_duracion AS CHAR) AS prev_duracion, CAST(p.prev_canth AS CHAR) AS prev_canth, p.prev_adjunto, p.id_unidad, e.id_equipo, e.codigo, e.marca, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, e.descripcion, e.ubicacion, c.id_componente, c.descripcion AS comp, t.id_tarea, t.descripcion AS descripta FROM preventivo p JOIN equipos e ON e.id_equipo = p.id_equipo JOIN tareas t ON t.id_tarea = p.id_tarea JOIN componentes c ON c.id_componente = p.id_componente WHERE p.prevId = :prevId AND p.id_empresa = :id_empresa</sql>
      <result outputType="json">{"preventivos":{"preventivo":[{"prevId":"$prevId","perido":"$perido","cantidad":"$cantidad","ultimo":"$ultimo","critico1":"$critico1","estadoprev":"$estadoprev","horash":"$horash","prev_duracion":"$prev_duracion","prev_canth":"$prev_canth","prev_adjunto":"$prev_adjunto","id_unidad":"$id_unidad","id_equipo":"$id_equipo","codigo":"$codigo","marca":"$marca","fecha_ingreso":"$fecha_ingreso","descripcion":"$descripcion","ubicacion":"$ubicacion","id_componente":"$id_componente","comp":"$comp","id_tarea":"$id_tarea","descripta":"$descripta"}]}}</result>
      <param name="prevId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponentesPrevMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT DISTINCT c.id_componente, c.descripcion FROM componentes c JOIN componenteequipo ce ON ce.id_componente = c.id_componente JOIN marcasequipos m ON c.marcaid = m.marcaid JOIN equipos e ON e.id_equipo = ce.id_equipo WHERE ce.id_equipo = :id_equipo AND e.id_empresa = :id_empresa AND c.estado = 'AC' AND m.estado = 'AC' ORDER BY c.descripcion ASC</sql>
      <result outputType="json">{"componentes":{"componente":[{"id_componente":"$id_componente","descripcion":"$descripcion"}]}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setPreventivoMan" keyColumns="prevId" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO preventivo (id_equipo, id_tarea, perido, cantidad, ultimo, id_componente, critico1, horash, estadoprev, prev_duracion, id_unidad, prev_canth, id_empresa, lectura_base) SELECT e.id_equipo, :id_tarea, LEFT(:perido, 50), :cantidad, :ultimo, :id_componente, :critico1, :horash, 'C', :prev_duracion, :id_unidad, :prev_canth, e.id_empresa, :lectura_base FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"alta":{"id":"$GENERATED_KEY"}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_tarea" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="perido" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="cantidad" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="ultimo" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_componente" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="critico1" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="horash" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="prev_duracion" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_unidad" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="prev_canth" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="lectura_base" sqlType="STRING" defaultValue="#{NULL}"/>
   </query>
   <query id="updatePreventivoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE preventivo p JOIN equipos e ON e.id_equipo = :id_equipo AND e.id_empresa = p.id_empresa SET p.id_equipo = e.id_equipo, p.id_tarea = :id_tarea, p.perido = LEFT(:perido, 50), p.cantidad = :cantidad, p.ultimo = :ultimo, p.id_componente = :id_componente, p.horash = :horash, p.estadoprev = 'C', p.prev_duracion = :prev_duracion, p.id_unidad = :id_unidad, p.prev_canth = :prev_canth WHERE p.prevId = :prevId AND p.id_empresa = :id_empresa</sql>
      <result outputType="json">{"preventivo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="prevId" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_tarea" sqlType="STRING"/>
      <param name="perido" sqlType="STRING"/>
      <param name="cantidad" sqlType="STRING"/>
      <param name="ultimo" sqlType="STRING"/>
      <param name="id_componente" sqlType="STRING"/>
      <param name="horash" sqlType="STRING"/>
      <param name="prev_duracion" sqlType="STRING"/>
      <param name="id_unidad" sqlType="STRING"/>
      <param name="prev_canth" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updatePreventivoEstadoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE preventivo SET estadoprev = :estadoprev WHERE prevId = :prevId AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"preventivo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="estadoprev" sqlType="STRING"/>
      <param name="prevId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updatePreventivoAdjuntoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE preventivo SET prev_adjunto = :prev_adjunto WHERE prevId = :prevId AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"preventivo":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="prev_adjunto" sqlType="STRING"/>
      <param name="prevId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getPredictivosMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.predId, p.id_equipo, p.tarea_descrip, CAST(p.fecha AS CHAR) AS fecha, p.cantidad, p.estado, CAST(p.horash AS CHAR) AS horash, p.pred_adjunto, e.descripcion AS des, e.marca, e.codigo, e.ubicacion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, t.descripcion AS de1, pe.descripcion AS periodo FROM predictivo p JOIN equipos e ON e.id_equipo = p.id_equipo JOIN tareas t ON t.id_tarea = p.tarea_descrip JOIN periodo pe ON pe.idperiodo = p.periodo WHERE p.estado != 'AN' AND p.id_empresa = :id_empresa ORDER BY p.predId</sql>
      <result outputType="json">{"predictivos":{"predictivo":[{"predId":"$predId","id_equipo":"$id_equipo","tarea_descrip":"$tarea_descrip","fecha":"$fecha","cantidad":"$cantidad","estado":"$estado","horash":"$horash","pred_adjunto":"$pred_adjunto","des":"$des","marca":"$marca","codigo":"$codigo","ubicacion":"$ubicacion","fecha_ingreso":"$fecha_ingreso","de1":"$de1","periodo":"$periodo"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getPredictivoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT p.id_equipo, p.predId, CAST(p.fecha AS CHAR) AS fecha, p.estado AS es, p.cantidad, p.periodo, p.pred_duracion AS duracion, p.id_unidad AS unidtiempo, p.pred_canth AS operarios, CAST(p.horash AS CHAR) AS hh, p.pred_adjunto, e.codigo, e.ubicacion, e.marca, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, e.descripcion, t.id_tarea, t.descripcion AS tarea_descrip FROM predictivo p JOIN equipos e ON e.id_equipo = p.id_equipo JOIN tareas t ON t.id_tarea = p.tarea_descrip WHERE p.predId = :predId AND p.id_equipo = :id_equipo AND p.id_empresa = :id_empresa</sql>
      <result outputType="json">{"predictivos":{"predictivo":[{"id_equipo":"$id_equipo","predId":"$predId","fecha":"$fecha","es":"$es","cantidad":"$cantidad","periodo":"$periodo","duracion":"$duracion","unidtiempo":"$unidtiempo","operarios":"$operarios","hh":"$hh","pred_adjunto":"$pred_adjunto","codigo":"$codigo","ubicacion":"$ubicacion","marca":"$marca","fecha_ingreso":"$fecha_ingreso","descripcion":"$descripcion","id_tarea":"$id_tarea","tarea_descrip":"$tarea_descrip"}]}}</result>
      <param name="predId" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="setPredictivoMan" keyColumns="predId" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO predictivo (id_equipo, tarea_descrip, fecha, periodo, cantidad, horash, estado, pred_duracion, pred_canth, id_empresa, id_unidad) SELECT e.id_equipo, :tarea_descrip, :fecha, LEFT(:periodo, 50), :cantidad, :horash, 'C', :pred_duracion, :pred_canth, e.id_empresa, :id_unidad FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa</sql>
      <result outputType="json">{"alta":{"id":"$GENERATED_KEY"}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="tarea_descrip" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="fecha" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="periodo" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="cantidad" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="horash" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="pred_duracion" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="pred_canth" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_unidad" sqlType="STRING" defaultValue="#{NULL}"/>
   </query>
