   </query>
   <query id="getBacklogsMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT b.backId, b.id_equipo, b.id_tarea, CAST(b.fecha AS CHAR) AS fecha, CAST(b.horash AS CHAR) AS horash, b.estado, b.back_duracion, b.id_unidad, b.back_canth, b.id_empresa, b.idcomponenteequipo, b.back_adjunto, b.sore_id, b.tarea_opcional, e.descripcion AS des, e.marca, e.codigo, t.descripcion AS de1, c.descripcion AS componente, s.descripcion AS sistema FROM tbl_back b JOIN equipos e ON e.id_equipo = b.id_equipo LEFT JOIN tareas t ON t.id_tarea = b.id_tarea LEFT JOIN componenteequipo ce ON ce.idcomponenteequipo = b.idcomponenteequipo LEFT JOIN componentes c ON c.id_componente = ce.id_componente LEFT JOIN sistema s ON s.sistemaid = ce.sistemaid WHERE b.id_empresa = :id_empresa AND b.estado != 'B' ORDER BY b.backId</sql>
      <result outputType="json">{"backlogs":{"backlog":[{"backId":"$backId","id_equipo":"$id_equipo","id_tarea":"$id_tarea","fecha":"$fecha","horash":"$horash","estado":"$estado","back_duracion":"$back_duracion","id_unidad":"$id_unidad","back_canth":"$back_canth","id_empresa":"$id_empresa","idcomponenteequipo":"$idcomponenteequipo","back_adjunto":"$back_adjunto","sore_id":"$sore_id","tarea_opcional":"$tarea_opcional","des":"$des","marca":"$marca","codigo":"$codigo","de1":"$de1","componente":"$componente","sistema":"$sistema"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getBacklogMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT b.backId, b.id_equipo, b.id_tarea, CAST(b.fecha AS CHAR) AS fecha, CAST(b.horash AS CHAR) AS horash, b.estado, b.back_duracion, b.id_unidad, b.back_canth, b.id_empresa, b.idcomponenteequipo, b.back_adjunto, b.sore_id, b.tarea_opcional, t.descripcion AS tareadescrip FROM tbl_back b LEFT JOIN tareas t ON t.id_tarea = b.id_tarea WHERE b.backId = :backId AND b.id_empresa = :id_empresa</sql>
      <result outputType="json">{"backlogs":{"backlog":[{"backId":"$backId","id_equipo":"$id_equipo","id_tarea":"$id_tarea","fecha":"$fecha","horash":"$horash","estado":"$estado","back_duracion":"$back_duracion","id_unidad":"$id_unidad","back_canth":"$back_canth","id_empresa":"$id_empresa","idcomponenteequipo":"$idcomponenteequipo","back_adjunto":"$back_adjunto","sore_id":"$sore_id","tarea_opcional":"$tarea_opcional","tareadescrip":"$tareadescrip"}]}}</result>
      <param name="backId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getBacklogEquipoMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT e.descripcion AS des, e.codigo, e.ubicacion, CAST(e.fecha_ingreso AS CHAR) AS fecha_ingreso, m.marcadescrip AS marca, ce.codigo AS codcompeq, c.descripcion AS componente, s.descripcion AS sistema FROM tbl_back b JOIN equipos e ON e.id_equipo = b.id_equipo JOIN marcasequipos m ON e.marca = m.marcaid LEFT JOIN componenteequipo ce ON ce.idcomponenteequipo = b.idcomponenteequipo LEFT JOIN componentes c ON c.id_componente = ce.id_componente LEFT JOIN sistema s ON s.sistemaid = ce.sistemaid WHERE b.backId = :backId AND b.id_equipo = :id_equipo AND b.id_empresa = :id_empresa</sql>
      <result outputType="json">{"equipos":{"equipo":[{"des":"$des","codigo":"$codigo","ubicacion":"$ubicacion","fecha_ingreso":"$fecha_ingreso","marca":"$marca","codcompeq":"$codcompeq","componente":"$componente","sistema":"$sistema"}]}}</result>
      <param name="backId" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="getComponentesBacklogMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT ce.idcomponenteequipo AS idce, ce.codigo, c.descripcion, s.descripcion AS sistema FROM componenteequipo ce JOIN componentes c ON c.id_componente = ce.id_componente JOIN sistema s ON s.sistemaid = ce.sistemaid WHERE (IFNULL(:id_equipo, '') = '' OR ce.id_equipo = :id_equipo) AND ce.id_empresa = :id_empresa AND ce.estado != 'AN' ORDER BY ce.codigo</sql>
      <result outputType="json">{"componentes":{"componente":[{"idce":"$idce","codigo":"$codigo","descripcion":"$descripcion","sistema":"$sistema"}]}}</result>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="id_equipo" sqlType="STRING"/>
   </query>
   <query id="setBacklogMan" keyColumns="backId" returnGeneratedKeys="true" useConfig="AssetPlannerDataSource">
      <sql>INSERT INTO tbl_back (id_equipo, id_tarea, fecha, horash, estado, back_duracion, id_unidad, back_canth, id_empresa, idcomponenteequipo, tarea_opcional) SELECT e.id_equipo, :id_tarea, :fecha, :horash, 'C', :back_duracion, :id_unidad, :back_canth, e.id_empresa, :idcomponenteequipo, LEFT(:tarea_opcional, 500) FROM equipos e WHERE e.id_equipo = :id_equipo AND e.id_empresa = :id_empresa AND (IFNULL(:id_tarea, '0') IN ('', '0') OR EXISTS (SELECT 1 FROM tareas x WHERE x.id_tarea = :id_tarea AND x.id_empresa = e.id_empresa)) AND (IFNULL(:idcomponenteequipo, '0') IN ('', '0') OR EXISTS (SELECT 1 FROM componenteequipo x WHERE x.idcomponenteequipo = :idcomponenteequipo AND x.id_empresa = e.id_empresa))</sql>
      <result outputType="json">{"alta":{"id":"$GENERATED_KEY"}}</result>
      <param name="id_equipo" sqlType="STRING"/>
      <param name="id_tarea" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="fecha" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="horash" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="back_duracion" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_unidad" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="back_canth" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="id_empresa" sqlType="STRING"/>
      <param name="idcomponenteequipo" sqlType="STRING" defaultValue="#{NULL}"/>
      <param name="tarea_opcional" sqlType="STRING" defaultValue="#{NULL}"/>
   </query>
   <query id="updateBacklogMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE tbl_back SET id_tarea = :id_tarea, fecha = :fecha, horash = :horash, back_duracion = :back_duracion, back_canth = :back_canth, id_unidad = :id_unidad, tarea_opcional = LEFT(:tarea_opcional, 500) WHERE backId = :backId AND id_empresa = :id_empresa AND (IFNULL(:id_tarea, '0') IN ('', '0') OR EXISTS (SELECT 1 FROM tareas x WHERE x.id_tarea = :id_tarea AND x.id_empresa = :id_empresa))</sql>
      <result outputType="json">{"backlog":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="backId" sqlType="STRING"/>
      <param name="id_tarea" sqlType="STRING"/>
      <param name="fecha" sqlType="STRING"/>
      <param name="horash" sqlType="STRING"/>
      <param name="back_duracion" sqlType="STRING"/>
      <param name="back_canth" sqlType="STRING"/>
      <param name="id_unidad" sqlType="STRING"/>
      <param name="tarea_opcional" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateBacklogEstadoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE tbl_back SET estado = :estado WHERE backId = :backId AND id_empresa = :id_empresa</sql>
      <result outputType="json">{"backlog":{"filas":"$UPDATED_ROW_COUNT"}}</result>
      <param name="estado" sqlType="STRING"/>
      <param name="backId" sqlType="STRING"/>
      <param name="id_empresa" sqlType="STRING"/>
   </query>
   <query id="updateBacklogAdjuntoMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE tbl_back SET back_adjunto = :back_adjunto WHERE backId = :backId AND id_empresa = :id_empresa</sql>
