   </query>
   <query id="getUsuarioNickMan" useConfig="AssetPlannerDataSource">
      <sql>SELECT u.usrNick FROM sisusers u JOIN usuarioasempresa ue ON ue.usrId = u.usrId WHERE u.usrId = :usrId AND ue.empresaid = :id_empresa LIMIT 1</sql>
      <result outputType="json">{"usuarios":{"usuario":[{"usrNick":"$usrNick"}]}}</result>
