   <query id="updateOtFinalizarMan" returnUpdatedRowCount="true" useConfig="AssetPlannerDataSource">
      <sql>UPDATE orden_trabajo SET estado = 'T', fecha_terminada = :fecha WHERE id_orden = :id_orden AND id_empresa = :id_empresa</sql>
